@model SilverSet.Models.Entities.Forum.ForumTopic
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Create New Topic";
    var turnstileSiteKey = Configuration["CloudflareTurnstile:SiteKey"];
}

<style>
    body {
        background-color: #050505;
    }

    .forum-container {
        padding: 4rem 0;
    }

    .forum-path {
        color: #555;
        font-size: 0.8rem;
        margin-bottom: 2rem;
        font-weight: 500;
    }

        .forum-path a {
            color: #888;
            text-decoration: none;
            transition: 0.2s;
        }

            .forum-path a:hover {
                color: #fff;
            }

    .form-card {
        background: #0d0d0d;
        border: 1px solid #1a1a1a;
        padding: 3rem;
        border-radius: 8px;
        max-width: 850px;
        margin: 0 auto;
        box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    }

    .form-header {
        border-bottom: 1px solid #222;
        padding-bottom: 1.5rem;
        margin-bottom: 2.5rem;
    }

        .form-header h1 {
            font-weight: 800;
            color: #fff;
            font-size: 1.8rem;
            margin: 0;
        }

        .form-header p {
            color: #444;
            font-size: 0.9rem;
            margin-top: 5px;
        }

    .form-label-silver {
        color: #aaa;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 0.8rem;
        display: block;
    }

    .forum-input {
        background: #050505 !important;
        border: 1px solid #222 !important;
        color: #eee !important;
        border-radius: 4px;
        padding: 0.9rem 1.2rem;
        font-size: 0.95rem;
        margin-bottom: 1.5rem;
        transition: border-color 0.3s;
    }

        .forum-input:focus {
            border-color: #555 !important;
            box-shadow: none;
            color: #fff !important;
        }

    .btn-post-topic {
        background: #e0e0e0;
        color: #000;
        font-weight: 800;
        font-size: 0.85rem;
        padding: 0.9rem 2.5rem;
        border: none;
        border-radius: 4px;
        transition: 0.3s;
    }

        .btn-post-topic:hover {
            background: #fff;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255,255,255,0.1);
        }

    .cancel-link {
        color: #555;
        font-size: 0.85rem;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s;
    }

        .cancel-link:hover {
            color: #888;
        }

    .ss-snackbar-container {
        position: fixed;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .ss-snackbar {
        background: #1a1a1a;
        color: #e0e0e0;
        padding: 12px 24px;
        border-radius: 4px;
        border: 1px solid #333;
        font-size: 0.9rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.6);
        min-width: 320px;
        animation: snackbarIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

        .ss-snackbar i {
            color: #888;
            font-size: 1.1rem;
        }

    @@keyframes snackbarIn {
        from

    {
        transform: translateY(100px);
        opacity: 0;
    }

    to {
        transform: translateY(0);
        opacity: 1;
    }

    }

    @@keyframes snackbarOut {
        from

    {
        transform: translateY(0);
        opacity: 1;
    }

    to {
        transform: translateY(100px);
        opacity: 0;
    }

    }
</style>

<div class="forum-container">
    <div class="container">
        <div class="forum-path text-center">
            <a asp-action="Index">Forum</a> / <span>Create New Topic</span>
        </div>

        <div class="form-card">
            <div class="form-header">
                <h1>Create New Topic</h1>
                <p>Share your thoughts or questions with the community.</p>
            </div>

            <form asp-action="CreateTopic" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="categoryId" value="@ViewBag.CategoryId" />

                <input type="text" name="honeyPot" style="display:none" tabindex="-1" autocomplete="off" />

                <div class="mb-4">
                    <label class="form-label-silver">Subject</label>
                    <input type="text" name="title" class="form-control forum-input"
                           placeholder="Enter a descriptive title for your topic..." required maxlength="100"
                           value="@TempData["DraftTitle"]" />
                </div>

                <div class="mb-4">
                    <label class="form-label-silver">Message Content</label>
                    <textarea name="content" class="form-control forum-input" rows="10"
                              placeholder="Write your message here..." required>@TempData["DraftContent"]</textarea>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-5">
                    <div class="cf-turnstile" data-sitekey="@turnstileSiteKey"></div>

                    <div class="d-flex align-items-center gap-4">
                        <a asp-action="Index" class="cancel-link">Cancel</a>
                        <button type="submit" class="btn btn-post-topic">Post Topic</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@if (TempData["Error"] != null || TempData["Info"] != null || TempData["Success"] != null)
{
    <div class="ss-snackbar-container">
        @if (TempData["Error"] != null)
        {
            <div class="ss-snackbar">
                <i class="bi bi-exclamation-triangle"></i>
                <span>@TempData["Error"]</span>
            </div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="ss-snackbar">
                <i class="bi bi-info-circle"></i>
                <span>@TempData["Info"]</span>
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="ss-snackbar">
                <i class="bi bi-check2-circle"></i>
                <span>@TempData["Success"]</span>
            </div>
        }
    </div>

    <script>
        setTimeout(() => {
            const snaks = document.querySelectorAll('.ss-snackbar');
            snaks.forEach(s => {
                s.style.animation = 'snackbarOut 0.4s ease-in forwards';
            });
            setTimeout(() => {
                document.querySelector('.ss-snackbar-container').remove();
            }, 400);
        }, 4000);
    </script>
}

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>