@model SilverSet.Models.Entities.Forum.ForumCategory
@{
    ViewData["Title"] = Model.Name;
}

<style>
    .forum-container {
        padding: 4rem 0;
    }

    .forum-path {
        color: #444;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 1rem;
    }

        .forum-path a {
            color: #888;
            text-decoration: none;
        }

    .category-header {
        border-bottom: 1px solid #222;
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }

        .category-header h1 {
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 4px;
            color: #fff;
            font-size: 1.8rem;
            margin: 0;
        }

    .topic-list {
        background: rgba(10, 10, 10, 0.4);
        border: 1px solid #1a1a1a;
    }

    .topic-row {
        display: grid;
        grid-template-columns: 1fr 120px 200px;
        border-bottom: 1px solid #111;
        transition: 0.2s;
        text-decoration: none;
    }

        .topic-row:hover {
            background: rgba(255, 255, 255, 0.02);
        }

    .topic-main {
        padding: 1.2rem 1.5rem;
    }

    .topic-title {
        color: #eee;
        font-weight: 700;
        font-size: 1rem;
        display: block;
        margin-bottom: 0.3rem;
    }

    .topic-meta {
        color: #555;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .topic-meta span {
            color: #888;
        }

    .topic-stats {
        display: flex;
        align-items: center;
        justify-content: center;
        border-left: 1px solid #111;
        border-right: 1px solid #111;
    }

    .topic-last-post {
        padding: 1rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        font-size: 0.75rem;
    }

    .last-post-user {
        color: #fff;
        font-weight: 700;
    }

    .last-post-date {
        color: #444;
    }

    .btn-new-topic {
        border: 1px solid #fff;
        color: #fff;
        text-transform: uppercase;
        font-size: 0.7rem;
        letter-spacing: 2px;
        padding: 0.6rem 1.5rem;
        text-decoration: none;
        transition: 0.3s;
    }

        .btn-new-topic:hover {
            background: #fff;
            color: #000;
        }

    .badge-pinned {
        background: #fff;
        color: #000;
        font-size: 0.6rem;
        padding: 2px 6px;
        font-weight: 900;
        margin-right: 8px;
        vertical-align: middle;
    }
</style>

<div class="container forum-container">
    <div class="forum-path">
        <a asp-action="Index">Terminal</a> / @Model.Name
    </div>

    <div class="category-header">
        <div>
            <h1>@Model.Name</h1>
        </div>
        <a href="#" class="btn-new-topic">New Broadcast</a>
    </div>

    <div class="topic-list">
        @foreach (var topic in Model.Topics.OrderByDescending(t => t.IsPinned).ThenByDescending(t => t.CreatedAt))
        {
            <a href="#" class="topic-row">
                <div class="topic-main">
                    @if (topic.IsPinned)
                    {
                        <span class="badge-pinned">PINNED</span>
                    }
                    <span class="topic-title">@topic.Title</span>
                    <div class="topic-meta">
                        Identity: <span>@topic.User.UserName</span> | Status: @(topic.IsLocked ? "Encrypted" : "Open")
                    </div>
                </div>
                <div class="topic-stats">
                    <div style="text-align: center;">
                        <span style="display: block; color: #fff; font-weight: 800;">@topic.Posts.Count</span>
                        <span style="font-size: 0.55rem; color: #444; text-transform: uppercase; font-weight: 800;">Replies</span>
                    </div>
                </div>
                <div class="topic-last-post">
                    <span class="last-post-user">@topic.User.UserName</span>
                    <span class="last-post-date">@topic.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                </div>
            </a>
        }
    </div>
</div>