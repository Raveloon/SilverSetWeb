@model IEnumerable<SilverSet.Models.Entities.Forum.ForumTopic>
@{
    var category = ViewBag.Category as SilverSet.Models.Entities.Forum.ForumCategory;
    ViewData["Title"] = category?.Name;
}

<style>
    .bbs-path {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: #666;
        margin-bottom: 2rem;
    }

    .topic-row {
        background: rgba(15, 15, 15, 0.4);
        border: 1px solid #1a1a1a;
        padding: 1rem 1.5rem;
        margin-bottom: 0.5rem;
        display: grid;
        grid-template-columns: 1fr 150px 100px;
        align-items: center;
        transition: all 0.2s;
        text-decoration: none;
    }

        .topic-row:hover {
            background: rgba(30, 30, 30, 0.6);
            border-color: #444;
            transform: scale(1.01);
        }

    .topic-info .title {
        color: white;
        font-weight: 700;
        display: block;
        margin-bottom: 0.2rem;
    }

    .topic-info .meta {
        font-size: 0.75rem;
        color: #555;
    }

    .topic-stats {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        color: #888;
        text-align: right;
    }

    .pinned-icon {
        color: var(--term-red, #ff4444);
        margin-right: 10px;
    }

    .btn-create {
        background: white;
        color: black;
        border: none;
        padding: 0.5rem 1.2rem;
        font-weight: 800;
        font-size: 0.75rem;
        text-transform: uppercase;
        text-decoration: none;
    }
</style>

<div class="container py-5">
    <div class="bbs-path">
        <a asp-action="Index" class="text-decoration-none color-inherit">> FORUM_ROOT</a> / @category?.Name.ToUpper()
    </div>

    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-black mb-1" style="letter-spacing:1px;">@category?.Name</h2>
            <p class="text-muted small mb-0">@category?.Description</p>
        </div>
        <a asp-action="CreateTopic" asp-route(categoryId="@category?.Id" ) class="btn-create">
            + New Topic
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="py-5 text-center border-dashed" style="border: 1px dashed #222;">
            <span class="text-muted small">> NO_TOPICS_FOUND_IN_SECTOR</span>
        </div>
    }
    else
    {
        <div class="topic-list">
            @foreach (var topic in Model)
            {
                <a asp-action="Topic" asp-route-id="@topic.Id" class="topic-row">
                    <div class="topic-info">
                        <span class="title">
                            @if (topic.IsPinned)
                            {
                                <span class="pinned-icon">●</span>
                            }
                            @topic.Title
                        </span>
                        <span class="meta">by @topic.User.UserName • @topic.CreatedAt.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="topic-stats">
                        <div>REPLIES: <span class="text-white">@topic.Posts.Count</span></div>
                    </div>
                    <div class="topic-stats">
                        <div>VIEWS: <span class="text-white">@topic.ViewCount</span></div>
                    </div>
                </a>
            }
        </div>
    }

    @if (ViewBag.TotalPages > 1)
    {
        <div class="pagination-container mt-4 d-flex gap-2">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <a href="@Url.Action("Category", new { id = category?.Id, page = i })"
                   class="page-link-custom @(i == ViewBag.CurrentPage ? "active" : "")">@i</a>
            }
        </div>
    }
</div>