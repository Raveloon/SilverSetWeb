@model IEnumerable<SilverSet.Models.Entities.Forum.ForumPost>
@{
    var topic = ViewBag.Topic as SilverSet.Models.Entities.Forum.ForumTopic;
    ViewData["Title"] = topic?.Title;
}

<div class="container py-5">
    @* Ana Konu Başlığı *@
    <div class="p-4 mb-4" style="background: rgba(20,20,20,0.6); border: 1px solid #333;">
        <div class="d-flex justify-content-between text-muted small mb-2">
            <span>BY: @topic?.User.UserName</span>
            <span>@topic?.CreatedAt.ToString("g")</span>
        </div>
        <h2 class="text-white fw-bold">@topic?.Title</h2>
        <hr class="border-secondary">
        <div class="text-light" style="white-space: pre-line;">@topic?.Content</div>
    </div>

    @* Mesajlar (Postlar) *@
    @foreach (var post in Model)
    {
        <div class="p-3 mb-2" style="background: rgba(10,10,10,0.4); border-left: 2px solid #444;">
            <div class="small text-muted mb-1">@post.User.UserName - @post.CreatedAt.ToString("g")</div>
            <div class="text-light">@post.Content</div>
        </div>
    }

    @* Cevap Yazma Formu *@
    @if (User.Identity!.IsAuthenticated)
    {
        <div class="mt-5 p-4" style="border: 1px solid #222;">
            <form asp-action="CreatePost" method="post">
                <input type="hidden" name="topicId" value="@topic?.Id" />
                <input type="text" name="honeyPot" style="display:none" />

                <textarea name="content" class="form-control bg-dark border-secondary text-white mb-3" rows="4" placeholder="Type your response..."></textarea>
                <button type="submit" class="btn btn-outline-light btn-sm fw-bold">SUBMIT_POST</button>
            </form>
        </div>
    }
</div>