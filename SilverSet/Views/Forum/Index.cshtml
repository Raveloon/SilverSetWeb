@model IEnumerable<SilverSet.Models.Entities.Forum.ForumCategory>
@{
    ViewData["Title"] = "Forum Terminal";
}

<style>
    .forum-container {
        padding: 2rem 0;
    }

    .bbs-header {
        border-bottom: 2px solid #222;
        padding-bottom: 1rem;
        margin-bottom: 2rem;
    }

    .bbs-title {
        font-family: 'JetBrains Mono', monospace;
        font-size: 1.5rem;
        font-weight: 800;
        color: white;
        letter-spacing: 2px;
    }

    .category-card {
        background: rgba(10, 10, 10, 0.6);
        border: 1px solid #1a1a1a;
        border-left: 4px solid var(--admin-border);
        padding: 1.5rem;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
        text-decoration: none;
        display: block;
    }

        .category-card:hover {
            background: rgba(20, 20, 20, 0.8);
            border-left-color: white;
            transform: translateX(5px);
        }

    .cat-name {
        color: white;
        font-size: 1.1rem;
        font-weight: 700;
        margin-bottom: 0.3rem;
        display: block;
    }

    .cat-desc {
        color: #666;
        font-size: 0.85rem;
        margin-bottom: 0;
    }

    .cat-stats {
        display: flex;
        gap: 2rem;
        margin-top: 1rem;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        color: #444;
        text-transform: uppercase;
    }

    .stat-value {
        color: #999;
        font-weight: bold;
    }
</style>

<div class="container forum-container">
    <div class="bbs-header d-flex justify-content-between align-items-center">
        <div class="bbs-title">> SILVERSET_BBS_v1.0</div>
        <div class="text-muted small">@DateTime.Now.ToString("yyyy-MM-dd HH:mm")</div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <span class="text-muted">> NO_CATEGORIES_DEFINED</span>
        </div>
    }
    else
    {
        @foreach (var category in Model)
        {
            <a asp-action="Category" asp-route-id="@category.Id" class="category-card">
                <span class="cat-name">@category.Name</span>
                <p class="cat-desc">@category.Description</p>

                <div class="cat-stats">
                    <span>Topics: <span class="stat-value">@category.Topics.Count</span></span>
                    <span>Status: <span class="stat-value">ONLINE</span></span>
                </div>
            </a>
        }
    }
</div>