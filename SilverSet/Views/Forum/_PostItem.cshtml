@model SilverSet.Models.Entities.Forum.ForumPost
@using System.Text.RegularExpressions

@{
    var processedContent = Html.Encode(Model.Content);
    processedContent = Regex.Replace(processedContent, @"(@\w+)", "<span style='color: #00a8ff; font-weight: bold;'>$1</span>");
    int? topicStarterId = ViewBag.TopicStarterId as int?;
}

<div class="forum-post-wrapper" id="post-@Model.Id"
     style="margin-top: 0.75rem; background: #0d0d0d; border: 1px solid #1a1a1a; border-radius: 4px;">

    <div class="d-flex flex-column flex-md-row">
        <div class="user-info-sidebar" style="background: #111; border-right: 1px solid #1a1a1a; padding: 1rem 0.5rem; text-align: center; width: 130px; min-width: 130px;">
            <div class="user-avatar-main" style="width: 40px; height: 40px; background: #222; margin: 0 auto 0.5rem; display: flex; align-items: center; justify-content: center; font-weight: 800; color: #fff; border: 1px solid #333; border-radius: 50%; font-size: 1rem;">
                @Model.User.UserName.Substring(0, 1).ToUpper()
            </div>
            <span style="color: #fff; font-weight: 700; font-size: 0.8rem; display: block; margin-bottom: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@Model.User.UserName</span>

            @if (topicStarterId.HasValue && Model.UserId == topicStarterId.Value)
            {
                <span style="color: #888; font-size: 0.6rem; text-transform: uppercase; font-weight: 800; letter-spacing: 1px;">Topic Starter</span>
            }
            else
            {
                <span style="color: #555; font-size: 0.6rem; text-transform: uppercase; font-weight: 800; letter-spacing: 1px;">Member</span>
            }
        </div>

        <div class="post-main-area" style="padding: 1rem 1.5rem; display: flex; flex-direction: column; flex-grow: 1;">
            <div style="color: #444; font-size: 0.7rem; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 6px;">
                <i class="bi bi-clock"></i> @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")
            </div>

            <div style="color: #ccc; line-height: 1.5; font-size: 0.92rem; white-space: pre-wrap; flex-grow: 1;">
                @Html.Raw(processedContent)
            </div>

            <div style="margin-top: 1rem; padding-top: 0.5rem; border-top: 1px solid #151515; display: flex; justify-content: flex-end;">
                @if (User.Identity.IsAuthenticated)
                {
                    <button type="button" onclick="prepareMentionReply(@Model.Id, '@Model.User.UserName')"
                            style="background: none; border: none; color: #666; font-size: 0.7rem; text-transform: uppercase; font-weight: 700; letter-spacing: 1px; transition: 0.2s; display: flex; align-items: center; gap: 5px;">
                        <i class="bi bi-chat-left-fill"></i> Reply
                    </button>
                }
            </div>

            <div id="reply-form-container-@Model.Id" class="mt-3 d-none">
                <form asp-action="CreatePost" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="topicId" value="@Model.TopicId" />
                    <input type="hidden" name="parentPostId" value="@Model.Id" />
                    <textarea name="content" id="textarea-@Model.Id" class="form-control mb-2" rows="3"
                              style="background: #050505; border: 1px solid #222; color: #fff; border-radius: 4px; padding: 0.75rem; font-size: 0.85rem;"
                              placeholder="Write your response..."></textarea>
                    <div class="d-flex gap-2 justify-content-end">
                        <button type="button" onclick="openReplyForm(@Model.Id)"
                                style="background: transparent; border: 1px solid #333; color: #aaa; font-size: 0.65rem; font-weight: 700; padding: 0.4rem 1.2rem; border-radius: 4px;">
                            CANCEL
                        </button>
                        <button type="submit"
                                style="background: #e0e0e0; border: none; color: #000; font-weight: 800; font-size: 0.65rem; padding: 0.4rem 1.5rem; border-radius: 4px;">
                            POST REPLY
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .forum-post-wrapper button:hover {
        color: #fff !important;
    }
</style>