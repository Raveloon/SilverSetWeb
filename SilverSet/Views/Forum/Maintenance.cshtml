@{
    Layout = "_Layout";
    ViewData["Title"] = "Terminal Lockdown";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="text-center" style="max-width: 600px;">
        <div class="mb-4">
            <i class="bi bi-shield-lock" style="font-size: 4rem; color: #333;"></i>
        </div>
        <h1 style="font-weight: 900; letter-spacing: 5px; text-transform: uppercase; color: #fff;">Terminal Offline</h1>
        <div style="height: 2px; background: linear-gradient(90deg, transparent, #222, transparent); margin: 1.5rem 0;"></div>
        <p style="color: #555; font-size: 0.85rem; letter-spacing: 1px; line-height: 1.6; text-transform: uppercase;">
            The central communication module is currently under administrative lockdown.
            Access to community threads has been restricted by SilverSet Security Protocol.
        </p>
        <a href="/" class="btn mt-4" style="border: 1px solid #222; color: #666; text-transform: uppercase; font-size: 0.7rem; letter-spacing: 2px; padding: 0.8rem 2rem; transition: 0.3s;">
            Return to Root
        </a>
    </div>
</div>