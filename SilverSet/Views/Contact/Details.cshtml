@using SilverSet.Models.Entities
@model Ticket
@{
    ViewData["Title"] = "Archived Transmission";
}

<style>
    .history-wrapper {
        padding: 2rem 1rem;
        min-height: 80vh;
        max-width: 900px;
        margin: 0 auto;
    }

    @@media (min-width: 768px) {
        .history-wrapper {
            padding: 4rem 0;
        }
    }

    .chat-container {
        display: flex;
        flex-direction: column;
        background: rgba(15, 15, 15, 0.9);
        border: 1px solid #333;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }

    .chat-header {
        padding: 1.2rem 1.5rem;
        border-bottom: 1px solid #333;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    @@media (min-width: 576px) {
        .chat-header {
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
        }
    }

    .evidence-section {
        padding: 1.5rem;
        background: rgba(255, 255, 255, 0.02);
        border-bottom: 1px solid #222;
    }

    .evidence-gallery {
        display: flex;
        gap: 1rem;
        overflow-x: auto;
        padding-bottom: 0.5rem;
    }

    .evidence-item {
        flex: 0 0 140px;
        height: 90px;
        border-radius: 4px;
        overflow: hidden;
        border: 1px solid #333;
    }

        .evidence-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .chat-messages {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        max-height: 60vh;
        overflow-y: auto;
    }

    .msg-bubble {
        max-width: 85%;
        padding: 0.85rem 1.2rem;
        border-radius: 4px;
        font-size: 0.85rem;
        line-height: 1.6;
        word-wrap: break-word;
    }

    .msg-user {
        align-self: flex-end;
        background: #222;
        border: 1px solid #444;
        color: #eee;
    }

    .msg-admin {
        align-self: flex-start;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid #fff;
        color: #fff;
    }

    .msg-system {
        align-self: center;
        color: #888;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        padding: 0.8rem 1.5rem;
        border-top: 1px dashed #333;
        border-bottom: 1px dashed #333;
        margin: 1rem 0;
        text-align: center;
        width: 90%;
    }

    .archived-banner {
        background: rgba(255, 255, 255, 0.02);
        border-top: 1px solid #222;
        color: #666;
        padding: 1.2rem;
        text-align: center;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 0.75rem;
    }

    .quarantine-header {
        background: rgba(239, 68, 68, 0.1);
        border-bottom: 1px solid #ef4444;
        padding: 1rem;
        text-align: center;
        color: #ef4444;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 2px;
    }

    .btn-return {
        background: transparent;
        color: #888;
        border: none;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        font-size: 0.75rem;
        font-weight: 800;
        text-decoration: none;
        transition: color 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 2rem;
        justify-content: center;
        width: 100%;
    }
</style>

<main class="container history-wrapper">
    <div style="text-align: center; margin-bottom: 2rem;">
        <h2 style="color: #fff; font-weight: 900; text-transform: uppercase; letter-spacing: 3px; margin: 0; font-size: 1.5rem;">LOG #@Model.Id</h2>
        <p style="color: #666; font-size: 0.75rem; letter-spacing: 2px; text-transform: uppercase; margin-top: 0.5rem;">Accessing encrypted archives</p>
    </div>

    <div class="chat-container">
        @if (Model.IsSpam && User.IsInRole("Admin"))
        {
            <div class="quarantine-header">
                <i class="bi bi-shield-slash me-2"></i> SECURITY BREACH DETECTED: TRANSMISSION QUARANTINED
            </div>
        }

        <header class="chat-header">
            <div style="color:white; font-weight:800; font-size:1rem; letter-spacing: 1px; text-transform: uppercase; word-break: break-word;">
                @Model.Subject
            </div>
            <div style="color: #666; font-size: 0.65rem; font-weight: 800; letter-spacing: 1.5px; white-space: nowrap;">
                INITIATED: @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yy HH:mm")
            </div>
        </header>

        @if (Model.Attachments != null && Model.Attachments.Any())
        {
            <div class="evidence-section">
                <div class="evidence-gallery">
                    @foreach (var attachment in Model.Attachments)
                    {
                        <div class="evidence-item">
                            <a href="@attachment.FileUrl" target="_blank">
                                <img src="@attachment.FileUrl" alt="Transmission Evidence" />
                            </a>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="chat-messages">
            @foreach (var msg in Model.Messages.OrderBy(m => m.SentAt))
            {
                var content = msg.Content ?? "";
                bool isSystem = content.StartsWith("[CLOSED]") || content.StartsWith("[RE-OPENED]") ||
                content.StartsWith("[BANNED]") || content.StartsWith("[FLAGGED]") ||
                content.StartsWith("[RESTORED]");

                if (isSystem)
                {
                    if (User.IsInRole("Admin"))
                    {
                        <div class="msg-system" style="@(content.Contains("[BANNED]") || content.Contains("[FLAGGED]") ? "color:#ef4444; border-color:#ef4444;" : content.Contains("[RESTORED]") ? "color:#10b981; border-color:#10b981;" : "")">
                            <i class="bi bi-info-circle me-1"></i> @content
                        </div>
                    }
                    else if (content.StartsWith("[CLOSED]"))
                    {
                        <div class="msg-system">
                            <i class="bi bi-info-circle me-1"></i> TRANSMISSION ARCHIVED
                        </div>
                    }
                }
                else
                {
                    <div class="msg-bubble @(msg.IsAdminReply ? "msg-admin" : "msg-user")">
                        @(User.IsInRole("Admin") ? content : content.Replace("[FLAGGED]", "").Trim())
                    </div>
                }
            }
        </div>

        @if (!Model.IsOpen)
        {
            <div class="archived-banner">
                @if (Model.User?.IsBanned == true && User.IsInRole("Admin"))
                {
                    <i class="bi bi-person-x-fill me-2" style="color: #ef4444;"></i>
                    <span style="color: #ef4444;">OPERATIVE TERMINATED. ACCESS PERMANENTLY REVOKED.</span>
                }
                else
                {
                    <i class="bi bi-lock-fill me-2"></i>
                    <span>THIS TRANSMISSION HAS BEEN ARCHIVED. READ-ONLY MODE ACTIVE.</span>
                }
            </div>
        }
    </div>

    <a asp-action="History" class="btn-return">
        <i class="bi bi-arrow-left"></i> RETURN TO HISTORY
    </a>
</main>