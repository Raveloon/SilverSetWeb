@model SilverSet.Models.ViewModels.ContactViewModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Contact & Support";
}

<style>
    .contact-wrapper {
        padding: 4rem 0;
    }

    .contact-header {
        text-align: center;
        margin-bottom: 4rem;
    }

    .contact-title {
        font-size: 3.5rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 4px;
        color: #fff;
    }

    .contact-subtitle {
        color: #888;
        letter-spacing: 2px;
        font-size: 0.9rem;
        margin-top: 0.5rem;
        text-transform: uppercase;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
    }

    .contact-panel {
        background: rgba(15, 15, 15, 0.9);
        border: 1px solid #222;
        border-radius: 8px;
        padding: 2.5rem;
        display: flex;
        flex-direction: column;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }

    .panel-title {
        color: #fff;
        font-size: 1.1rem;
        font-weight: 800;
        margin-bottom: 2rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        border-bottom: 1px solid #333;
        padding-bottom: 1.2rem;
    }

        .panel-title i {
            color: #fff;
            font-size: 1.2rem;
        }

    .info-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .info-item {
        display: flex;
        align-items: flex-start;
        gap: 1.2rem;
    }

    .info-icon {
        font-size: 1.2rem;
        color: #fff;
        border: 1px solid #444;
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
        flex-shrink: 0;
    }

    .info-content h4 {
        color: #fff;
        font-size: 0.85rem;
        font-weight: 800;
        margin-bottom: 0.3rem;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .info-content p {
        color: #888;
        font-size: 0.85rem;
        margin: 0;
        line-height: 1.5;
    }

    .msg-system {
        align-self: center;
        color: #888;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        padding: 0.5rem 0;
        border-top: 1px solid #333;
        border-bottom: 1px solid #333;
        margin: 1rem 0;
        text-align: center;
        width: 100%;
    }

    .form-control-custom {
        background: #000;
        border: 1px solid #333;
        color: #fff;
        padding: 0.9rem 1.2rem;
        border-radius: 4px;
        width: 100%;
        margin-bottom: 1.5rem;
        font-size: 0.85rem;
    }

        .form-control-custom:focus {
            outline: none;
            border-color: #fff;
            box-shadow: 0 0 10px rgba(255, 255, 255, 0.1);
        }

    .btn-submit-ticket {
        background: #fff;
        color: #000;
        border: 1px solid #fff;
        padding: 0.9rem;
        width: 100%;
        border-radius: 4px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 0.85rem;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

        .btn-submit-ticket:hover {
            background: #ccc;
            border-color: #ccc;
        }

    .btn-history {
        display: block;
        text-align: center;
        color: #888;
        text-decoration: none;
        font-size: 0.75rem;
        font-weight: 800;
        margin-top: 1.5rem;
        transition: color 0.2s;
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

        .btn-history:hover {
            color: #fff;
        }

    .chat-container {
        display: flex;
        flex-direction: column;
        height: 600px;
        background: rgba(0, 0, 0, 0.5);
        border-radius: 8px;
        border: 1px solid #333;
        overflow: hidden;
    }

    .chat-header {
        padding: 1.2rem 1.5rem;
        border-bottom: 1px solid #333;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .chat-status {
        background: #fff;
        color: #000;
        padding: 0.3rem 0.8rem;
        border-radius: 4px;
        font-size: 0.65rem;
        font-weight: 900;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .msg-bubble {
        max-width: 80%;
        padding: 0.85rem 1.2rem;
        border-radius: 4px;
        font-size: 0.85rem;
        line-height: 1.6;
    }

    .msg-user {
        align-self: flex-end;
        background: #222;
        border: 1px solid #444;
        color: #eee;
    }

    .msg-admin {
        align-self: flex-start;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid #fff;
        color: #fff;
    }

    .chat-input-area {
        padding: 1rem 1.5rem;
        border-top: 1px solid #333;
        display: flex;
        gap: 0.8rem;
        align-items: center;
    }

    .btn-send {
        background: #fff;
        color: #000;
        border: 1px solid #fff;
        width: 45px;
        height: 45px;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .auth-denied-box {
        text-align: center;
        padding: 4rem 2rem;
    }

    .btn-auth-now {
        border: 1px solid #fff;
        padding: 0.8rem 2.5rem;
        border-radius: 4px;
        color: #fff !important;
        text-transform: uppercase;
        text-decoration: none;
        font-weight: 800;
        letter-spacing: 2px;
    }

    @@media (max-width: 991px) {
        .contact-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<main class="container contact-wrapper">
    <header class="contact-header">
        <h1 class="contact-title">CONTACT US</h1>
        <p class="contact-subtitle">Establish a direct link with the SilverSet operations team.</p>
    </header>

    <div class="contact-grid">
        <aside class="contact-panel">
            <h2 class="panel-title"><i class="bi bi-hdd-network"></i> Global Comms</h2>
            <ul class="info-list">
                <li class="info-item">
                    <div class="info-icon"><i class="bi bi-envelope-paper"></i></div>
                    <div class="info-content"><h4>Email</h4><p>info@silversetstudios.com</p></div>
                </li>
                <li class="info-item">
                    <div class="info-icon"><i class="bi bi-telephone"></i></div>
                    <div class="info-content"><h4>Phone</h4><p>+90 539 440 7208</p></div>
                </li>
                <li class="info-item">
                    <div class="info-icon"><i class="bi bi-discord"></i></div>
                    <div class="info-content"><h4>Community Server</h4><p><a href="https://discord.gg/q3AYu8f5MJ" style="color:#fff; text-decoration:underline;">Join our Discord</a></p></div>
                </li>
            </ul>
        </aside>

        <section class="contact-panel">
            <h2 class="panel-title"><i class="bi bi-ticket-detailed"></i> Direct Support</h2>

            @if (User.Identity?.IsAuthenticated == true)
            {
                if (Model.ActiveTicket != null)
                {
                    <article class="chat-container">
                        <header class="chat-header">
                            <div>
                                <span style="color:#666; font-size:0.6rem; font-weight:800;">TICKET #@Model.ActiveTicket.Id</span>
                                <div style="color:white; font-weight:700;">@Model.ActiveTicket.Subject</div>
                            </div>
                            <div class="chat-status">ACTIVE</div>
                        </header>
                        <div class="chat-messages" id="chatBox">
                            @foreach (var msg in Model.ActiveTicket.Messages.OrderBy(m => m.SentAt))
                            {
                                <div class="msg-bubble @(msg.IsAdminReply ? "msg-admin" : "msg-user")">@msg.Content</div>
                            }
                        </div>
                        <footer class="chat-input-area">
                            <input type="text" id="messageInput" class="form-control-custom mb-0" placeholder="Transmit message..." />
                            <button class="btn-send" id="sendBtn"><i class="bi bi-send-fill"></i></button>
                        </footer>
                    </article>
                }
                else
                {
                    <form asp-action="CreateTicket" method="post">
                        @Html.AntiForgeryToken()
                        <input type="text" name="subject" class="form-control-custom" placeholder="Subject..." required>
                        <textarea name="message" class="form-control-custom" rows="5" placeholder="Message..." required></textarea>
                        <div class="mb-4 d-flex justify-content-center">
                            <div class="cf-turnstile" data-sitekey="@Configuration["CloudflareTurnstile:SiteKey"]" data-theme="dark"></div>
                        </div>
                        <button type="submit" class="btn-submit-ticket">INITIALIZE TICKET</button>
                    </form>

                    @if (Model.ClosedTicketsCount > 0)
                    {
                        <a asp-action="History" class="btn-history">
                            <i class="bi bi-archive me-1"></i> VIEW PAST LOGS (@Model.ClosedTicketsCount)
                        </a>
                    }
                }
            }
            else
            {
                <div class="auth-denied-box">
                    <h4 style="color: white; margin-bottom: 2rem; letter-spacing: 2px;">ACCESS DENIED</h4>
                    <a asp-controller="Account" asp-action="Login" class="btn-auth-now">Authenticate Now</a>
                </div>
            }
        </section>
    </div>
</main>

@section Scripts {
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    @if (Model.ActiveTicket != null)
    {
        <script>
            const connection = new signalR.HubConnectionBuilder().withUrl("/ticketHub").build();
            const tId = "@Model.ActiveTicket.Id";
            connection.on("ReceiveMessage", (m, isAdmin) => {
                const box = document.getElementById("chatBox");
                const d = document.createElement("div");
                d.className = `msg-bubble ${isAdmin ? "msg-admin" : "msg-user"}`;
                d.textContent = m;
                box.appendChild(d);
                box.scrollTop = box.scrollHeight;
            });
            connection.start().then(() => connection.invoke("JoinTicketGroup", tId));
            document.getElementById("sendBtn").onclick = () => {
                const i = document.getElementById("messageInput");
                if(i.value.trim()) { connection.invoke("SendMessage", parseInt(tId), i.value.trim()); i.value=""; }
            };
        </script>
    }
}