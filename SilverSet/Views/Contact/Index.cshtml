@{
    ViewData["Title"] = "Contact & Support";
    var activeTicket = ViewBag.ActiveTicket as SilverSet.Models.Entities.Ticket;
    int closedTicketsCount = ViewBag.ClosedTicketsCount ?? 0;
}

<style>
    .contact-wrapper {
        padding: 4rem 0;
    }

    .contact-header {
        text-align: center;
        margin-bottom: 4rem;
    }

    .contact-title {
        font-size: 3.5rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 4px;
        background: linear-gradient(90deg, #ffffff, var(--color-accent, #86efac));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-shadow: 0 0 30px rgba(134, 239, 172, 0.1);
    }

    .contact-subtitle {
        color: var(--color-text-muted, #888);
        letter-spacing: 1px;
        font-size: 1.1rem;
        margin-top: 0.5rem;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
    }

    .contact-panel {
        background: rgba(12, 12, 12, 0.6);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--color-border, #222);
        border-radius: 16px;
        padding: 2.5rem;
        display: flex;
        flex-direction: column;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
        transition: border-color 0.3s ease;
    }

        .contact-panel:hover {
            border-color: rgba(160, 160, 160, 0.2);
        }

    .panel-title {
        color: white;
        font-size: 1.2rem;
        font-weight: 800;
        margin-bottom: 2rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        border-bottom: 1px solid var(--color-border, #222);
        padding-bottom: 1.2rem;
    }

        .panel-title i {
            color: #aaa;
            font-size: 1.4rem;
        }

    .info-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .info-item {
        display: flex;
        align-items: flex-start;
        gap: 1.2rem;
        transition: transform 0.2s ease;
    }

        .info-item:hover {
            transform: translateX(5px);
        }

    .info-icon {
        font-size: 1.4rem;
        color: #aaa;
        background: rgba(160, 160, 160, 0.05);
        border: 1px solid rgba(160, 160, 160, 0.15);
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        box-shadow: inset 0 0 10px rgba(160, 160, 160, 0.05);
        flex-shrink: 0;
    }

    .info-content h4 {
        color: white;
        font-size: 0.95rem;
        font-weight: 700;
        margin-bottom: 0.3rem;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .info-content p {
        color: var(--color-text-muted, #888);
        font-size: 0.9rem;
        margin: 0;
        line-height: 1.5;
    }

    .info-content a {
        color: var(--color-text-muted, #888);
        text-decoration: none;
        transition: color 0.2s ease;
    }

        .info-content a:hover {
            color: var(--color-accent, #86efac);
        }

    .form-control-custom {
        background: rgba(0, 0, 0, 0.4);
        border: 1px solid var(--color-border, #333);
        color: white;
        padding: 0.9rem 1.2rem;
        border-radius: 10px;
        width: 100%;
        margin-bottom: 1.5rem;
        transition: all 0.3s ease;
        font-size: 0.95rem;
    }

        .form-control-custom:focus {
            outline: none;
            border-color: rgba(160, 160, 160, 0.6);
            background: rgba(0, 0, 0, 0.6);
            box-shadow: 0 0 15px rgba(160, 160, 160, 0.1);
        }

        .form-control-custom::placeholder {
            color: rgba(255, 255, 255, 0.3);
        }

    .btn-submit-ticket {
        background: rgba(134, 239, 172, 0.05);
        color: var(--color-accent, #86efac);
        border: 1px solid var(--color-accent, #86efac);
        padding: 0.9rem;
        width: 100%;
        border-radius: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 0.85rem;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

        .btn-submit-ticket:hover {
            background: rgba(160, 160, 160, 0.1);
            box-shadow: 0 0 20px rgba(160, 160, 160, 0.2);
            transform: translateY(-2px);
            color: white;
        }

    .btn-history {
        display: block;
        text-align: center;
        color: var(--color-text-muted, #888);
        text-decoration: none;
        font-size: 0.8rem;
        margin-top: 1.5rem;
        transition: color 0.2s;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .btn-history:hover {
            color: #aaa;
        }

    .chat-container {
        display: flex;
        flex-direction: column;
        height: 600px;
        max-height: 600px;
        background: rgba(0, 0, 0, 0.2);
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        overflow: hidden;
    }

    .chat-header {
        padding: 1.2rem 1.5rem;
        background: rgba(255, 255, 255, 0.02);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-shrink: 0;
    }

    .pulse-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        background-color: #86efac;
        border-radius: 50%;
        margin-right: 6px;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(134, 239, 172, 0.7);
        }

        70% {
            box-shadow: 0 0 0 6px rgba(134, 239, 172, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(134, 239, 172, 0);
        }
    }

    .chat-status {
        display: flex;
        align-items: center;
        background: rgba(160, 160, 160, 0.08);
        color: #aaa;
        border: 1px solid rgba(160, 160, 160, 0.2);
        padding: 0.3rem 0.8rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .chat-messages {
        flex: 1 1 0;
        height: 0;
        overflow-y: auto;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

        .chat-messages::-webkit-scrollbar {
            width: 8px;
        }

        .chat-messages::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 10px;
        }

        .chat-messages::-webkit-scrollbar-thumb {
            background: rgba(160, 160, 160, 0.4);
            border-radius: 10px;
        }

            .chat-messages::-webkit-scrollbar-thumb:hover {
                background: rgba(160, 160, 160, 0.6);
            }

    .msg-bubble {
        max-width: 80%;
        padding: 0.85rem 1.2rem;
        border-radius: 12px;
        font-size: 0.9rem;
        line-height: 1.6;
        word-wrap: break-word;
        flex-shrink: 0;
    }

    .msg-user {
        align-self: flex-end;
        background: rgba(134, 239, 172, 0.08);
        border: 1px solid rgba(134, 239, 172, 0.2);
        color: #f1f1f1;
        border-bottom-right-radius: 2px;
    }

    .msg-admin {
        align-self: flex-start;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: #ccc;
        border-bottom-left-radius: 2px;
    }

    .chat-input-area {
        padding: 1rem 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        gap: 0.8rem;
        background: rgba(10, 10, 10, 0.6);
        align-items: center;
        flex-shrink: 0;
    }

        .chat-input-area .form-control-custom {
            margin-bottom: 0;
            border-radius: 20px;
            padding: 0.7rem 1.2rem;
            background: rgba(0,0,0,0.5);
        }

    .btn-send {
        background: var(--color-accent, #86efac);
        color: #000;
        border: none;
        width: 45px;
        height: 45px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        transition: all 0.2s ease;
        flex-shrink: 0;
        box-shadow: 0 0 10px rgba(134, 239, 172, 0.2);
    }

        .btn-send:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(134, 239, 172, 0.4);
        }

    .auth-denied-box {
        text-align: center;
        padding: 4rem 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
    }

    .btn-auth-now {
        background: linear-gradient(135deg, var(--color-btn-from, #222), var(--color-btn-to, #444));
        color: var(--color-accent, #86efac) !important;
        border: 1px solid var(--color-accent, #86efac);
        padding: 0.8rem 2.5rem;
        border-radius: 8px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-block;
    }

        .btn-auth-now:hover {
            box-shadow: 0 0 20px rgba(134, 239, 172, 0.15);
            transform: translateY(-2px);
        }

    @@media (max-width: 991px) {
        .contact-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="container contact-wrapper">
    <div class="contact-header">
        <h1 class="contact-title">CONTACT US</h1>
        <p class="contact-subtitle">Establish a direct link with the SilverSet operations team.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success bg-transparent border-success text-success text-center mb-4" style="border-radius: 12px; font-weight: 600;">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger bg-transparent border-danger text-danger text-center mb-4" style="border-radius: 12px; font-weight: 600;">
            @TempData["Error"]
        </div>
    }

    <div class="contact-grid">
        <div class="contact-panel">
            <h3 class="panel-title"><i class="bi bi-hdd-network"></i> Global Comms</h3>
            <ul class="info-list">
                <li class="info-item">
                    <div class="info-icon"><i class="bi bi-envelope-paper"></i></div>
                    <div class="info-content">
                        <h4>Email</h4>
                        <p>info@silversetstudios.com</p>
                    </div>
                </li>
                <li class="info-item">
                    <div class="info-icon"><i class="bi bi-telephone"></i></div>
                    <div class="info-content">
                        <h4>Phone</h4>
                        <p>+90 539 440 7208</p>
                    </div>
                </li>
                <li class="info-item">
                    <div class="info-icon"><i class="bi bi-discord"></i></div>
                    <div class="info-content">
                        <h4>Community Server</h4>
                        <p><a href="https://discord.gg/q3AYu8f5MJ" target="_blank">Join our Discord server</a></p>
                    </div>
                </li>
                <li class="info-item">
                    <div class="info-icon"><i class="bi bi-geo-alt"></i></div>
                    <div class="info-content">
                        <h4>Address</h4>
                        <p>Kızılırmak Mah. Dumlupınar Bul. No: 9a İç Kapı No: 158 Çankaya / Ankara</p>
                    </div>
                </li>
            </ul>
        </div>

        <div class="contact-panel">
            <h3 class="panel-title"><i class="bi bi-ticket-detailed"></i> Direct Support</h3>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                if (activeTicket != null)
                {
                    <div class="chat-container">
                        <div class="chat-header">
                            <div>
                                <span style="color:var(--color-text-muted, #888); font-size:0.75rem; font-weight:800; letter-spacing:1px; text-transform: uppercase;">Ticket #@activeTicket.Id</span>
                                <div style="color:white; font-weight:700; font-size:1rem; margin-top:0.2rem;">@activeTicket.Subject</div>
                            </div>
                            <div class="chat-status">
                                <span class="pulse-dot"></span> OPEN
                            </div>
                        </div>
                        <div class="chat-messages" id="chatBox">
                            @foreach (var msg in activeTicket.Messages.OrderBy(m => m.SentAt))
                            {
                                <div class="msg-bubble @(msg.IsAdminReply ? "msg-admin" : "msg-user")">
                                    @msg.Content
                                </div>
                            }
                        </div>
                        <div class="chat-input-area">
                            <input type="text" id="messageInput" class="form-control-custom" placeholder="Transmit message..." autocomplete="off" />
                            <button class="btn-send" id="sendBtn" title="Send Message">
                                <i class="bi bi-send-fill"></i>
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <form asp-controller="Contact" asp-action="CreateTicket" method="post">
                        <div>
                            <label class="form-label text-muted" style="font-size: 0.8rem; font-weight: 700; text-transform:uppercase; letter-spacing:1px;">Subject Line</label>
                            <input type="text" name="subject" class="form-control-custom" placeholder="Briefly describe the issue..." required>
                        </div>
                        <div>
                            <label class="form-label text-muted" style="font-size: 0.8rem; font-weight: 700; text-transform:uppercase; letter-spacing:1px;">Initial Transmission</label>
                            <textarea name="message" class="form-control-custom" rows="5" placeholder="Provide detailed information here..." required></textarea>
                        </div>
                        <button type="submit" class="btn-submit-ticket"><i class="bi bi-send-fill"></i> Initialize Ticket</button>
                    </form>

                    @if (closedTicketsCount > 0)
                    {
                        <a asp-controller="Contact" asp-action="History" class="btn-history"><i class="bi bi-clock-history me-1"></i> View Past Tickets (@closedTicketsCount)</a>
                    }
                }
            }
            else
            {
                <div class="auth-denied-box">
                    <i class="bi bi-shield-lock" style="font-size: 4rem; color: rgba(255,255,255,0.1); margin-bottom: 1.5rem; display:block;"></i>
                    <h4 style="color: white; font-weight:900; margin-bottom: 0.5rem; letter-spacing: 1px;">Access Denied</h4>
                    <p style="color: var(--color-text-muted, #888); font-size: 0.95rem; margin-bottom: 2.5rem; line-height: 1.6;">A verified operative account is required to establish a direct secure line with the command center.</p>
                    <a asp-controller="Account" asp-action="Login" class="btn-auth-now">Authenticate Now</a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    @if (activeTicket != null)
    {
        <script>
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/ticketHub")
                .build();

            const ticketId = '@activeTicket.Id';
            const userId = '@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value';

            connection.on("ReceiveMessage", function (message, isAdminReply) {
                const chatBox = document.getElementById("chatBox");
                const bubbleClass = isAdminReply ? "msg-admin" : "msg-user";

                const msgDiv = document.createElement("div");
                msgDiv.className = `msg-bubble ${bubbleClass}`;
                msgDiv.textContent = message;

                chatBox.appendChild(msgDiv);
                chatBox.scrollTop = chatBox.scrollHeight;
            });

            connection.start().then(function () {
                connection.invoke("JoinTicketGroup", ticketId);
                const chatBox = document.getElementById("chatBox");
                chatBox.scrollTop = chatBox.scrollHeight;
            }).catch(function (err) {
                return console.error(err.toString());
            });

            document.getElementById("sendBtn").addEventListener("click", function (event) {
                const messageInput = document.getElementById("messageInput");
                const message = messageInput.value;

                if (message.trim() !== "") {
                    connection.invoke("SendMessage", parseInt(ticketId), parseInt(userId), message)
                        .catch(function (err) {
                            return console.error(err.toString());
                        });

                    messageInput.value = "";
                }
                event.preventDefault();
            });

            document.getElementById("messageInput").addEventListener("keypress", function (e) {
                if (e.key === 'Enter') {
                    document.getElementById("sendBtn").click();
                }
            });
        </script>
    }
}