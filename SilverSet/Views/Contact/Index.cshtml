@model SilverSet.Models.ViewModels.ContactViewModel
@{
    ViewData["Title"] = "Contact & Support";
}

<style>
    .contact-wrapper {
        padding: 4rem 0;
    }

    .contact-header {
        text-align: center;
        margin-bottom: 4rem;
    }

    .contact-title {
        font-size: 3.5rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 4px;
        color: #fff;
    }

    .contact-subtitle {
        color: #888;
        letter-spacing: 2px;
        font-size: 0.9rem;
        margin-top: 0.5rem;
        text-transform: uppercase;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
    }

    .contact-panel {
        background: rgba(15, 15, 15, 0.9);
        border: 1px solid #222;
        border-radius: 8px;
        padding: 2.5rem;
        display: flex;
        flex-direction: column;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }

    .panel-title {
        color: #fff;
        font-size: 1.1rem;
        font-weight: 800;
        margin-bottom: 2rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        border-bottom: 1px solid #333;
        padding-bottom: 1.2rem;
    }

        .panel-title i {
            color: #fff;
            font-size: 1.2rem;
        }

    .info-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .info-item {
        display: flex;
        align-items: flex-start;
        gap: 1.2rem;
    }

    .info-icon {
        font-size: 1.2rem;
        color: #fff;
        background: transparent;
        border: 1px solid #444;
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
        flex-shrink: 0;
    }

    .info-content h4 {
        color: #fff;
        font-size: 0.85rem;
        font-weight: 800;
        margin-bottom: 0.3rem;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .info-content p {
        color: #888;
        font-size: 0.85rem;
        margin: 0;
        line-height: 1.5;
    }

    .msg-system {
        align-self: center;
        color: #888;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        padding: 0.5rem 0;
        border-top: 1px solid #333;
        border-bottom: 1px solid #333;
        margin: 1rem 0;
        text-align: center;
        width: 100%;
    }
    .info-content a {
        color: #fff;
        text-decoration: none;
        border-bottom: 1px solid #444;
        transition: border-color 0.2s ease;
    }

        .info-content a:hover {
            border-color: #fff;
        }

    .form-control-custom {
        background: #000;
        border: 1px solid #333;
        color: #fff;
        padding: 0.9rem 1.2rem;
        border-radius: 4px;
        width: 100%;
        margin-bottom: 1.5rem;
        font-size: 0.85rem;
    }

        .form-control-custom:focus {
            outline: none;
            border-color: #fff;
            box-shadow: 0 0 10px rgba(255, 255, 255, 0.1);
        }

        .form-control-custom::placeholder {
            color: #666;
        }

    .btn-submit-ticket {
        background: #fff;
        color: #000;
        border: 1px solid #fff;
        padding: 0.9rem;
        width: 100%;
        border-radius: 4px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 0.85rem;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

        .btn-submit-ticket:hover {
            background: #ccc;
            border-color: #ccc;
        }

    .btn-history {
        display: block;
        text-align: center;
        color: #888;
        text-decoration: none;
        font-size: 0.75rem;
        font-weight: 800;
        margin-top: 1.5rem;
        transition: color 0.2s;
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

        .btn-history:hover {
            color: #fff;
        }

    .chat-container {
        display: flex;
        flex-direction: column;
        height: 600px;
        max-height: 600px;
        background: rgba(0, 0, 0, 0.5);
        border-radius: 8px;
        border: 1px solid #333;
        overflow: hidden;
    }

    .chat-header {
        padding: 1.2rem 1.5rem;
        background: transparent;
        border-bottom: 1px solid #333;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-shrink: 0;
    }

    .chat-status {
        display: flex;
        align-items: center;
        background: #fff;
        color: #000;
        padding: 0.3rem 0.8rem;
        border-radius: 4px;
        font-size: 0.65rem;
        font-weight: 900;
        letter-spacing: 1px;
    }

    .chat-messages {
        flex: 1 1 0;
        height: 0;
        overflow-y: auto;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

        .chat-messages::-webkit-scrollbar {
            width: 8px;
        }

        .chat-messages::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
        }

        .chat-messages::-webkit-scrollbar-thumb {
            background: #444;
            border-radius: 4px;
        }

    .msg-bubble {
        max-width: 80%;
        padding: 0.85rem 1.2rem;
        border-radius: 4px;
        font-size: 0.85rem;
        line-height: 1.6;
        word-wrap: break-word;
        flex-shrink: 0;
    }

    .msg-user {
        align-self: flex-end;
        background: #222;
        border: 1px solid #444;
        color: #eee;
    }

    .msg-admin {
        align-self: flex-start;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid #fff;
        color: #fff;
    }

    .chat-input-area {
        padding: 1rem 1.5rem;
        border-top: 1px solid #333;
        display: flex;
        gap: 0.8rem;
        background: transparent;
        align-items: center;
        flex-shrink: 0;
    }

        .chat-input-area .form-control-custom {
            margin-bottom: 0;
            padding: 0.7rem 1.2rem;
        }

    .btn-send {
        background: #fff;
        color: #000;
        border: 1px solid #fff;
        width: 45px;
        height: 45px;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }

        .btn-send:hover {
            background: #ccc;
            border-color: #ccc;
        }

    .auth-denied-box {
        text-align: center;
        padding: 4rem 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: white;
    }

    .btn-auth-now {
        background: transparent;
        color: #fff !important;
        border: 1px solid #fff;
        padding: 0.8rem 2.5rem;
        border-radius: 4px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 2px;
        text-decoration: none;
        transition: all 0.2s ease;
        display: inline-block;
        font-size: 0.85rem;
    }

        .btn-auth-now:hover {
            background: #fff;
            color: #000 !important;
        }

    @@media (max-width: 991px) {
        .contact-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<main class="container contact-wrapper">
    <header class="contact-header">
        <h1 class="contact-title">CONTACT US</h1>
        <p class="contact-subtitle">Establish a direct link with the SilverSet operations team.</p>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success bg-transparent border-success text-success text-center mb-4" role="alert" style="border-radius: 4px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; font-size: 0.8rem;">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger bg-transparent border-danger text-danger text-center mb-4" role="alert" style="border-radius: 4px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; font-size: 0.8rem;">
            @TempData["Error"]
        </div>
    }

    <div class="contact-grid">
        <aside class="contact-panel">
            <h2 class="panel-title"><i class="bi bi-hdd-network"></i> Global Comms</h2>
            <ul class="info-list">
                <li class="info-item">
                    <div class="info-icon"><i class="bi bi-envelope-paper"></i></div>
                    <div class="info-content">
                        <h4>Email</h4>
                        <p>info@silversetstudios.com</p>
                    </div>
                </li>
                <li class="info-item">
                    <div class="info-icon"><i class="bi bi-telephone"></i></div>
                    <div class="info-content">
                        <h4>Phone</h4>
                        <p>+90 539 440 7208</p>
                    </div>
                </li>
                <li class="info-item">
                    <div class="info-icon"><i class="bi bi-discord"></i></div>
                    <div class="info-content">
                        <h4>Community Server</h4>
                        <p><a href="https://discord.gg/q3AYu8f5MJ" target="_blank" rel="noopener">Join our Discord server</a></p>
                    </div>
                </li>
                <li class="info-item">
                    <div class="info-icon"><i class="bi bi-geo-alt"></i></div>
                    <div class="info-content">
                        <h4>Address</h4>
                        <p>Kızılırmak Mah. Dumlupınar Bul. No: 9a İç Kapı No: 158 Çankaya / Ankara</p>
                    </div>
                </li>
            </ul>
        </aside>

        <section class="contact-panel">
            <h2 class="panel-title"><i class="bi bi-ticket-detailed"></i> Direct Support</h2>

            @if (User.Identity?.IsAuthenticated == true)
            {
                if (Model.ActiveTicket != null)
                {
                    <article class="chat-container">
                        <header class="chat-header">
                            <div>
                                <span style="color:#666; font-size:0.65rem; font-weight:800; letter-spacing:1.5px; text-transform: uppercase;">Ticket #@Model.ActiveTicket.Id</span>
                                <div style="color:white; font-weight:700; font-size:0.95rem; margin-top:0.3rem; letter-spacing: 1px;">@Model.ActiveTicket.Subject</div>
                            </div>
                            <div class="chat-status">
                                ACTIVE
                            </div>
                        </header>
                        <div class="chat-messages" id="chatBox">
                            @foreach (var msg in Model.ActiveTicket.Messages.OrderBy(m => m.SentAt))
                            {
                                if (msg.Content.StartsWith("[CLOSED]") || msg.Content.StartsWith("[RE-OPENED]"))
                                {
                                    <div class="msg-system">
                                        <i class="bi bi-shield-exclamation"></i> @msg.Content
                                    </div>
                                }
                                else
                                {
                                    <div class="msg-bubble @(msg.IsAdminReply ? "msg-admin" : "msg-user")">
                                        @msg.Content
                                    </div>
                                }
                            }
                        </div>
                        <footer class="chat-input-area">
                            <input type="text" id="messageInput" class="form-control-custom" placeholder="Transmit message..." autocomplete="off" />
                            <button class="btn-send" id="sendBtn" aria-label="Send Message">
                                <i class="bi bi-send-fill"></i>
                            </button>
                        </footer>
                    </article>
                }
                else
                {
                    <form asp-controller="Contact" asp-action="CreateTicket" method="post">
                        <div>
                            <label class="form-label text-muted" style="font-size: 0.65rem; font-weight: 800; text-transform:uppercase; letter-spacing:1.5px;">Subject Line</label>
                            <input type="text" name="subject" class="form-control-custom" placeholder="Briefly describe the issue..." required>
                        </div>
                        <div>
                            <label class="form-label text-muted" style="font-size: 0.65rem; font-weight: 800; text-transform:uppercase; letter-spacing:1.5px;">Initial Transmission</label>
                            <textarea name="message" class="form-control-custom" rows="5" placeholder="Provide detailed information here..." required></textarea>
                        </div>
                        <button type="submit" class="btn-submit-ticket" aria-label="Initialize Ticket">INITIALIZE TICKET</button>
                    </form>

                    @if (Model.ClosedTicketsCount > 0)
                    {
                        <a asp-controller="Contact" asp-action="History" class="btn-history"><i class="bi bi-archive me-1"></i> View Past Logs (@Model.ClosedTicketsCount)</a>
                    }
                }
            }
            else
            {
                <div class="auth-denied-box">
                    <i class="bi bi-shield-lock" style="font-size: 3rem; color: #444; margin-bottom: 1.5rem; display:block;"></i>
                    <h4 style="color: white; font-weight:800; margin-bottom: 0.5rem; letter-spacing: 2px; text-transform: uppercase;">Access Denied</h4>
                    <p style="color: #666; font-size: 0.85rem; margin-bottom: 2.5rem; line-height: 1.6; max-width: 80%;">A verified operative account is required to establish a direct secure line with the command center.</p>
                    <a asp-controller="Account" asp-action="Login" class="btn-auth-now">Authenticate Now</a>
                </div>
            }
        </section>
    </div>
</main>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    @if (Model.ActiveTicket != null)
    {
        <script>
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/ticketHub")
                .withAutomaticReconnect()
                .build();

            const ticketId = @Model.ActiveTicket.Id;

            connection.on("ReceiveMessage", function (message, isAdminReply) {
                const chatBox = document.getElementById("chatBox");
                const msgDiv = document.createElement("div");
                msgDiv.className = `msg-bubble ${isAdminReply ? "msg-admin" : "msg-user"}`;
                msgDiv.textContent = message;
                chatBox.appendChild(msgDiv);
                chatBox.scrollTop = chatBox.scrollHeight;
            });

            connection.start().then(function () {
                connection.invoke("JoinTicketGroup", ticketId.toString());
                document.getElementById("chatBox").scrollTop = document.getElementById("chatBox").scrollHeight;
            }).catch(err => console.error(err.toString()));

            document.getElementById("sendBtn").addEventListener("click", function (event) {
                event.preventDefault();
                const input = document.getElementById("messageInput");
                const message = input.value.trim();

                if (message) {
                    connection.invoke("SendMessage", ticketId, message)
                        .catch(err => console.error(err.toString()));
                    input.value = "";
                }
            });

            document.getElementById("messageInput").addEventListener("keypress", function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    document.getElementById("sendBtn").click();
                }
            });
        </script>
    }
}