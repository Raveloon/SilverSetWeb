@model SilverSet.Models.ViewModels.ContactViewModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Contact & Support";
}

<style>
    .contact-wrapper {
        padding: 4rem 0;
    }

    .contact-header {
        text-align: center;
        margin-bottom: 4rem;
    }

    .contact-title {
        font-size: 3.5rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 4px;
        color: #fff;
    }

    .contact-subtitle {
        color: #ccc;
        letter-spacing: 2px;
        font-size: 0.9rem;
        margin-top: 0.5rem;
        text-transform: uppercase;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
    }

    .contact-panel {
        background: rgba(15, 15, 15, 0.9);
        border: 1px solid #222;
        border-radius: 8px;
        padding: 2.5rem;
        display: flex;
        flex-direction: column;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }

    .panel-title {
        color: #fff;
        font-size: 1.1rem;
        font-weight: 800;
        margin-bottom: 2rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        border-bottom: 1px solid #333;
        padding-bottom: 1.2rem;
    }

    .info-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .info-item {
        display: flex;
        align-items: flex-start;
        gap: 1.2rem;
    }

    .info-icon {
        font-size: 1.2rem;
        color: #fff;
        border: 1px solid #444;
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
        flex-shrink: 0;
    }

    .info-content h4 {
        color: #fff;
        font-size: 0.85rem;
        font-weight: 800;
        margin-bottom: 0.3rem;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .info-content p {
        color: #ccc;
        font-size: 0.85rem;
        margin: 0;
        line-height: 1.5;
    }

    .form-control-custom {
        background: #000;
        border: 1px solid #333;
        color: #fff;
        padding: 0.9rem 1.2rem;
        border-radius: 4px;
        width: 100%;
        margin-bottom: 1.5rem;
        font-size: 0.85rem;
        transition: 0.2s;
    }

        .form-control-custom:focus {
            outline: none;
            border-color: #fff;
            box-shadow: 0 0 10px rgba(255, 255, 255, 0.1);
        }

    .file-upload-wrapper {
        position: relative;
        margin-bottom: 1rem;
    }

    .file-upload-label {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        background: #0a0a0a;
        border: 1px dashed #444;
        color: #ccc;
        padding: 1.5rem;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 0.75rem;
        font-weight: 800;
    }

        .file-upload-label:hover {
            border-color: #fff;
            color: #fff;
            background: rgba(255,255,255,0.02);
        }

    .preview-container {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 1.5rem;
    }

    .preview-box {
        position: relative;
        width: 80px;
        height: 80px;
        border-radius: 4px;
        border: 1px solid #333;
        overflow: hidden;
    }

        .preview-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .remove-btn {
        position: absolute;
        top: 2px;
        right: 2px;
        background: rgba(239, 68, 68, 0.9);
        color: white;
        border: none;
        border-radius: 2px;
        width: 18px;
        height: 18px;
        font-size: 12px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
    }

    .btn-submit-ticket {
        background: #fff;
        color: #000;
        border: 1px solid #fff;
        padding: 0.9rem;
        width: 100%;
        border-radius: 4px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 0.85rem;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        cursor: pointer;
    }

    .btn-history {
        display: block;
        text-align: center;
        color: #ccc;
        text-decoration: none;
        font-size: 0.75rem;
        font-weight: 800;
        margin-top: 1.5rem;
        transition: color 0.2s;
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

    .chat-container {
        display: flex;
        flex-direction: column;
        height: 600px;
        background: rgba(0, 0, 0, 0.5);
        border-radius: 8px;
        border: 1px solid #333;
        overflow: hidden;
    }

    .chat-header {
        padding: 1.2rem 1.5rem;
        border-bottom: 1px solid #333;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .evidence-bar {
        display: flex;
        gap: 0.5rem;
        padding: 0.8rem 1.5rem;
        background: rgba(255,255,255,0.02);
        border-bottom: 1px solid #222;
        overflow-x: auto;
    }

    .evidence-thumb {
        width: 40px;
        height: 40px;
        object-fit: cover;
        border-radius: 4px;
        border: 1px solid #444;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .msg-bubble {
        max-width: 85%;
        padding: 0.85rem 1.2rem;
        border-radius: 4px;
        font-size: 0.85rem;
        line-height: 1.6;
        word-wrap: break-word;
        word-break: break-all;
        overflow-wrap: anywhere;
    }

    .msg-user {
        align-self: flex-end;
        background: #222;
        border: 1px solid #444;
        color: #eee;
    }

    .msg-admin {
        align-self: flex-start;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid #fff;
        color: #fff;
    }

    .msg-system {
        align-self: center;
        color: #888;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        padding: 0.5rem 1rem;
        border-top: 1px dashed #333;
        border-bottom: 1px dashed #333;
        margin: 0.5rem 0;
        text-align: center;
        width: 80%;
    }

    .chat-input-area {
        padding: 1rem 1.5rem;
        border-top: 1px solid #333;
    }

    .input-wrapper {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .input-row {
        display: flex;
        gap: 0.8rem;
        align-items: center;
    }

    .btn-send {
        background: #fff;
        color: #000;
        border: 1px solid #fff;
        width: 45px;
        height: 45px;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.2s;
    }

        .btn-send:disabled {
            background: #333;
            border-color: #333;
            color: #666;
            cursor: not-allowed;
        }

    .char-counter {
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 1.5px;
        color: #bbb;
        text-transform: uppercase;
        text-align: right;
    }

    @@media (max-width: 991px) {
        .contact-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<main class="container contact-wrapper">
    <header class="contact-header">
        <h1 class="contact-title">CONTACT US</h1>
        <p class="contact-subtitle">Establish a direct link with the SilverSet operations team.</p>
    </header>
    <div class="contact-grid">
        <aside class="contact-panel">
            <h2 class="panel-title"><i class="bi bi-hdd-network"></i> contact informations</h2>
            <ul class="info-list">
                <li class="info-item">
                    <div class="info-icon"><i class="bi bi-envelope-paper"></i></div>
                    <div class="info-content"><h4>Email</h4><p>info@silversetstudios.com</p></div>
                </li>
                <li class="info-item">
                    <div class="info-icon"><i class="bi bi-telephone"></i></div>
                    <div class="info-content"><h4>Phone</h4><p>+90 539 440 7208</p></div>
                </li>
                <li class="info-item">
                    <div class="info-icon"><i class="bi bi-discord"></i></div>
                    <div class="info-content"><h4>Community Server</h4><p><a href="https://discord.gg/q3AYu8f5MJ" style="color:#fff; text-decoration:underline;">Join our Discord</a></p></div>
                </li>
            </ul>
        </aside>
        <section class="contact-panel">
            <h2 class="panel-title"><i class="bi bi-ticket-detailed"></i> Direct Support</h2>
            @if (User?.Identity?.IsAuthenticated == true)
            {
                if (Model?.ActiveTicket != null)
                {
                    <article class="chat-container">
                        <header class="chat-header">
                            <div>
                                <span style="color:#bbb; font-size:0.6rem; font-weight:800;">TICKET #@Model.ActiveTicket.Id</span>
                                <div style="color:white; font-weight:700;">@Model.ActiveTicket.Subject</div>
                            </div>
                            <div style="background:#fff; color:#000; padding:0.3rem 0.8rem; border-radius:4px; font-size:0.65rem; font-weight:900;">ACTIVE</div>
                        </header>
                        @if (Model.ActiveTicket.Attachments?.Any() == true)
                        {
                            <div class="evidence-bar">
                                @foreach (var att in Model.ActiveTicket.Attachments)
                                {
                                    <a href="@att.FileUrl" target="_blank"><img src="@att.FileUrl" class="evidence-thumb" alt="Evidence" /></a>
                                }
                            </div>
                        }
                        <div class="chat-messages" id="chatBox">
                            @foreach (var msg in Model.ActiveTicket.Messages.OrderBy(m => m.SentAt))
                            {
                                var raw = msg.Content ?? "";
                                bool isSystem = raw.StartsWith("[CLOSED]") || raw.StartsWith("[RE-OPENED]") || raw.StartsWith("[BANNED]") || raw.StartsWith("[FLAGGED]") || raw.StartsWith("[RESTORED]");
                                if (isSystem)
                                {
                                    @* DÜZELTİLDİ: Null-safe rol kontrolü *@
                                    if (User?.IsInRole("Admin") == true)
                                    {
                                        <div class="msg-system" style="@(raw.Contains("[BANNED]") || raw.Contains("[FLAGGED]") ? "color:#ef4444; border-color:#ef4444;" : raw.Contains("[RESTORED]") ? "color:#10b981; border-color:#10b981;" : "")">
                                            <i class="bi bi-info-circle me-1"></i> @raw
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="msg-bubble @(msg.IsAdminReply ? "msg-admin" : "msg-user")">@raw</div>
                                }
                            }
                        </div>
                        <footer class="chat-input-area">
                            <div class="input-wrapper">
                                <div class="input-row">
                                    <input type="text" id="messageInput" class="form-control-custom mb-0" placeholder="Transmit real-time message..." autocomplete="off" maxlength="500" />
                                    <button id="sendBtn" class="btn-send"><i class="bi bi-send-fill"></i></button>
                                </div>
                                <div id="chatCounter" class="char-counter">0 / 500 CHARACTERS</div>
                            </div>
                        </footer>
                    </article>
                }
                else
                {
                    <form asp-action="CreateTicket" method="post" enctype="multipart/form-data" id="ticketForm">
                        @Html.AntiForgeryToken()
                        <input type="text" name="subject" class="form-control-custom" placeholder="MISSION SUBJECT..." required>
                        <textarea name="message" class="form-control-custom" rows="4" placeholder="DETAILED INTEL..." required></textarea>
                        <div class="file-upload-wrapper">
                            <input type="file" id="attachments" multiple hidden accept="image/*">
                            <label for="attachments" class="file-upload-label">
                                <i class="bi bi-cloud-arrow-up"></i>
                                <span id="file-label-text">Attach Evidence (Max 5)</span>
                            </label>
                        </div>
                        <div id="preview-area" class="preview-container"></div>
                        <div class="mb-4 d-flex justify-content-center">
                            <div class="cf-turnstile" data-sitekey="@Configuration["CloudflareTurnstile:SiteKey"]" data-theme="dark"></div>
                        </div>
                        <button type="submit" id="submitTicketBtn" class="btn-submit-ticket">INITIALIZE MISSION</button>
                    </form>
                    @if (Model?.ClosedTicketsCount > 0)
                    {
                        <a asp-action="History" class="btn-history"><i class="bi bi-archive me-1"></i> VIEW PAST LOGS (@Model.ClosedTicketsCount)</a>
                    }
                }
            }
            else
            {
                <div style="text-align:center; padding: 3rem 0;">
                    <h4 style="color: white; margin-bottom: 2rem; letter-spacing: 2px; font-weight: 800;">ENCRYPTION REQUIRED</h4>
                    <!-- HATA BURADAN KAYNAKLANIYORDU, HTML HREF'E ÇEVRİLDİ -->
                    <a href="/Account/Login" class="btn-submit-ticket" style="text-decoration:none;">AUTHENTICATE NOW</a>
                </div>
            }
        </section>
    </div>
</main>

@section Scripts {
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        const fileInput = document.getElementById('attachments');
        const previewArea = document.getElementById('preview-area');
        const labelText = document.getElementById('file-label-text');
        const ticketForm = document.getElementById('ticketForm');
        let selectedFiles = [];

        if (fileInput) {
            fileInput.addEventListener('change', function () {
                const files = Array.from(this.files);
                files.forEach(file => { if (selectedFiles.length < 5) selectedFiles.push(file); });
                renderPreviews();
                this.value = "";
            });
        }

        function renderPreviews() {
            if (!previewArea) return;
            previewArea.innerHTML = "";
            selectedFiles.forEach((file, index) => {
                const reader = new FileReader();
                const box = document.createElement("div");
                box.className = "preview-box";
                reader.onload = (e) => {
                    box.innerHTML = `<img src="${e.target.result}"><button type="button" class="remove-btn" onclick="removeFile(${index})">×</button>`;
                };
                reader.readAsDataURL(file);
                previewArea.appendChild(box);
            });
            if (labelText) labelText.innerHTML = selectedFiles.length > 0 ? `<span style="color:#fff;">${selectedFiles.length}</span> FILE(S) SELECTED` : "Attach Evidence (Max 5)";
        }

        window.removeFile = function (index) {
            selectedFiles.splice(index, 1);
            renderPreviews();
        }

        if (ticketForm) {
            ticketForm.addEventListener('submit', function (e) {
                const dt = new DataTransfer();
                selectedFiles.forEach(file => dt.items.add(file));
                const finalInput = document.createElement('input');
                finalInput.type = 'file';
                finalInput.name = 'attachments';
                finalInput.multiple = true;
                finalInput.files = dt.files;
                finalInput.style.display = 'none';
                this.appendChild(finalInput);
            });
        }

        @if (Model?.ActiveTicket != null)
        {
            <text>
                const connection = new signalR.HubConnectionBuilder().withUrl("/ticketHub").withAutomaticReconnect().build();
                const chatBox = document.getElementById("chatBox");
                const messageInput = document.getElementById("messageInput");
                const sendBtn = document.getElementById("sendBtn");
                const ticketId = "@Model.ActiveTicket.Id";

                if (chatBox) chatBox.scrollTop = chatBox.scrollHeight;

                connection.on("ReceiveMessage", (message, isAdmin) => {
                    // DÜZELTİLDİ: Null-safe rol kontrolü JS
                    const isAdminUser = "@(User?.IsInRole("Admin") == true ? "true" : "false")" === "true";
                    const isSystem = message.startsWith("[CLOSED]") || message.startsWith("[RE-OPENED]") || message.startsWith("[BANNED]") || message.startsWith("[FLAGGED]") || message.startsWith("[RESTORED]");

                    if (isSystem && !isAdminUser) return;

                    const div = document.createElement("div");
                    if (isSystem) {
                        div.className = "msg-system";
                        if (message.includes("[BANNED]") || message.includes("[FLAGGED]")) {
                            div.style.color = "#ef4444";
                            div.style.borderColor = "#ef4444";
                        } else if (message.includes("[RESTORED]")) {
                            div.style.color = "#10b981";
                            div.style.borderColor = "#10b981";
                        }
                    } else {
                        div.className = `msg-bubble ${isAdmin ? 'msg-admin' : 'msg-user'}`;
                    }

                    div.textContent = message;
                    chatBox.appendChild(div);
                    chatBox.scrollTop = chatBox.scrollHeight;
                });

                connection.start().then(() => connection.invoke("JoinTicketGroup", ticketId)).catch(console.error);

                const transmit = () => {
                    const msg = messageInput.value.trim();
                    if (msg) {
                        connection.invoke("SendMessage", parseInt(ticketId), msg).catch(console.error);
                        messageInput.value = "";
                    }
                };

                sendBtn?.addEventListener("click", transmit);
                messageInput?.addEventListener("keypress", (e) => { if (e.key === "Enter") transmit(); });
            </text>
        }
    </script>
}