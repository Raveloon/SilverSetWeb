@model List<SilverSet.Models.Entities.Asset>
@{
    ViewData["Title"] = "Home";
    bool isCarousel = Model.Count > 3;
}

<style>
    .hero-section {
        min-height: 100vh;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

    .hero-grid {
        position: absolute;
        inset: 0;
        background-image: linear-gradient(rgba(200,200,200,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(200,200,200,0.03) 1px, transparent 1px);
        background-size: 60px 60px;
        animation: gridMove 20s linear infinite;
        z-index: 0;
    }

    @@keyframes gridMove {
        0% {
            transform: translateY(0);
        }

        100% {
            transform: translateY(60px);
        }
    }

    .hero-glow {
        position: absolute;
        top: -200px;
        left: 50%;
        transform: translateX(-50%);
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(200,200,200,0.06) 0%, transparent 70%);
        z-index: 0;
    }

    .hero-content {
        position: relative;
        z-index: 2;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.3rem 0.85rem;
        border: 1px solid rgba(200,200,200,0.15);
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--color-accent-dim);
        margin-bottom: 1.5rem;
    }

        .hero-badge .ping {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #c8c8c8;
            position: relative;
        }

            .hero-badge .ping::before {
                content: '';
                position: absolute;
                inset: -3px;
                border-radius: 50%;
                border: 1px solid rgba(200,200,200,0.4);
                animation: ping 1.5s ease-out infinite;
            }

    @@keyframes ping {
        0% {
            transform: scale(1);
            opacity: 1;
        }

        100% {
            transform: scale(2);
            opacity: 0;
        }
    }

    .hero-title {
        font-size: clamp(2.8rem, 7vw, 6rem);
        font-weight: 900;
        line-height: 1.05;
        letter-spacing: -2px;
        color: var(--color-accent-bright);
        margin-bottom: 1.5rem;
    }

        .hero-title span {
            color: var(--color-accent-dim);
        }

    .hero-subtitle {
        font-size: 1.05rem;
        color: var(--color-text-muted);
        max-width: 480px;
        line-height: 1.7;
        margin-bottom: 2.5rem;
    }

    .btn-hero-primary {
        background: linear-gradient(135deg, var(--color-btn-from), var(--color-btn-to));
        color: #0a0a0a;
        font-weight: 700;
        font-size: 0.85rem;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 0.85rem 2rem;
        border-radius: 8px;
        border: none;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

        .btn-hero-primary:hover {
            box-shadow: 0 0 30px rgba(255,255,255,0.2);
            transform: translateY(-2px);
            color: #0a0a0a;
        }

    .btn-hero-secondary {
        background: transparent;
        color: var(--color-accent-dim);
        font-weight: 600;
        font-size: 0.85rem;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 0.85rem 2rem;
        border-radius: 8px;
        border: 1px solid var(--color-border);
        text-decoration: none;
        transition: all 0.3s ease;
    }

        .btn-hero-secondary:hover {
            border-color: var(--color-accent);
            color: var(--color-accent);
        }

    .tech-cards-wrapper {
        position: relative;
        height: 520px;
        width: 100%;
    }

    .tech-card {
        position: absolute;
        background: rgba(18,18,18,0.85);
        border: 1px solid var(--color-border);
        border-radius: 20px;
        backdrop-filter: blur(12px);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 0.75rem;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .tech-card:hover {
            transform: translateY(-8px) !important;
            box-shadow: 0 0 30px rgba(200,200,200,0.08);
        }

    .tech-card-discord {
        top: 40px;
        left: 80px;
        width: 200px;
        height: 140px;
        animation: float1 4s ease-in-out infinite;
    }

        .tech-card-discord span {
            font-size: 0.75rem;
            color: var(--color-accent-dim);
            letter-spacing: 1px;
        }

    .tech-card-fab {
        bottom: 60px;
        left: 40px;
        width: 260px;
        height: 160px;
        background: linear-gradient(135deg, rgba(80,0,120,0.3), rgba(120,0,80,0.3));
        border-color: rgba(180,0,180,0.15);
        animation: float2 4s ease-in-out infinite;
    }

    .fab-text {
        font-size: 4rem;
        font-weight: 900;
        font-style: italic;
        color: white;
        letter-spacing: -2px;
    }

    .tech-card-unreal {
        top: 45%;
        right: 60px;
        transform: translateY(-50%);
        width: 180px;
        height: 180px;
        border-radius: 50%;
        flex-direction: row;
        gap: 0.5rem;
        animation: float3 4s ease-in-out infinite;
    }

    .unreal-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        border: 2px solid rgba(200,200,200,0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        font-weight: 700;
        color: white;
    }

    .tech-card-unreal span {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 2px;
        color: white;
    }

    .tech-card-unreal small {
        font-size: 0.6rem;
        letter-spacing: 3px;
        color: var(--color-text-muted);
        text-transform: uppercase;
    }

    @@keyframes float1 {
        0%, 100% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-12px);
        }
    }

    @@keyframes float2 {
        0%, 100% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-10px);
        }
    }

    @@keyframes float3 {
        0%, 100% {
            transform: translateY(-50%);
        }

        50% {
            transform: translateY(calc(-50% - 10px));
        }
    }

    .games-section {
        padding: 6rem 0;
        border-top: 1px solid var(--color-border);
    }

    .section-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .section-label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: var(--color-accent-dim);
    }

    .section-title {
        font-size: clamp(1.8rem, 4vw, 3rem);
        font-weight: 900;
        color: var(--color-accent-bright);
        margin: 0.5rem 0;
        letter-spacing: -1px;
    }

    .section-subtitle {
        color: var(--color-text-muted);
        font-size: 0.95rem;
    }

    .games-carousel-container {
        position: relative;
        width: 100%;
        padding: 0 3rem;
    }

    .games-carousel {
        display: flex;
        gap: 1.5rem;
        overflow-x: auto;
        scroll-behavior: smooth;
        scroll-snap-type: x mandatory;
        padding-bottom: 2rem;
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .games-grid {
        display: flex;
        gap: 1.5rem;
        justify-content: center;
        flex-wrap: wrap;
        width: 100%;
    }

    .games-carousel::-webkit-scrollbar {
        display: none;
    }

    .carousel-nav-btn {
        width: 48px;
        height: 48px;
        background: rgba(18, 18, 18, 0.9);
        border: 1px solid rgba(200, 200, 200, 0.2);
        color: var(--color-accent-bright);
        transition: all 0.3s ease;
        backdrop-filter: blur(8px);
        padding: 0;
    }

        .carousel-nav-btn:hover {
            background: rgba(200, 200, 200, 0.1);
            border-color: rgba(200, 200, 200, 0.4);
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.1);
            transform: scale(1.1);
        }

    .game-card-wrapper {
        flex: 0 0 calc(33.333% - 1rem);
        scroll-snap-align: start;
        display: flex;
        flex-direction: column;
    }

    .game-card {
        background: var(--color-bg-card);
        border: 1px solid var(--color-border);
        border-radius: 16px;
        overflow: hidden;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

        .game-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 0 30px var(--color-glow);
            border-color: rgba(200,200,200,0.25);
        }

    .game-card-img {
        width: 100%;
        height: 200px;
        overflow: hidden;
        flex-shrink: 0;
    }

        .game-card-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            image-rendering: high-quality;
            image-rendering: -webkit-optimize-contrast;
            transition: transform 0.4s ease;
        }

    .game-card:hover .game-card-img img {
        transform: scale(1.01);
    }

    .game-card-img-placeholder {
        background: rgba(200,200,200,0.04);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-text-muted);
    }

    .game-card-body {
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .game-card-meta {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 0.75rem;
    }

    .game-tag {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--color-accent-dim);
        border: 1px solid var(--color-border);
        padding: 0.2rem 0.6rem;
        border-radius: 4px;
    }

    .game-status {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #86efac;
        border: 1px solid rgba(134,239,172,0.2);
        padding: 0.2rem 0.6rem;
        border-radius: 4px;
    }

    .game-card-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--color-accent-bright);
        margin-bottom: 0.5rem;
    }

    .game-card-desc {
        font-size: 0.85rem;
        color: var(--color-text-muted);
        line-height: 1.6;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    @@media (max-width: 1200px) {
        .tech-card-discord {
            top: 20px;
            left: 40px;
            width: 170px;
            height: 120px;
        }

        .tech-card-fab {
            bottom: 40px;
            left: 20px;
            width: 220px;
            height: 140px;
        }

        .tech-card-unreal {
            top: 45%;
            right: 20px;
            width: 150px;
            height: 150px;
        }

        .unreal-icon {
            width: 44px;
            height: 44px;
            font-size: 1.4rem;
        }

        .fab-text {
            font-size: 3rem;
        }
    }

    @@media (max-width: 991px) {
        .hero-section {
            padding-top: 2rem;
            padding-bottom: 5rem;
        }

        .hero-title {
            letter-spacing: -1px;
        }

        .game-card-wrapper {
            flex: 0 0 calc(50% - 0.75rem);
        }
    }

    @@media (max-width: 768px) {
        .game-card-wrapper {
            flex: 0 0 100%;
        }

        .games-carousel-container {
            padding: 0 2.5rem;
        }

        .carousel-nav-btn {
            width: 36px;
            height: 36px;
        }
    }
</style>

<section class="hero-section">
    <div class="hero-grid"></div>
    <div class="hero-glow"></div>

    <div class="container hero-content">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="hero-badge">
                    <span class="ping"></span>
                    Next Generation Digital Craft
                </div>
                <h1 class="hero-title">
                    Crafting<br />
                    <span>Digital</span><br />
                    Worlds
                </h1>
                <p class="hero-subtitle">
                    We push the boundaries of digital artistry. Experience the future of gaming with cutting-edge technology and immersive gameplay.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Assets" asp-action="Index" class="btn-hero-primary">
                        Explore Assets
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M5 12h14M12 5l7 7-7 7" />
                        </svg>
                    </a>
                    <a asp-controller="Forum" asp-action="index" class="btn-hero-secondary">
                        Join Community
                    </a>
                </div>
            </div>

            <div class="col-lg-6 d-none d-lg-block">
                <div class="tech-cards-wrapper">
                    <div class="tech-card tech-card-discord">
                        <svg width="36" height="36" viewBox="0 0 24 24" fill="#c8c8c8">
                            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057.101 18.08.114 18.1.132 18.11a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z" />
                        </svg>
                        <span>Community Hub</span>
                    </div>
                    <div class="tech-card tech-card-fab">
                        <span class="fab-text">FAB</span>
                    </div>
                    <div class="tech-card tech-card-unreal">
                        <div class="unreal-icon">U</div>
                        <div>
                            <span class="d-block">UNREAL</span>
                            <small>Engine</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@if (Model.Any())
{
    <section class="games-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Our Projects</h2>
                <p class="section-subtitle">Explore the worlds we are building</p>
            </div>

            <div class="games-carousel-container position-relative">
                @if (isCarousel)
                {
                    <button class="btn rounded-circle position-absolute top-50 start-0 translate-middle-y d-flex align-items-center justify-content-center z-3 carousel-nav-btn shadow" id="btnScrollLeft">
                        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                        </svg>
                    </button>
                    <button class="btn rounded-circle position-absolute top-50 end-0 translate-middle-y d-flex align-items-center justify-content-center z-3 carousel-nav-btn shadow" id="btnScrollRight">
                        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                        </svg>
                    </button>
                }

                <div class="@(isCarousel ? "games-carousel" : "games-grid")" id="@(isCarousel ? "projectCarousel" : "")">
                    @foreach (var game in Model)
                    {
                        <div class="game-card-wrapper">
                            @if (!string.IsNullOrEmpty(game.ExternalLink))
                            {
                                <a href="@game.ExternalLink" target="_blank" rel="noopener noreferrer" class="game-card" style="text-decoration:none;">
                                    @if (!string.IsNullOrEmpty(game.ImagePath))
                                    {
                                        <div class="game-card-img">
                                            <img src="@game.ImagePath" alt="@game.Title" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="game-card-img game-card-img-placeholder">
                                            <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
                                                <rect x="3" y="3" width="18" height="18" rx="2" />
                                                <circle cx="8.5" cy="8.5" r="1.5" />
                                                <path d="M21 15l-5-5L5 21" />
                                            </svg>
                                        </div>
                                    }
                                    <div class="game-card-body">
                                        <div class="game-card-meta">
                                            @if (!string.IsNullOrEmpty(game.Genre))
                                            {
                                                <span class="game-tag">@game.Genre</span>
                                            }
                                            @if (!string.IsNullOrEmpty(game.Status))
                                            {
                                                <span class="game-status">@game.Status</span>
                                            }
                                        </div>
                                        <h3 class="game-card-title">@game.Title</h3>
                                        @if (!string.IsNullOrEmpty(game.Description))
                                        {
                                            <p class="game-card-desc">@game.Description</p>
                                        }
                                    </div>
                                </a>
                            }
                            else
                            {
                                <div class="game-card">
                                    @if (!string.IsNullOrEmpty(game.ImagePath))
                                    {
                                        <div class="game-card-img">
                                            <img src="@game.ImagePath" alt="@game.Title" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="game-card-img game-card-img-placeholder">
                                            <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
                                                <rect x="3" y="3" width="18" height="18" rx="2" />
                                                <circle cx="8.5" cy="8.5" r="1.5" />
                                                <path d="M21 15l-5-5L5 21" />
                                            </svg>
                                        </div>
                                    }
                                    <div class="game-card-body">
                                        <div class="game-card-meta">
                                            @if (!string.IsNullOrEmpty(game.Genre))
                                            {
                                                <span class="game-tag">@game.Genre</span>
                                            }
                                            @if (!string.IsNullOrEmpty(game.Status))
                                            {
                                                <span class="game-status">@game.Status</span>
                                            }
                                        </div>
                                        <h3 class="game-card-title">@game.Title</h3>
                                        @if (!string.IsNullOrEmpty(game.Description))
                                        {
                                            <p class="game-card-desc">@game.Description</p>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
}

@if (isCarousel)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const carousel = document.getElementById('projectCarousel');
            const btnLeft = document.getElementById('btnScrollLeft');
            const btnRight = document.getElementById('btnScrollRight');

            if (!carousel) return;

            let isHovered = false;

            carousel.addEventListener('mouseenter', () => isHovered = true);
            carousel.addEventListener('mouseleave', () => isHovered = false);
            carousel.addEventListener('touchstart', () => isHovered = true);
            carousel.addEventListener('touchend', () => {
                setTimeout(() => isHovered = false, 2000);
            });

            if (btnLeft && btnRight) {
                btnLeft.addEventListener('mouseenter', () => isHovered = true);
                btnLeft.addEventListener('mouseleave', () => isHovered = false);
                btnRight.addEventListener('mouseenter', () => isHovered = true);
                btnRight.addEventListener('mouseleave', () => isHovered = false);

                btnLeft.addEventListener('click', () => {
                    const firstCard = carousel.querySelector('.game-card-wrapper');
                    if (!firstCard) return;
                    const itemWidth = firstCard.offsetWidth + 24;
                    carousel.scrollBy({ left: -itemWidth, behavior: 'smooth' });
                });

                btnRight.addEventListener('click', () => {
                    const firstCard = carousel.querySelector('.game-card-wrapper');
                    if (!firstCard) return;
                    const itemWidth = firstCard.offsetWidth + 24;
                    carousel.scrollBy({ left: itemWidth, behavior: 'smooth' });
                });
            }

            setInterval(() => {
                if (isHovered) return;

                const firstCard = carousel.querySelector('.game-card-wrapper');
                if (!firstCard) return;

                const scrollWidth = carousel.scrollWidth;
                const clientWidth = carousel.clientWidth;
                const maxScroll = scrollWidth - clientWidth;

                const itemWidth = firstCard.offsetWidth + 24;

                if (carousel.scrollLeft >= maxScroll - 10) {
                    carousel.scrollTo({ left: 0, behavior: 'smooth' });
                } else {
                    carousel.scrollBy({ left: itemWidth, behavior: 'smooth' });
                }
            }, 5000);
        });
    </script>
}