<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SilverSet Studios</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* ── GENEL ── */
        body {
            background-color: var(--color-bg);
            color: var(--color-text);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        main {
            flex: 1;
        }

        /* ── NAVBAR ── */
        .ss-navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            background-color: rgba(10, 10, 10, 0.92);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--color-border);
            padding: 0.6rem 0;
            transition: background-color 0.3s ease;
        }

            .ss-navbar .navbar-brand img {
                height: 48px;
                width: auto;
                object-fit: contain;
            }

            .ss-navbar .nav-link {
                color: var(--color-accent-dim) !important;
                font-size: 0.82rem;
                font-weight: 600;
                letter-spacing: 1px;
                text-transform: uppercase;
                padding: 0.4rem 0.85rem !important;
                transition: color 0.2s ease;
                position: relative;
            }

                .ss-navbar .nav-link::after {
                    content: '';
                    position: absolute;
                    bottom: -2px;
                    left: 50%;
                    transform: translateX(-50%);
                    width: 0;
                    height: 1px;
                    background-color: var(--color-accent);
                    transition: width 0.3s ease;
                }

                .ss-navbar .nav-link:hover,
                .ss-navbar .nav-link.active {
                    color: var(--color-accent) !important;
                }

                    .ss-navbar .nav-link:hover::after,
                    .ss-navbar .nav-link.active::after {
                        width: 70%;
                    }

        /* Giriş / Kayıt butonları */
        .btn-nav-login {
            background: transparent;
            border: 1px solid var(--color-border);
            color: var(--color-accent-dim) !important;
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            padding: 0.35rem 1rem;
            border-radius: 6px;
            transition: all 0.2s ease;
            text-decoration: none;
        }

            .btn-nav-login:hover {
                border-color: var(--color-accent);
                color: var(--color-accent) !important;
            }

        .btn-nav-register {
            background: linear-gradient(135deg, var(--color-btn-from), var(--color-btn-to));
            border: none;
            color: #0a0a0a !important;
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            padding: 0.35rem 1rem;
            border-radius: 6px;
            transition: all 0.2s ease;
            text-decoration: none;
        }

            .btn-nav-register:hover {
                box-shadow: 0 0 15px var(--color-glow-strong);
                transform: translateY(-1px);
                color: #0a0a0a !important;
            }

        /* Kullanıcı dropdown */
        .ss-user-btn {
            background: transparent;
            border: 1px solid var(--color-border);
            color: var(--color-accent) !important;
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            padding: 0.35rem 1rem;
            border-radius: 6px;
            transition: all 0.2s ease;
        }

            .ss-user-btn:hover {
                border-color: var(--color-accent);
                background-color: rgba(200,200,200,0.05);
            }

        .ss-dropdown-menu {
            background-color: rgba(18, 18, 18, 0.97);
            border: 1px solid var(--color-border);
            border-radius: 8px;
            min-width: 160px;
            backdrop-filter: blur(10px);
        }

            .ss-dropdown-menu .dropdown-item {
                color: var(--color-accent-dim);
                font-size: 0.82rem;
                font-weight: 500;
                letter-spacing: 0.5px;
                padding: 0.5rem 1rem;
                transition: all 0.2s ease;
            }

                .ss-dropdown-menu .dropdown-item:hover {
                    background-color: rgba(200,200,200,0.06);
                    color: var(--color-accent);
                }

            .ss-dropdown-menu .dropdown-divider {
                border-color: var(--color-border);
            }

        /* Hamburger (mobil) */
        .navbar-toggler {
            border: 1px solid var(--color-border);
            padding: 0.3rem 0.6rem;
        }

        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba(200,200,200,0.7)' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }

        /* Navbar collapse mobilde */
        @@media (max-width: 991px) {
            .ss-navbar .navbar-collapse

        {
            background-color: rgba(10, 10, 10, 0.98);
            border-top: 1px solid var(--color-border);
            margin-top: 0.5rem;
            padding: 1rem;
            border-radius: 0 0 12px 12px;
        }

        .ss-navbar .nav-link {
            padding: 0.6rem 0.5rem !important;
            border-bottom: 1px solid var(--color-border);
        }

            .ss-navbar .nav-link:last-of-type {
                border-bottom: none;
            }

        .ss-nav-actions {
            margin-top: 0.75rem;
            display: flex;
            gap: 0.5rem;
        }

        }

        /* ── İÇERİK ALANI ── */
        .ss-content {
            margin-top: 72px; /* navbar yüksekliği kadar boşluk */
        }

        /* ── FOOTER ── */
        .ss-footer {
            background-color: rgba(8, 8, 8, 0.98);
            border-top: 1px solid var(--color-border);
            padding: 2.5rem 0 1.5rem;
            margin-top: auto;
        }

            .ss-footer .footer-logo img {
                height: 40px;
                opacity: 0.85;
            }

            .ss-footer .footer-tagline {
                color: var(--color-text-muted);
                font-size: 0.78rem;
                letter-spacing: 1px;
                margin-top: 0.4rem;
            }

            .ss-footer .footer-heading {
                color: var(--color-accent);
                font-size: 0.72rem;
                font-weight: 700;
                letter-spacing: 2px;
                text-transform: uppercase;
                margin-bottom: 0.85rem;
            }

            .ss-footer .footer-link {
                display: block;
                color: var(--color-accent-dim);
                text-decoration: none;
                font-size: 0.82rem;
                padding: 0.2rem 0;
                transition: color 0.2s ease;
            }

                .ss-footer .footer-link:hover {
                    color: var(--color-accent);
                }

            /* Sosyal medya ikonları */
            .ss-footer .social-links {
                display: flex;
                gap: 0.75rem;
                flex-wrap: wrap;
            }

            .ss-footer .social-btn {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 38px;
                height: 38px;
                border: 1px solid var(--color-border);
                border-radius: 8px;
                background: transparent;
                transition: all 0.2s ease;
                text-decoration: none;
            }

                .ss-footer .social-btn:hover {
                    border-color: var(--color-accent);
                    background-color: rgba(200,200,200,0.06);
                    transform: translateY(-2px);
                }

                .ss-footer .social-btn svg {
                    width: 18px;
                    height: 18px;
                    fill: var(--color-accent-dim);
                    transition: fill 0.2s ease;
                }

                .ss-footer .social-btn:hover svg {
                    fill: var(--color-accent);
                }

            .ss-footer .footer-bottom {
                border-top: 1px solid var(--color-border);
                margin-top: 2rem;
                padding-top: 1rem;
                color: var(--color-text-muted);
                font-size: 0.75rem;
            }
    </style>
</head>
<body>

    <!-- ── NAVBAR ── -->
    <nav class="ss-navbar">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between w-100">

                <!-- Logo -->
                <a class="navbar-brand p-0" asp-controller="Home" asp-action="Index">
                    <img src="~/images/silversetLogo.jpg" alt="SilverSet Studios" />
                </a>

                <!-- Hamburger (mobil) -->
                <button class="navbar-toggler d-lg-none" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navMenu"
                        aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Menü -->
                <div class="collapse navbar-collapse d-lg-flex align-items-center justify-content-between" id="navMenu">

                    <!-- Orta linkler -->
                    <ul class="navbar-nav mx-auto d-flex flex-row gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Games">Games</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="FabProject">FAB Project</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Community">Community</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>
                    </ul>

                    <!-- Sağ taraf: giriş/kayıt veya kullanıcı -->
                    <div class="ss-nav-actions d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <!-- Giriş yapılmış -->
                            <div class="dropdown">
                                <button class="ss-user-btn dropdown-toggle" type="button"
                                        data-bs-toggle="dropdown" aria-expanded="false">
                                    @User.Identity.Name
                                </button>
                                <ul class="dropdown-menu ss-dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                            Profile
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                            Logout
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <!-- Giriş yapılmamış -->
                            <a asp-controller="Account" asp-action="Login" class="btn-nav-login">Login</a>
                            <a asp-controller="Account" asp-action="Register" class="btn-nav-register">Register</a>
                        }
                    </div>

                </div>
            </div>
        </div>
    </nav>

    <!-- ── İÇERİK ── -->
    <div class="ss-content">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- ── FOOTER ── -->
    <footer class="ss-footer">
        <div class="container">
            <div class="row gy-4">

                <!-- Sol: Logo + tagline -->
                <div class="col-12 col-md-4">
                    <div class="footer-logo">
                        <img src="~/images/silversetLogo.jpg" alt="SilverSet Studios" />
                    </div>
                    <p class="footer-tagline">Crafting worlds. Building experiences.</p>
                </div>

                <!-- Orta: Hızlı linkler -->
                <div class="col-6 col-md-2 offset-md-1">
                    <p class="footer-heading">Navigate</p>
                    <a asp-controller="Home" asp-action="Index" class="footer-link">Home</a>
                    <a asp-controller="Home" asp-action="Games" class="footer-link">Games</a>
                    <a asp-controller="Home" asp-action="FabProject" class="footer-link">FAB Project</a>
                    <a asp-controller="Home" asp-action="Community" class="footer-link">Community</a>
                    <a asp-controller="Home" asp-action="About" class="footer-link">About</a>
                    <a asp-controller="Home" asp-action="Contact" class="footer-link">Contact</a>
                </div>

                <!-- Sağ: Sosyal medya -->
                <div class="col-6 col-md-3 offset-md-1">
                    <p class="footer-heading">Find Us</p>
                    <div class="social-links">

                        <!-- Discord -->
                        <a href="#" target="_blank" class="social-btn" title="Discord">
                            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057.101 18.08.114 18.1.132 18.11a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z" />
                            </svg>
                        </a>

                        <!-- Reddit -->
                        <a href="#" target="_blank" class="social-btn" title="Reddit">
                            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z" />
                            </svg>
                        </a>

                        <!-- LinkedIn -->
                        <a href="#" target="_blank" class="social-btn" title="LinkedIn">
                            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                            </svg>
                        </a>

                    </div>
                </div>

            </div>

            <!-- Alt copyright -->
            <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <span>&copy; @DateTime.Now.Year SilverSet Studios. All rights reserved.</span>
                <span>Made with passion for gaming</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
