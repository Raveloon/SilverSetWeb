<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SilverSet Studios</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            background-color: var(--color-bg);
            color: var(--color-text);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        main {
            flex: 1;
        }

        .ss-navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            background-color: rgba(10, 10, 10, 0.92);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--color-border);
            padding: 0.6rem 0;
        }

            .ss-navbar .navbar-brand img {
                height: 48px;
                width: auto;
                object-fit: contain;
            }

            .ss-navbar .nav-link {
                color: var(--color-accent-dim) !important;
                font-size: 0.82rem;
                font-weight: 600;
                letter-spacing: 1px;
                text-transform: uppercase;
                padding: 0.4rem 0.85rem !important;
                transition: color 0.2s ease;
                position: relative;
            }

                .ss-navbar .nav-link::after {
                    content: '';
                    position: absolute;
                    bottom: -2px;
                    left: 50%;
                    transform: translateX(-50%);
                    width: 0;
                    height: 1px;
                    background-color: var(--color-accent);
                    transition: width 0.3s ease;
                }

                .ss-navbar .nav-link:hover,
                .ss-navbar .nav-link.active {
                    color: var(--color-accent) !important;
                }

                    .ss-navbar .nav-link:hover::after,
                    .ss-navbar .nav-link.active::after {
                        width: 70%;
                    }

        .btn-nav-login {
            background: transparent;
            border: 1px solid var(--color-border);
            color: var(--color-accent-dim) !important;
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            padding: 0.35rem 1rem;
            border-radius: 6px;
            transition: all 0.2s ease;
            text-decoration: none;
        }

            .btn-nav-login:hover {
                border-color: var(--color-accent);
                color: var(--color-accent) !important;
            }

        .btn-nav-register {
            background: linear-gradient(135deg, var(--color-btn-from), var(--color-btn-to));
            border: none;
            color: #0a0a0a !important;
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            padding: 0.35rem 1rem;
            border-radius: 6px;
            transition: all 0.2s ease;
            text-decoration: none;
        }

            .btn-nav-register:hover {
                box-shadow: 0 0 15px var(--color-glow-strong);
                transform: translateY(-1px);
                color: #0a0a0a !important;
            }

        .ss-user-btn {
            background: transparent;
            border: 1px solid var(--color-border);
            color: var(--color-accent) !important;
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            padding: 0.35rem 1rem;
            border-radius: 6px;
            transition: all 0.2s ease;
        }

            .ss-user-btn:hover {
                border-color: var(--color-accent);
                background-color: rgba(200,200,200,0.05);
            }

        .ss-dropdown-menu {
            background-color: rgba(18, 18, 18, 0.97);
            border: 1px solid var(--color-border);
            border-radius: 8px;
            min-width: 180px;
            backdrop-filter: blur(10px);
        }

            .ss-dropdown-menu .dropdown-item {
                color: var(--color-accent-dim);
                font-size: 0.82rem;
                font-weight: 500;
                letter-spacing: 0.5px;
                padding: 0.55rem 1rem;
                transition: all 0.2s ease;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

                .ss-dropdown-menu .dropdown-item:hover {
                    background-color: rgba(200,200,200,0.06);
                    color: var(--color-accent);
                }

                .ss-dropdown-menu .dropdown-item svg {
                    width: 14px;
                    height: 14px;
                    flex-shrink: 0;
                }

            .ss-dropdown-menu .dropdown-divider {
                border-color: var(--color-border);
                margin: 0.25rem 0;
            }

            .ss-dropdown-menu .logout-form {
                margin: 0;
                padding: 0;
            }

            .ss-dropdown-menu .btn-logout {
                width: 100%;
                background: transparent;
                border: none;
                color: #f87171;
                font-size: 0.82rem;
                font-weight: 500;
                letter-spacing: 0.5px;
                padding: 0.55rem 1rem;
                text-align: left;
                transition: all 0.2s ease;
                display: flex;
                align-items: center;
                gap: 0.5rem;
                cursor: pointer;
            }

                .ss-dropdown-menu .btn-logout:hover {
                    background-color: rgba(248,113,113,0.08);
                    color: #fca5a5;
                }

                .ss-dropdown-menu .btn-logout svg {
                    width: 14px;
                    height: 14px;
                    flex-shrink: 0;
                }

        .navbar-toggler {
            border: 1px solid var(--color-border);
            padding: 0.3rem 0.6rem;
        }

        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba(200,200,200,0.7)' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }

        @@media (max-width: 991px) {
            .ss-navbar .navbar-collapse {
                background-color: rgba(10, 10, 10, 0.98);
                border-top: 1px solid var(--color-border);
                margin-top: 0.5rem;
                padding: 1rem;
                border-radius: 0 0 12px 12px;
            }

            .ss-navbar .nav-link {
                padding: 0.6rem 0.5rem !important;
                border-bottom: 1px solid var(--color-border);
            }

            .ss-nav-actions {
                margin-top: 0.75rem;
                display: flex;
                gap: 0.5rem;
            }

            .ss-nav-actions {
                border-top: 1px solid var(--color-border);
                padding-top: 0.75rem;
                margin-top: 0.25rem;
            }
        }

        .ss-content {
            margin-top: 72px;
        }

        .ss-footer {
            background-color: rgba(8, 8, 8, 0.98);
            border-top: 1px solid var(--color-border);
            padding: 2.5rem 0 1.5rem;
            margin-top: auto;
        }

            .ss-footer .footer-logo img {
                height: 40px;
                opacity: 0.85;
            }

            .ss-footer .footer-tagline {
                color: var(--color-text-muted);
                font-size: 0.78rem;
                letter-spacing: 1px;
                margin-top: 0.4rem;
            }

            .ss-footer .footer-heading {
                color: var(--color-accent);
                font-size: 0.72rem;
                font-weight: 700;
                letter-spacing: 2px;
                text-transform: uppercase;
                margin-bottom: 0.85rem;
            }

            .ss-footer .footer-link {
                display: block;
                color: var(--color-accent-dim);
                text-decoration: none;
                font-size: 0.82rem;
                padding: 0.2rem 0;
                transition: color 0.2s ease;
            }

                .ss-footer .footer-link:hover {
                    color: var(--color-accent);
                }

            .ss-footer .social-links {
                display: flex;
                gap: 0.75rem;
                flex-wrap: wrap;
            }

            .ss-footer .social-btn {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 38px;
                height: 38px;
                border: 1px solid var(--color-border);
                border-radius: 8px;
                background: transparent;
                transition: all 0.2s ease;
                text-decoration: none;
            }

                .ss-footer .social-btn:hover {
                    border-color: var(--color-accent);
                    background-color: rgba(200,200,200,0.06);
                    transform: translateY(-2px);
                }

                .ss-footer .social-btn svg {
                    width: 18px;
                    height: 18px;
                    fill: var(--color-accent-dim);
                    transition: fill 0.2s ease;
                }

                .ss-footer .social-btn:hover svg {
                    fill: var(--color-accent);
                }

            .ss-footer .footer-bottom {
                border-top: 1px solid var(--color-border);
                margin-top: 2rem;
                padding-top: 1rem;
                color: var(--color-text-muted);
                font-size: 0.75rem;
            }
    </style>
</head>
<body>

    <nav class="ss-navbar">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between w-100">

                <a class="navbar-brand p-0" asp-controller="Home" asp-action="Index">
                    <img src="~/images/silversetLogo.jpg" alt="SilverSet Studios" />
                </a>

                <button class="navbar-toggler d-lg-none" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navMenu"
                        aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse d-lg-flex align-items-center justify-content-between" id="navMenu">

                    <ul class="navbar-nav mx-auto d-flex flex-lg-row flex-column gap-1">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Games">Games</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="FabProject">FAB Project</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Community">Community</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>
                    </ul>

                    <div class="ss-nav-actions d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown">
                                <button class="ss-user-btn dropdown-toggle" type="button"
                                        data-bs-toggle="dropdown" aria-expanded="false">
                                    @User.Identity.Name
                                </button>
                                <ul class="dropdown-menu ss-dropdown-menu dropdown-menu-end">

                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                            <svg fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                                <circle cx="12" cy="7" r="4" />
                                            </svg>
                                            Profile
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Settings">
                                            <svg fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                                <circle cx="12" cy="12" r="3" />
                                                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                                            </svg>
                                            Settings
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider" /></li>

                                    <li>
                                        <form class="logout-form" asp-controller="Account" asp-action="Logout" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-logout">
                                                <svg fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                                                    <polyline points="16 17 21 12 16 7" />
                                                    <line x1="21" y1="12" x2="9" y2="12" />
                                                </svg>
                                                Logout
                                            </button>
                                        </form>
                                    </li>

                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn-nav-login">Login</a>
                            <a asp-controller="Account" asp-action="Register" class="btn-nav-register">Register</a>
                        }
                    </div>

                </div>
            </div>
        </div>
    </nav>

    <div class="ss-content">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="ss-footer">
        <div class="container">
            <div class="row gy-4">

                <div class="col-12 col-md-4">
                    <div class="footer-logo">
                        <img src="~/images/silversetLogo.jpg" alt="SilverSet Studios" />
                    </div>
                    <p class="footer-tagline">Crafting worlds. Building experiences.</p>
                </div>

                <div class="col-6 col-md-2 offset-md-1">
                    <p class="footer-heading">Navigate</p>
                    <a asp-controller="Home" asp-action="Index" class="footer-link">Home</a>
                    <a asp-controller="Home" asp-action="Games" class="footer-link">Games</a>
                    <a asp-controller="Home" asp-action="FabProject" class="footer-link">FAB Project</a>
                    <a asp-controller="Home" asp-action="Community" class="footer-link">Community</a>
                    <a asp-controller="Home" asp-action="About" class="footer-link">About</a>
                    <a asp-controller="Home" asp-action="Contact" class="footer-link">Contact</a>
                </div>

                <div class="col-6 col-md-3 offset-md-1">
                    <p class="footer-heading">Find Us</p>
                    <div class="social-links">
                        <a href="https://discord.gg/q3AYu8f5MJ" target="_blank" class="social-btn" title="Discord">
                            <svg viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057.101 18.08.114 18.1.132 18.11a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z" /></svg>
                        </a>
                        <a href="https://www.instagram.com/silversetstudios" target="_blank" class="social-btn" title="Instagram">
                            <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z" /></svg>
                        </a>
                        <a href="https://www.linkedin.com/company/silversetstudios/" target="_blank" class="social-btn" title="LinkedIn">
                            <svg viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
                        </a>
                    </div>
                </div>

            </div>

            <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <span>&copy; @DateTime.Now.Year SilverSet Studios. All rights reserved.</span>
                <span>Made with passion for gaming</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
