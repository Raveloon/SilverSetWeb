@model SilverSet.Models.ViewModels.ForgotPasswordViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SilverSet Studios</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <style>
        body {
            background-color: var(--color-bg);
            color: var(--color-text);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            overflow: hidden;
            background-image: radial-gradient(circle at 20% 40%, var(--color-glow) 0%, transparent 25%), radial-gradient(circle at 80% 60%, var(--color-glow) 0%, transparent 25%);
            background-attachment: fixed;
        }

        .terminal-card {
            background-color: var(--color-bg-card);
            border: 1px solid var(--color-border);
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.7), 0 0 0 1px rgba(255,255,255,0.04) inset;
            width: 100%;
            max-width: 460px;
            backdrop-filter: blur(10px);
        }

        .terminal-input {
            background-color: var(--color-bg-input);
            border: 1px solid var(--color-border);
            color: var(--color-text);
            padding: 0.75rem 1rem;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

            .terminal-input:focus {
                background-color: var(--color-bg-input);
                border-color: var(--color-accent);
                box-shadow: 0 0 12px var(--color-glow);
                color: var(--color-text);
            }

            .terminal-input::placeholder {
                color: var(--color-text-muted);
            }

        .btn-silver {
            background: linear-gradient(135deg, var(--color-btn-from) 0%, var(--color-btn-to) 100%);
            color: #0a0a0a;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            border: none;
            border-radius: 10px;
            transition: all 0.3s ease;
        }

            .btn-silver:hover {
                box-shadow: 0 0 25px var(--color-glow-strong);
                transform: translateY(-2px);
                color: #0a0a0a;
            }

        .form-label {
            font-size: 0.8rem;
            letter-spacing: 0.5px;
            opacity: 0.9;
        }

        .divider-line {
            border-color: var(--color-border) !important;
        }
    </style>
</head>
<body class="position-relative min-vh-100 d-flex flex-column align-items-center justify-content-center">

    <div class="position-absolute top-0 start-0 p-4">
        <h5 class="fw-bold mb-0" style="color:var(--color-accent); letter-spacing:1.5px;">SILVERSET STUDIOS</h5>
    </div>

    <div class="card terminal-card p-5">
        <div class="text-center mb-4">
            <h3 class="fw-bold mb-1" style="color:var(--color-accent); letter-spacing:2px;">RESET ACCESS</h3>
            <p class="small fw-medium mb-0" style="color:var(--color-accent-dim); letter-spacing:2px;">
                ENTER YOUR EMAIL
            </p>
        </div>

        <form asp-action="ForgotPassword" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 text-center"></div>

            <input type="text" name="TerminalAccessCode" style="display:none !important; position:absolute; left:-9999px;" tabindex="-1" autocomplete="off" />

            <div class="mb-4">
                <label asp-for="Email" class="form-label fw-medium" style="color:var(--color-accent);">EMAIL</label>
                <input asp-for="Email" class="form-control terminal-input" placeholder="your@email.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-4 d-flex justify-content-center">
                <div class="cf-turnstile" data-sitekey="@Configuration["CloudflareTurnstile:SiteKey"]" data-theme="dark"></div>
            </div>

            <button type="submit" class="btn btn-silver w-100 py-3">SEND RESET LINK</button>

            <div class="text-center border-top divider-line pt-4 mt-4">
                <a asp-action="Login" asp-controller="Account" class="text-decoration-none small" style="color:var(--color-accent-dim);">
                    Back to Login
                </a>
            </div>
        </form>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
</body>
</html>