@model SilverSet.Models.ViewModels.RegisterViewModel
@inject IConfiguration Configuration

@{
    ViewData["Title"] = "Create Account";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SilverSet Studios</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

    <style>
        body {
            background-color: var(--color-bg);
            color: var(--color-text);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            background-image: radial-gradient(circle at 20% 40%, var(--color-glow) 0%, transparent 25%), radial-gradient(circle at 80% 60%, var(--color-glow) 0%, transparent 25%);
            background-attachment: fixed;
        }

        .terminal-card {
            background-color: var(--color-bg-card);
            border: 1px solid var(--color-border);
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.7), 0 0 0 1px rgba(255,255,255,0.04) inset;
            width: 100%;
            max-width: 480px;
            backdrop-filter: blur(10px);
            transition: transform 0.3s ease;
        }

            .terminal-card:hover {
                transform: translateY(-3px);
            }

        .terminal-input {
            background-color: var(--color-bg-input);
            border: 1px solid var(--color-border);
            color: var(--color-text);
            padding: 0.75rem 1rem;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

            .terminal-input:focus {
                background-color: var(--color-bg-input);
                border-color: var(--color-accent);
                box-shadow: 0 0 12px var(--color-glow);
                color: var(--color-text);
                outline: none;
            }

            .terminal-input::placeholder {
                color: var(--color-text-muted);
            }

        .password-wrapper {
            position: relative;
            display: flex;
        }

            .password-wrapper .terminal-input {
                border-radius: 8px 0 0 8px;
                border-right: none;
                flex: 1;
            }

                .password-wrapper .terminal-input:focus {
                    border-right: none;
                }

        .btn-eye {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 46px;
            background-color: var(--color-bg-input);
            border: 1px solid var(--color-border);
            border-left: none;
            border-radius: 0 8px 8px 0;
            cursor: pointer;
            transition: background-color 0.2s ease;
            flex-shrink: 0;
        }

            .btn-eye:hover {
                background-color: rgba(200,200,200,0.08);
            }

            .btn-eye svg {
                width: 18px;
                height: 18px;
                fill: none;
                stroke: var(--color-accent-dim);
                stroke-width: 1.8;
                stroke-linecap: round;
                stroke-linejoin: round;
                transition: stroke 0.2s ease;
            }

            .btn-eye:hover svg {
                stroke: var(--color-accent);
            }

        .password-wrapper .terminal-input:focus ~ .btn-eye {
            border-color: var(--color-accent);
        }

        .strength-bar {
            height: 3px;
            border-radius: 2px;
            background: var(--color-border);
            margin-top: 6px;
            overflow: hidden;
        }

        .strength-fill {
            height: 100%;
            width: 0%;
            border-radius: 2px;
            transition: width 0.4s ease, background-color 0.4s ease;
        }

        .strength-text {
            font-size: 0.72rem;
            letter-spacing: 0.5px;
            margin-top: 4px;
            min-height: 1rem;
        }

        .btn-silver {
            background: linear-gradient(135deg, var(--color-btn-from) 0%, var(--color-btn-to) 100%);
            color: #0a0a0a;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            border: none;
            border-radius: 10px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            z-index: 1;
        }

            .btn-silver::after {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: linear-gradient(135deg, #ffffff 0%, #c8c8c8 100%);
                opacity: 0;
                transition: opacity 0.3s ease;
                z-index: -1;
            }

            .btn-silver:hover::after {
                opacity: 1;
            }

            .btn-silver:hover {
                box-shadow: 0 0 25px var(--color-glow-strong);
                transform: translateY(-2px);
                color: #0a0a0a;
            }

        .text-accent {
            color: var(--color-accent);
        }

        .text-accent-dim {
            color: var(--color-accent-dim);
        }

        .text-accent-bright {
            color: var(--color-accent-bright);
        }

        .link-hover:hover {
            color: var(--color-accent-bright) !important;
            transition: color 0.2s ease;
        }

        .form-label {
            font-size: 0.8rem;
            letter-spacing: 0.5px;
            opacity: 0.9;
        }

        .divider-line {
            border-color: var(--color-border) !important;
        }
    </style>
</head>
<body class="d-flex flex-column align-items-center justify-content-center py-5">

    <div class="position-fixed top-0 start-0 p-4 d-flex align-items-center">
        <h5 class="fw-bold mb-0 text-accent" style="letter-spacing: 1.5px;">SILVERSET STUDIOS</h5>
    </div>

    <div class="position-fixed top-0 end-0 p-4">
        <span class="text-accent-dim small">Support</span>
    </div>

    <div class="card terminal-card p-5 my-5">

        <div class="text-center mb-4">
            <h3 class="fw-bold mb-1 text-accent" style="letter-spacing: 2px;">CREATE ACCOUNT</h3>
            <p class="small fw-medium text-accent-dim mb-0" style="letter-spacing: 2.5px; opacity: 0.85;">
                OPERATIVE REGISTRATION
            </p>
        </div>

        <form asp-action="Register" asp-controller="Account" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 text-center"></div>

            <input type="text" name="TerminalAccessCode" aria-label="Security Check" style="display:none !important; position:absolute; left:-9999px;" tabindex="-1" autocomplete="off" />

            <div class="mb-3">
                <label asp-for="UserName" class="form-label text-accent fw-medium">USERNAME</label>
                <input asp-for="UserName"
                       class="form-control terminal-input"
                       placeholder="Choose your handle" />
                <span asp-validation-for="UserName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label text-accent fw-medium">E-MAIL</label>
                <input asp-for="Email"
                       class="form-control terminal-input"
                       placeholder="operative@example.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label for="passwordInput" class="form-label text-accent fw-medium">PASSWORD</label>
                <div class="password-wrapper">
                    <input asp-for="Password"
                           id="passwordInput"
                           class="form-control terminal-input"
                           placeholder="••••••••"
                           type="password"
                           autocomplete="new-password"
                           readonly
                           onfocus="this.removeAttribute('readonly')" />
                    <button type="button" class="btn-eye" onclick="togglePassword('passwordInput', this)" tabindex="-1" aria-label="Toggle password visibility">
                        <svg id="icon-pw-closed" viewBox="0 0 24 24">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                            <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                            <line x1="1" y1="1" x2="23" y2="23" />
                        </svg>
                        <svg id="icon-pw-open" viewBox="0 0 24 24" style="display:none;">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    </button>
                </div>
                <div class="strength-bar">
                    <div class="strength-fill" id="strengthFill"></div>
                </div>
                <div class="strength-text" id="strengthText"></div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label for="confirmInput" class="form-label text-accent fw-medium">CONFIRM PASSWORD</label>
                <div class="password-wrapper">
                    <input asp-for="ConfirmPassword"
                           id="confirmInput"
                           class="form-control terminal-input"
                           placeholder="••••••••"
                           type="password"
                           autocomplete="new-password"
                           readonly
                           onfocus="this.removeAttribute('readonly')" />
                    <button type="button" class="btn-eye" onclick="togglePassword('confirmInput', this)" tabindex="-1" aria-label="Toggle password visibility">
                        <svg id="icon-cf-closed" viewBox="0 0 24 24">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                            <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                            <line x1="1" y1="1" x2="23" y2="23" />
                        </svg>
                        <svg id="icon-cf-open" viewBox="0 0 24 24" style="display:none;">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4 d-flex justify-content-center">
                <div class="cf-turnstile" data-sitekey="@Configuration["CloudflareTurnstile:SiteKey"]" data-theme="dark"></div>
            </div>

            <button type="submit" class="btn btn-silver w-100 py-3">INITIALIZE REGISTRATION</button>

            <div class="text-center border-top divider-line pt-4 mt-4">
                <span class="text-accent-dim small">Already an operative? </span>
                <a asp-action="Login" asp-controller="Account"
                   class="text-decoration-none fw-bold text-accent link-hover small">
                    Access Terminal
                </a>
            </div>
        </form>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            const prefix = inputId === 'passwordInput' ? 'pw' : 'cf';
            const isHidden = input.type === 'password';

            input.type = isHidden ? 'text' : 'password';
            document.getElementById('icon-' + prefix + '-closed').style.display = isHidden ? 'none'  : '';
            document.getElementById('icon-' + prefix + '-open').style.display   = isHidden ? ''      : 'none';
        }

        const passwordInput = document.getElementById('passwordInput');
        const confirmInput  = document.getElementById('confirmInput');
        const strengthFill  = document.getElementById('strengthFill');
        const strengthText  = document.getElementById('strengthText');

        const levels = [
            { label: '',       color: '',        width: '0%'   },
            { label: 'WEAK',   color: '#ef4444', width: '25%'  },
            { label: 'FAIR',   color: '#f97316', width: '50%'  },
            { label: 'GOOD',   color: '#eab308', width: '75%'  },
            { label: 'STRONG', color: '#c8c8c8', width: '100%' },
        ];

        function getStrength(pw) {
            if (!pw) return 0;
            let score = 0;
            if (pw.length >= 8)          score++;
            if (/[A-Z]/.test(pw))        score++;
            if (/[0-9]/.test(pw))        score++;
            if (/[^A-Za-z0-9]/.test(pw)) score++;
            return score;
        }

        passwordInput.addEventListener('input', () => {
            const lvl = levels[getStrength(passwordInput.value)];
            strengthFill.style.width           = lvl.width;
            strengthFill.style.backgroundColor = lvl.color;
            strengthText.textContent           = lvl.label;
            strengthText.style.color           = lvl.color;
            checkMatch();
        });

        confirmInput.addEventListener('input', checkMatch);

        function checkMatch() {
            if (!confirmInput.value) return;
            confirmInput.style.borderColor = (passwordInput.value === confirmInput.value)
                ? 'var(--color-accent)'
                : '#ef4444';
        }
    </script>
</body>
</html>