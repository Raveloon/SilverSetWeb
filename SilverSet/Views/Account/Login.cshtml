@model SilverSet.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Secure Access Terminal";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SilverSet Studios</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            background-color: var(--color-bg);
            color: var(--color-text);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            overflow: hidden;
            background-image: radial-gradient(circle at 20% 40%, var(--color-glow) 0%, transparent 25%), radial-gradient(circle at 80% 60%, var(--color-glow) 0%, transparent 25%);
            background-attachment: fixed;
        }

        .terminal-card {
            background-color: var(--color-bg-card);
            border: 1px solid var(--color-border);
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.7), 0 0 0 1px rgba(255,255,255,0.04) inset;
            width: 100%;
            max-width: 460px;
            backdrop-filter: blur(10px);
            transition: transform 0.3s ease;
        }

            .terminal-card:hover {
                transform: translateY(-4px);
            }

        .terminal-input {
            background-color: var(--color-bg-input);
            border: 1px solid var(--color-border);
            color: var(--color-text);
            padding: 0.75rem 1rem;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

            .terminal-input:focus {
                background-color: var(--color-bg-input);
                border-color: var(--color-accent);
                box-shadow: 0 0 12px var(--color-glow);
                color: var(--color-text);
            }

            .terminal-input::placeholder {
                color: var(--color-text-muted);
            }

        .terminal-checkbox {
            width: 1.1rem;
            height: 1.1rem;
            background-color: transparent;
            border: 2px solid var(--color-accent-dim);
            border-radius: 4px;
        }

            .terminal-checkbox:checked {
                background-color: var(--color-accent);
                border-color: var(--color-accent);
            }

        .password-wrapper {
            position: relative;
            display: flex;
        }

            .password-wrapper .terminal-input {
                border-radius: 8px 0 0 8px;
                border-right: none;
                flex: 1;
            }

                .password-wrapper .terminal-input:focus {
                    border-right: none;
                }

        .btn-eye {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 46px;
            background-color: var(--color-bg-input);
            border: 1px solid var(--color-border);
            border-left: none;
            border-radius: 0 8px 8px 0;
            cursor: pointer;
            transition: background-color 0.2s ease;
            flex-shrink: 0;
        }

            .btn-eye:hover {
                background-color: rgba(200,200,200,0.08);
            }

            .btn-eye svg {
                width: 18px;
                height: 18px;
                fill: none;
                stroke: var(--color-accent-dim);
                stroke-width: 1.8;
                stroke-linecap: round;
                stroke-linejoin: round;
                transition: stroke 0.2s ease;
            }

            .btn-eye:hover svg {
                stroke: var(--color-accent);
            }

        .password-wrapper .terminal-input:focus ~ .btn-eye {
            border-color: var(--color-accent);
        }

        .btn-silver {
            background: linear-gradient(135deg, var(--color-btn-from) 0%, var(--color-btn-to) 100%);
            color: #0a0a0a;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            border: none;
            border-radius: 10px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            z-index: 1;
        }

            .btn-silver::after {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: linear-gradient(135deg, #ffffff 0%, #c8c8c8 100%);
                opacity: 0;
                transition: opacity 0.3s ease;
                z-index: -1;
            }

            .btn-silver:hover::after {
                opacity: 1;
            }

            .btn-silver:hover {
                box-shadow: 0 0 25px var(--color-glow-strong);
                transform: translateY(-2px);
                color: #0a0a0a;
            }

        .text-accent {
            color: var(--color-accent);
        }

        .text-accent-dim {
            color: var(--color-accent-dim);
        }

        .text-accent-bright {
            color: var(--color-accent-bright);
        }

        .link-hover:hover {
            color: var(--color-accent-bright) !important;
            transition: color 0.2s ease;
        }

        .form-label {
            font-size: 0.8rem;
            letter-spacing: 0.5px;
            opacity: 0.9;
        }

        .divider-line {
            border-color: var(--color-border) !important;
        }
    </style>
</head>
<body class="position-relative min-vh-100 d-flex flex-column align-items-center justify-content-center">

    <div class="position-absolute top-0 start-0 p-4 d-flex align-items-center">
        <h5 class="fw-bold mb-0 text-accent" style="letter-spacing: 1.5px;">SILVERSET STUDIOS</h5>
    </div>

    <div class="position-absolute top-0 end-0 p-4">
        <span class="text-accent-dim small">Support</span>
    </div>

    <div class="card terminal-card p-5">
        <div class="text-center mb-5">
            <h3 class="fw-bold mb-1 text-accent" style="letter-spacing: 2px;">SILVERSET STUDIOS</h3>
            <p class="small fw-medium text-accent-dim mb-0" style="letter-spacing: 2.5px; opacity: 0.85;">
                SECURE ACCESS TERMINAL
            </p>
        </div>

        <form asp-action="Login" asp-controller="Account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-4 text-center"></div>

            <div class="mb-4">
                <label asp-for="UserName" class="form-label text-accent fw-medium">USERNAME</label>
                <input asp-for="UserName"
                       class="form-control terminal-input"
                       placeholder="Enter your handle" />
                <span asp-validation-for="UserName" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <label asp-for="Password" class="form-label text-accent fw-medium">PASSWORD</label>
                    <a asp-action="ForgotPassword" asp-controller="Account" class="text-accent-dim text-decoration-none small link-hover">FORGOT ACCESS?</a>
                </div>
                <div class="password-wrapper">
                    <input asp-for="Password"
                           id="loginPassword"
                           class="form-control terminal-input"
                           placeholder="••••••••"
                           type="password"
                           autocomplete="new-password"
                           readonly
                           onfocus="this.removeAttribute('readonly')" />
                    <button type="button" class="btn-eye" onclick="togglePassword()" tabindex="-1">
                        <svg id="icon-closed" viewBox="0 0 24 24">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                            <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                            <line x1="1" y1="1" x2="23" y2="23" />
                        </svg>
                        <svg id="icon-open" viewBox="0 0 24 24" style="display:none;">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-check mb-5 d-flex align-items-center">
                <input asp-for="RememberMe"
                       class="form-check-input terminal-checkbox me-2"
                       type="checkbox"
                       id="rememberMeCheck" />
                <label class="form-check-label text-accent-dim" for="rememberMeCheck" style="cursor: pointer;">
                    Stay logged in • 30 days
                </label>
            </div>

            <button type="submit" class="btn btn-silver w-100 py-3">INITIALIZE SESSION</button>

            <div class="text-center border-top divider-line pt-4 mt-4">
                <span class="text-accent-dim small">New operative? </span>
                <a asp-action="Register" asp-controller="Account"
                   class="text-decoration-none fw-bold text-accent link-hover small">
                    Request Credentials
                </a>
            </div>
        </form>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        function togglePassword() {
            const input = document.getElementById('loginPassword');
            const isHidden = input.type === 'password';
            input.type = isHidden ? 'text' : 'password';
            document.getElementById('icon-closed').style.display = isHidden ? 'none' : '';
            document.getElementById('icon-open').style.display   = isHidden ? ''     : 'none';
        }
    </script>
</body>
</html>