@model SilverSet.Models.ViewModels.ResetPasswordViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SilverSet Studios</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background-color: var(--color-bg);
            color: var(--color-text);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            overflow: hidden;
            background-image: radial-gradient(circle at 20% 40%, var(--color-glow) 0%, transparent 25%), radial-gradient(circle at 80% 60%, var(--color-glow) 0%, transparent 25%);
            background-attachment: fixed;
        }

        .terminal-card {
            background-color: var(--color-bg-card);
            border: 1px solid var(--color-border);
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.7), 0 0 0 1px rgba(255,255,255,0.04) inset;
            width: 100%;
            max-width: 460px;
            backdrop-filter: blur(10px);
        }

        .terminal-input {
            background-color: var(--color-bg-input);
            border: 1px solid var(--color-border);
            color: var(--color-text);
            padding: 0.75rem 1rem;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

            .terminal-input:focus {
                background-color: var(--color-bg-input);
                border-color: var(--color-accent);
                box-shadow: 0 0 12px var(--color-glow);
                color: var(--color-text);
            }

            .terminal-input::placeholder {
                color: var(--color-text-muted);
            }

        .btn-silver {
            background: linear-gradient(135deg, var(--color-btn-from) 0%, var(--color-btn-to) 100%);
            color: #0a0a0a;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            border: none;
            border-radius: 10px;
            transition: all 0.3s ease;
        }

            .btn-silver:hover {
                box-shadow: 0 0 25px var(--color-glow-strong);
                transform: translateY(-2px);
                color: #0a0a0a;
            }

        .form-label {
            font-size: 0.8rem;
            letter-spacing: 0.5px;
            opacity: 0.9;
        }

        .divider-line {
            border-color: var(--color-border) !important;
        }

        .password-wrapper {
            position: relative;
            display: flex;
        }

            .password-wrapper .terminal-input {
                border-radius: 8px 0 0 8px;
                border-right: none;
                flex: 1;
            }

        .btn-eye {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 46px;
            background-color: var(--color-bg-input);
            border: 1px solid var(--color-border);
            border-left: none;
            border-radius: 0 8px 8px 0;
            cursor: pointer;
            transition: background-color 0.2s ease;
            flex-shrink: 0;
        }

            .btn-eye:hover {
                background-color: rgba(200,200,200,0.08);
            }

            .btn-eye svg {
                width: 18px;
                height: 18px;
                fill: none;
                stroke: var(--color-accent-dim);
                stroke-width: 1.8;
                stroke-linecap: round;
                stroke-linejoin: round;
            }
    </style>
</head>
<body class="position-relative min-vh-100 d-flex flex-column align-items-center justify-content-center">

    <div class="position-absolute top-0 start-0 p-4">
        <h5 class="fw-bold mb-0" style="color:var(--color-accent); letter-spacing:1.5px;">SILVERSET STUDIOS</h5>
    </div>

    <div class="card terminal-card p-5">
        <div class="text-center mb-4">
            <h3 class="fw-bold mb-1" style="color:var(--color-accent); letter-spacing:2px;">NEW PASSWORD</h3>
            <p class="small fw-medium mb-0" style="color:var(--color-accent-dim); letter-spacing:2px;">
                SET YOUR NEW ACCESS KEY
            </p>
        </div>

        <form asp-action="ResetPassword" asp-controller="Account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 text-center"></div>
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />

            <div class="mb-4">
                <label asp-for="Password" class="form-label fw-medium" style="color:var(--color-accent);">NEW PASSWORD</label>
                <div class="password-wrapper">
                    <input asp-for="Password" id="newPassword" class="form-control terminal-input" placeholder="••••••••" type="password" />
                    <button type="button" class="btn-eye" onclick="togglePassword('newPassword', 'icon1-closed', 'icon1-open')" tabindex="-1">
                        <svg id="icon1-closed" viewBox="0 0 24 24">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                            <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                            <line x1="1" y1="1" x2="23" y2="23" />
                        </svg>
                        <svg id="icon1-open" viewBox="0 0 24 24" style="display:none;">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label fw-medium" style="color:var(--color-accent);">CONFIRM PASSWORD</label>
                <div class="password-wrapper">
                    <input asp-for="ConfirmPassword" id="confirmPassword" class="form-control terminal-input" placeholder="••••••••" type="password" />
                    <button type="button" class="btn-eye" onclick="togglePassword('confirmPassword', 'icon2-closed', 'icon2-open')" tabindex="-1">
                        <svg id="icon2-closed" viewBox="0 0 24 24">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                            <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                            <line x1="1" y1="1" x2="23" y2="23" />
                        </svg>
                        <svg id="icon2-open" viewBox="0 0 24 24" style="display:none;">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-silver w-100 py-3">RESET PASSWORD</button>

            <div class="text-center border-top divider-line pt-4 mt-4">
                <a asp-action="Login" asp-controller="Account" class="text-decoration-none small" style="color:var(--color-accent-dim);">
                    Back to Login
                </a>
            </div>
        </form>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
    <script>
        function togglePassword(inputId, closedIconId, openIconId) {
            const input = document.getElementById(inputId);
            const isHidden = input.type === 'password';
            input.type = isHidden ? 'text' : 'password';
            document.getElementById(closedIconId).style.display = isHidden ? 'none' : '';
            document.getElementById(openIconId).style.display = isHidden ? '' : 'none';
        }
    </script>
</body>
</html>