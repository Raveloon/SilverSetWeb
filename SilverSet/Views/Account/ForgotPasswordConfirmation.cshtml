@{
    ViewData["Title"] = "Reset Link Sent";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SilverSet Studios</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background-color: var(--color-bg);
            color: var(--color-text);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background-image: radial-gradient(circle at 20% 40%, var(--color-glow) 0%, transparent 25%), radial-gradient(circle at 80% 60%, var(--color-glow) 0%, transparent 25%);
            background-attachment: fixed;
        }

        .terminal-card {
            background-color: var(--color-bg-card);
            border: 1px solid var(--color-border);
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.7);
            width: 100%;
            max-width: 460px;
            backdrop-filter: blur(10px);
        }

        .divider-line {
            border-color: var(--color-border) !important;
        }
    </style>
</head>
<body class="position-relative min-vh-100 d-flex flex-column align-items-center justify-content-center">

    <div class="position-absolute top-0 start-0 p-4">
        <h5 class="fw-bold mb-0" style="color:var(--color-accent); letter-spacing:1.5px;">SILVERSET STUDIOS</h5>
    </div>

    <div class="card terminal-card p-5 text-center">
        <div style="font-size:2rem; margin-bottom:1rem;">✓</div>
        <h3 class="fw-bold mb-2" style="color:var(--color-accent); letter-spacing:2px;">LINK SENT</h3>
        <p class="small mb-4" style="color:var(--color-accent-dim);">
            If an account exists with that email, a reset link has been sent. Check your inbox.
        </p>
        <div class="border-top divider-line pt-4">
            <a href="/Account/Login" class="text-decoration-none small" style="color:var(--color-accent-dim);">
                Back to Login
            </a>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
</body>
</html>