@using SilverSet.Models.ViewModels
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html class="dark" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>SilverSet Studios Admin Login V2</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
    <style>
        body { font-family: 'Space Grotesk', sans-serif; }
        .data-stream-bg { background: linear-gradient(to bottom, #050505, #0A0A1F); position: relative; overflow: hidden; }
        .data-stream-overlay { background-image: linear-gradient(0deg, transparent 24%, rgba(13, 242, 242, 0.05) 25%, rgba(13, 242, 242, 0.05) 26%, transparent 27%, transparent 74%, rgba(13, 242, 242, 0.05) 75%, rgba(13, 242, 242, 0.05) 76%, transparent 77%, transparent), linear-gradient(90deg, transparent 24%, rgba(13, 242, 242, 0.05) 25%, rgba(13, 242, 242, 0.05) 26%, transparent 27%, transparent 74%, rgba(13, 242, 242, 0.05) 75%, rgba(13, 242, 242, 0.05) 76%, transparent 77%, transparent); background-size: 50px 50px; }
        .glass-panel { background: rgba(10, 20, 20, 0.7); backdrop-filter: blur(20px); border: 1px solid rgba(13, 242, 242, 0.2); box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.8); }
        .metallic-button { background: linear-gradient(135deg, #1a3a3a 0%, #0df2f2 50%, #1a3a3a 100%); background-size: 200% auto; transition: 0.3s; box-shadow: 0 0 15px rgba(13, 242, 242, 0.4); }
        .metallic-button:hover { background-position: right center; box-shadow: 0 0 25px rgba(13, 242, 242, 0.6); }
    </style>
</head>
<body class="bg-background-dark text-slate-100 min-h-screen flex flex-col font-display">
    <div class="fixed inset-0 data-stream-bg z-0">
        <div class="absolute inset-0 data-stream-overlay opacity-30"></div>
    </div>

    <main class="relative z-10 flex-grow flex flex-col items-center justify-center p-6">
        <div class="w-full max-w-md glass-panel rounded-xl p-8 md:p-10">
            <div class="mb-8 text-center">
                <h2 class="text-2xl font-semibold text-white mb-2">Admin Portal</h2>
                <p class="text-slate-400 text-xs tracking-widest uppercase">Variant 2.0.1 // Security Encrypted</p>
                @if (ViewBag.Error != null)
                {
                    <p class="text-red-500 text-xs mt-2">@ViewBag.Error</p>
                }
            </div>

            <form asp-area="Admin" asp-controller="Account" asp-action="Login" method="post" class="space-y-6">
                <div class="space-y-2">
                    <label class="block text-xs font-medium text-slate-400 uppercase tracking-wider ml-1">Admin Name</label>
                    <div class="relative flex items-center group border border-white/10 rounded-lg bg-background-dark/50">
                        <span class="material-icons absolute left-4 text-slate-500 text-xl">person</span>
                        <input asp-for="AdminName" class="w-full bg-transparent border-none py-4 pl-12 pr-4 text-white focus:ring-0 rounded-lg text-sm" placeholder="Enter credentials..." />
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="block text-xs font-medium text-slate-400 uppercase tracking-wider ml-1">Password</label>
                    <div class="relative flex items-center group border border-white/10 rounded-lg bg-background-dark/50">
                        <span class="material-icons absolute left-4 text-slate-500 text-xl">lock</span>
                        <input asp-for="Password" type="password" class="w-full bg-transparent border-none py-4 pl-12 pr-4 text-white focus:ring-0 rounded-lg text-sm" placeholder="••••••••" />
                    </div>
                </div>

                <button class="w-full py-4 rounded-lg metallic-button text-black font-bold text-sm tracking-widest uppercase flex items-center justify-center gap-2" type="submit">
                    <span>Initiate Login</span>
                    <span class="material-icons text-lg">bolt</span>
                </button>
            </form>
        </div>
    </main>
</body>
</html>