@using SilverSet.Areas.Admin.Models.ViewModels
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Portal — SilverSet Studios</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            background-color: var(--color-bg);
            color: var(--color-text);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            background-image: linear-gradient(0deg, transparent 24%, rgba(200,200,200,0.02) 25%, rgba(200,200,200,0.02) 26%, transparent 27%, transparent 74%, rgba(200,200,200,0.02) 75%, rgba(200,200,200,0.02) 76%, transparent 77%), linear-gradient(90deg, transparent 24%, rgba(200,200,200,0.02) 25%, rgba(200,200,200,0.02) 26%, transparent 27%, transparent 74%, rgba(200,200,200,0.02) 75%, rgba(200,200,200,0.02) 76%, transparent 77%);
            background-size: 50px 50px;
        }

        .admin-card {
            background-color: rgba(12, 12, 12, 0.88);
            border: 1px solid var(--color-border);
            border-radius: 16px;
            box-shadow: 0 8px 40px rgba(0,0,0,0.8), 0 0 0 1px rgba(255,255,255,0.03) inset;
            width: 100%;
            max-width: 420px;
            backdrop-filter: blur(20px);
        }

        .admin-badge {
            display: inline-block;
            background: rgba(200,200,200,0.06);
            border: 1px solid var(--color-border);
            border-radius: 20px;
            padding: 0.25rem 0.85rem;
            font-size: 0.68rem;
            letter-spacing: 2px;
            color: var(--color-accent-dim);
            text-transform: uppercase;
        }

        .terminal-input {
            background-color: var(--color-bg-input);
            border: 1px solid var(--color-border);
            color: var(--color-text);
            padding: 0.75rem 1rem;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

            .terminal-input:focus {
                background-color: var(--color-bg-input);
                border-color: var(--color-accent);
                box-shadow: 0 0 12px var(--color-glow);
                color: var(--color-text);
            }

            .terminal-input::placeholder {
                color: var(--color-text-muted);
            }

        /* Şifre alanı wrapper */
        .password-wrapper {
            display: flex;
        }

            .password-wrapper .terminal-input {
                border-radius: 8px 0 0 8px;
                border-right: none;
                flex: 1;
            }

                .password-wrapper .terminal-input:focus {
                    border-right: none;
                }

        .btn-eye {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 46px;
            background-color: var(--color-bg-input);
            border: 1px solid var(--color-border);
            border-left: none;
            border-radius: 0 8px 8px 0;
            cursor: pointer;
            transition: background-color 0.2s ease;
            flex-shrink: 0;
        }

            .btn-eye:hover {
                background-color: rgba(200,200,200,0.08);
            }

            .btn-eye svg {
                width: 18px;
                height: 18px;
                fill: none;
                stroke: var(--color-accent-dim);
                stroke-width: 1.8;
                stroke-linecap: round;
                stroke-linejoin: round;
                transition: stroke 0.2s ease;
            }

            .btn-eye:hover svg {
                stroke: var(--color-accent);
            }

        .password-wrapper .terminal-input:focus ~ .btn-eye {
            border-color: var(--color-accent);
        }

        .btn-admin {
            background: linear-gradient(135deg, var(--color-btn-from) 0%, var(--color-btn-to) 100%);
            color: #0a0a0a;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            border: none;
            border-radius: 10px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            z-index: 1;
        }

            .btn-admin::after {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: linear-gradient(135deg, #ffffff 0%, #c8c8c8 100%);
                opacity: 0;
                transition: opacity 0.3s ease;
                z-index: -1;
            }

            .btn-admin:hover::after {
                opacity: 1;
            }

            .btn-admin:hover {
                box-shadow: 0 0 25px var(--color-glow-strong);
                transform: translateY(-2px);
                color: #0a0a0a;
            }

        .form-label {
            font-size: 0.75rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--color-accent-dim);
            font-weight: 600;
        }

        .alert-admin {
            background-color: rgba(239, 68, 68, 0.08);
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 8px;
            color: #fca5a5;
            font-size: 0.82rem;
            padding: 0.75rem 1rem;
        }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center min-vh-100">

    <div class="admin-card p-5">

        <!-- Başlık -->
        <div class="text-center mb-4">
            <span class="admin-badge mb-3 d-inline-block">Restricted Access</span>
            <h4 class="fw-bold mb-1" style="color: var(--color-accent); letter-spacing: 2px;">ADMIN PORTAL</h4>
            <p class="mb-0" style="font-size: 0.7rem; letter-spacing: 2px; color: var(--color-text-muted);">
                SILVERSET STUDIOS // v2.0
            </p>
        </div>

        <!-- Hata mesajı -->
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert-admin mb-4">
                <strong>Hata:</strong> @ViewBag.ErrorMessage
            </div>
        }

        <form asp-area="Admin" asp-controller="Account" asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="AdminName" class="form-label">Admin Name</label>
                <input asp-for="AdminName"
                       class="form-control terminal-input"
                       placeholder="Enter credentials..."
                       autocomplete="off" />
                <span asp-validation-for="AdminName" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label">Password</label>
                <div class="password-wrapper">
                    <input asp-for="Password"
                           id="adminPassword"
                           class="form-control terminal-input"
                           placeholder="••••••••"
                           type="password"
                           autocomplete="new-password"
                           readonly
                           onfocus="this.removeAttribute('readonly')" />
                    <button type="button" class="btn-eye" onclick="togglePassword()" tabindex="-1">
                        <svg id="icon-closed" viewBox="0 0 24 24">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                            <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                            <line x1="1" y1="1" x2="23" y2="23" />
                        </svg>
                        <svg id="icon-open" viewBox="0 0 24 24" style="display:none;">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-admin w-100 py-3">
                Initiate Login
            </button>
        </form>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
    <script>
        function togglePassword() {
            const input = document.getElementById('adminPassword');
            const isHidden = input.type === 'password';
            input.type = isHidden ? 'text' : 'password';
            document.getElementById('icon-closed').style.display = isHidden ? 'none' : '';
            document.getElementById('icon-open').style.display   = isHidden ? ''     : 'none';
        }
    </script>
</body>
</html>
