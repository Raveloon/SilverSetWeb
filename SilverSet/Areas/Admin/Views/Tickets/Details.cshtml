@model SilverSet.Models.Entities.Ticket
@{
    ViewData["Title"] = "Support Operation";
}

@if (Model == null)
{
    <div class="container-fluid p-5">
        <div class="alert alert-danger" style="background: rgba(220, 38, 38, 0.15); border: 1px solid #ef4444; color: #ef4444;">
            <h4 class="fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> SYSTEM ERROR</h4>
            <p>Ticket data could not be loaded or was not found in the database. The operation cannot proceed.</p>
            <a asp-action="Index" class="btn btn-outline-danger mt-2 fw-bold">RETURN TO DASHBOARD</a>
        </div>
    </div>
}
else
{
    <style>
        .admin-chat-wrapper {
            padding: 1rem;
            overflow-x: hidden;
        }

        @@media (min-width: 992px) {
            .admin-chat-wrapper {
                padding: 2rem;
            }
        }

        .admin-chat-container {
            height: 500px;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid #333;
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
        }

        @@media (min-width: 992px) {
            .admin-chat-container {
                height: 650px;
            }
        }

        .msg-system {
            align-self: center;
            background: transparent;
            color: #ddd;
            font-size: 0.7rem;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            padding: 0.8rem 1rem;
            border-top: 1px dashed #666;
            border-bottom: 1px dashed #666;
            margin: 1.5rem 0;
            text-align: center;
            width: 95%;
            word-break: break-all;
            overflow-wrap: anywhere;
        }

        .admin-chat-messages {
            flex: 1;
            padding: 1.5rem;
            overflow-y: auto;
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
            gap: 1.2rem;
        }

            .admin-chat-messages::-webkit-scrollbar {
                width: 6px;
            }

            .admin-chat-messages::-webkit-scrollbar-thumb {
                background: rgba(160, 160, 160, 0.4);
                border-radius: 10px;
            }

        .msg {
            max-width: 85%;
            padding: 0.8rem 1rem;
            border-radius: 10px;
            font-size: 0.9rem;
            line-height: 2.2;
            position: relative;
            word-wrap: break-word;
            word-break: break-all;
            overflow-wrap: anywhere;
            color: #fff;
        }

        .word-span {
            cursor: pointer;
            transition: transform 0.2s ease, color 0.2s ease;
            display: inline-block;
            word-break: break-all;
            color: inherit;
            font-size: 1em;
            position: relative;
            z-index: 1;
            text-decoration: none;
        }

            .word-span::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: calc(100% + 20px);
                z-index: -1;
            }

            .word-span::after {
                content: "";
                position: absolute;
                left: 0;
                bottom: 2px;
                width: 100%;
                height: 0;
                background-color: rgba(239, 68, 68, 0.4);
                z-index: -2;
                transition: height 0.2s ease;
            }

            .word-span:hover {
                transform: translateY(-6px);
                color: #fff !important;
            }

                .word-span:hover::after {
                    height: 12px;
                }

        .msg-admin {
            align-self: flex-end;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid #fff;
        }

        .msg-user {
            align-self: flex-start;
            background: #1a1a1a;
            border: 1px solid #444;
        }

        .chat-footer {
            padding: 1rem;
            background: rgba(10, 10, 10, 0.6);
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        #adminSendBtn {
            background: #fff;
            color: #000;
            border: none;
            transition: background 0.2s;
        }

            #adminSendBtn:disabled {
                background: #333 !important;
                color: #666 !important;
                cursor: not-allowed;
            }

        .terminal-input {
            background: #000 !important;
            border: 1px solid #333 !important;
            color: #fff !important;
            font-size: 0.85rem;
        }

            .terminal-input:focus {
                border-color: #fff !important;
                box-shadow: 0 0 10px rgba(255, 255, 255, 0.1) !important;
            }

        .counter-label {
            font-size: 0.65rem;
            font-weight: 800;
            letter-spacing: 1px;
            margin-top: 0.4rem;
            display: block;
            text-align: right;
            color: #ccc;
        }

        .spam-warning-box {
            background: rgba(239, 68, 68, 0.1);
            border-left: 4px solid #ef4444;
            padding: 1rem;
            margin-bottom: 1.5rem;
            border-radius: 4px;
        }

        .ticket-subject {
            font-size: 1.35rem;
            word-wrap: break-word;
            overflow-wrap: anywhere;
        }

        @@media (min-width: 768px) {
            .ticket-subject {
                font-size: 2rem;
            }
        }

        .terminal-card {
            background: rgba(15,15,15,0.9);
            border: 1px solid #333;
            padding: 1.5rem;
            border-radius: 12px;
        }

        .text-muted {
            color: #ccc !important;
        }
    </style>

    <div class="admin-chat-wrapper container-fluid">
        @if (Model.IsSpam)
        {
            <div class="spam-warning-box">
                <div class="row align-items-center gy-3">
                    <div class="col-md-9">
                        <h6 class="text-danger fw-bold m-0"><i class="bi bi-shield-x me-2"></i> QUARANTINED TICKET</h6>
                        <small class="text-white">@Model.SpamReason</small>
                    </div>
                    <div class="col-md-3 text-md-end">
                        <button type="button" class="btn btn-sm btn-success fw-bold w-100 w-md-auto" data-bs-toggle="modal" data-bs-target="#restoreModal">MARK AS SAFE</button>
                    </div>
                </div>
            </div>
        }

        @if (Model.Attachments != null && Model.Attachments.Any())
        {
            <div class="terminal-card mb-4">
                <div class="small text-white text-uppercase fw-bold mb-3" style="letter-spacing: 2px;">Evidence Materials (@Model.Attachments.Count / 5)</div>
                <div class="d-flex gap-2 overflow-auto pb-2">
                    @foreach (var att in Model.Attachments)
                    {
                        <a href="@att.FileUrl" target="_blank">
                            <img src="@att.FileUrl" style="width: 120px; height: 80px; object-fit: cover; border-radius: 4px; border: 1px solid #444;">
                        </a>
                    }
                </div>
            </div>
        }

        <div class="row mb-4 gy-4 align-items-start">
            <div class="col-lg-7">
                <h2 class="text-white fw-bold ticket-subject text-uppercase m-0">@Model.Subject</h2>
                <div class="small text-white mt-2" style="letter-spacing: 1px; opacity: 0.8;">
                    INITIATED BY: <span class="text-white fw-bold">@(Model.User?.UserName ?? "Unknown")</span> | @Model.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                </div>
            </div>
            <div class="col-lg-5 text-lg-end">
                <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                    <a asp-action="Index" asp-route-view="@(Model.IsSpam ? "spam" : "active")" class="btn btn-outline-secondary btn-sm px-3 fw-bold"><i class="bi bi-arrow-left"></i> RETURN</a>
                    @if (Model.IsOpen)
                    {
                        <button type="button" class="btn btn-outline-warning btn-sm px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#closeModal">CLOSE MISSION</button>
                        @if (!Model.IsSpam)
                        {
                            <button type="button" class="btn btn-outline-danger btn-sm px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#markSpamModal"><i class="bi bi-shield-exclamation"></i> FLAG AS DANGEROUS</button>
                        }
                    }
                    else
                    {
                        <button type="button" class="btn btn-success btn-sm px-3 fw-bold @(Model.User?.IsBanned == true ? "disabled" : "")" data-bs-toggle="@(Model.User?.IsBanned == true ? "" : "modal")" data-bs-target="@(Model.User?.IsBanned == true ? "" : "#reopenModal")">RE-OPEN</button>
                    }
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-xl-9 col-lg-8 mb-4">
                <div class="admin-chat-container shadow-lg">
                    <div class="admin-chat-messages" id="adminChatBox">
                        @foreach (var msg in Model.Messages.OrderBy(m => m.SentAt))
                        {
                            if (msg.Content.StartsWith("[CLOSED]") || msg.Content.StartsWith("[RE-OPENED]") || msg.Content.StartsWith("[BANNED]") || msg.Content.StartsWith("[RESTORED]") || msg.Content.StartsWith("[FLAGGED]"))
                            {
                                <div class="msg-system">
                                    <i class="bi bi-info-circle me-1"></i> @msg.Content
                                </div>
                            }
                            else
                            {
                                <div class="msg @(msg.IsAdminReply ? "msg-admin" : "msg-user")" onclick="handleWordClick(event)">
                                    @foreach (var word in msg.Content.Split(' ', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span class="word-span">@word</span>

                                        @(" ")
                                    }
                                </div>
                            }
                        }
                    </div>
                    @if (Model.IsOpen && Model.User?.IsBanned != true)
                    {
                        <div class="chat-footer">
                            <div class="input-group">
                                <input type="text" id="adminMsgInput" class="form-control terminal-input py-2 px-3" placeholder="Transmit secured response..." autocomplete="off" maxlength="500">
                                <button id="adminSendBtn" class="btn px-4 fw-bold">SEND</button>
                            </div>
                            <span id="adminCharCount" class="counter-label">0 / 500 CHARACTERS</span>
                        </div>
                    }
                </div>
            </div>
            <div class="col-xl-3 col-lg-4">
                <div class="terminal-card shadow">
                    <h5 class="text-white mb-3" style="font-size: 0.8rem; letter-spacing: 2px; font-weight: 800;">QUICK BLACKLIST</h5>
                    <input type="text" id="manualBadWord" class="form-control terminal-input mb-2" placeholder="Enter word...">
                    <button onclick="submitBadWord(document.getElementById('manualBadWord').value)" class="btn btn-outline-danger w-100 btn-sm fw-bold">ADD TO DB</button>
                    <hr style="border-color: #444;">
                    <div id="banStatus" class="small text-white-50 text-center" style="font-size: 0.7rem;">Ready...</div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="markSpamModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content bg-dark border-danger text-white"><form asp-action="MarkAsSpam" method="post"><input type="hidden" name="id" value="@Model.Id" /><div class="modal-header border-danger"><h5 class="modal-title text-danger fw-bold">QUARANTINE OPERATION</h5></div><div class="modal-body"><textarea name="reason" id="spamReasonInput" class="form-control terminal-input" rows="4" required maxlength="480" placeholder="Describe the violation..."></textarea><span id="spamCharCount" class="counter-label">0 / 480 CHARACTERS</span></div><div class="modal-footer border-secondary"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">ABORT</button><button type="submit" class="btn btn-danger fw-bold">EXECUTE QUARANTINE</button></div></form></div></div></div>
    <div class="modal fade" id="closeModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content bg-dark border-secondary"><form asp-action="CloseTicket" method="post"><input type="hidden" name="id" value="@Model.Id" /><div class="modal-header border-secondary text-white"><h5 class="modal-title">FINAL TRANSMISSION</h5></div><div class="modal-body"><textarea name="closureMessage" id="closeMsgInput" class="form-control terminal-input" rows="4" required maxlength="450" placeholder="Closing explanation..."></textarea><span id="closeCharCount" class="counter-label">0 / 450 CHARACTERS</span></div><div class="modal-footer border-secondary"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">ABORT</button><button type="submit" class="btn btn-warning">CONFIRM CLOSURE</button></div></form></div></div></div>
    <div class="modal fade" id="reopenModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content bg-dark border-secondary"><form asp-action="ReopenTicket" method="post"><input type="hidden" name="id" value="@Model.Id" /><div class="modal-header border-secondary text-white"><h5 class="modal-title">RE-OPEN OPERATION</h5></div><div class="modal-body"><textarea name="openingReason" id="reopenReasonInput" class="form-control terminal-input" rows="4" placeholder="Reason for re-opening..." required maxlength="450"></textarea><span id="reopenCharCount" class="counter-label">0 / 450 CHARACTERS</span></div><div class="modal-footer border-secondary"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">CANCEL</button><button type="submit" class="btn btn-success">RE-OPEN NOW</button></div></form></div></div></div>
    <div class="modal fade" id="banModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content bg-dark border-danger"><form asp-action="BanUser" method="post"><input type="hidden" name="ticketId" value="@Model.Id" /><div class="modal-header border-danger text-danger fw-bold"><h5 class="modal-title">PERMANENT BAN</h5></div><div class="modal-body"><textarea name="banReason" id="banReasonInput" class="form-control terminal-input" rows="4" placeholder="Official ban reason..." required maxlength="450"></textarea><span id="banCharCount" class="counter-label">0 / 450 CHARACTERS</span></div><div class="modal-footer border-secondary"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">ABORT</button><button type="submit" class="btn btn-danger">EXECUTE BAN</button></div></form></div></div></div>
    <div class="modal fade" id="restoreModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content bg-dark border-success"><form asp-action="RestoreSpamTicket" method="post"><input type="hidden" name="id" value="@Model.Id" /><div class="modal-header border-success"><h5 class="modal-title text-success fw-bold">RESTORE TICKET</h5></div><div class="modal-body text-white">Do you confirm this ticket is safe?</div><div class="modal-footer border-secondary"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">CANCEL</button><button type="submit" class="btn btn-success">CONFIRM RESTORE</button></div></form></div></div></div>

    @section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        function setupCharCounter(inputId, labelId, max) {
            const input = document.getElementById(inputId);
            const label = document.getElementById(labelId);
            if (input && label) {
                input.addEventListener("input", () => {
                    const len = input.value.length;
                    label.textContent = `${len} / ${max} CHARACTERS`;
                    label.style.color = len >= max ? "#ef4444" : "#ccc";
                    const submitBtn = input.closest('form')?.querySelector('button[type="submit"]');
                    if(submitBtn) submitBtn.disabled = len > max;
                });
            }
        }

        setupCharCounter("adminMsgInput", "adminCharCount", 500);
        setupCharCounter("spamReasonInput", "spamCharCount", 480);
        setupCharCounter("closeMsgInput", "closeCharCount", 450);
        setupCharCounter("reopenReasonInput", "reopenCharCount", 450);
        setupCharCounter("banReasonInput", "banCharCount", 450);

        function handleWordClick(event) {
            if (event.target.classList.contains('word-span')) {
                const word = event.target.textContent.trim().replace(/[.,!?;:()]/g, "");
                if (confirm(`Ban word: "${word}"?`)) submitBadWord(word);
            }
        }

        function submitBadWord(word) {
            if (!word) return;
            const status = document.getElementById('banStatus');
            status.textContent = "Processing...";
            const formData = new URLSearchParams();
            formData.append('word', word);
            fetch('/Admin/Tickets/AddBadWord', { method: 'POST', body: formData, headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
            }).then(r => { if (r.ok) { status.textContent = `"${word}" added.`; status.style.color = "#10b981"; setTimeout(() => { status.textContent = "Ready..."; status.style.color = "#fff"; }, 2500); if (document.getElementById('manualBadWord')) document.getElementById('manualBadWord').value = ''; } });
        }

        const connection = new signalR.HubConnectionBuilder().withUrl("/ticketHub").withAutomaticReconnect().build();
        const ticketId = @Model.Id;

        connection.on("ReceiveMessage", (message, isAdmin) => {
            const chat = document.getElementById("adminChatBox");
            if (chat) {
                const div = document.createElement("div");
                div.className = `msg ${isAdmin ? 'msg-admin' : 'msg-user'}`;
                div.onclick = handleWordClick;
                div.innerHTML = message.split(' ').filter(w => w.length > 0).map(w => `<span class="word-span">${w}</span>`).join(' ');
                chat.appendChild(div);
                chat.scrollTop = chat.scrollHeight;
            }
        });

        connection.start().then(() => {
            connection.invoke("JoinTicketGroup", ticketId.toString());
            const chat = document.getElementById("adminChatBox");
            if (chat) chat.scrollTop = chat.scrollHeight;
        });

        const msgInput = document.getElementById("adminMsgInput");
        const sendBtn = document.getElementById("adminSendBtn");

        const sendMessage = () => {
            const message = msgInput?.value.trim();
            if (!message || message.length > 500) return;
            connection.invoke("SendMessage", ticketId, message).catch(console.error);
            msgInput.value = "";
            const charCount = document.getElementById("adminCharCount");
            if (charCount) charCount.textContent = "0 / 500 CHARACTERS";
        };

        sendBtn?.addEventListener("click", sendMessage);
        msgInput?.addEventListener("keypress", (e) => { if (e.key === 'Enter') sendMessage(); });
    </script>
    }
}