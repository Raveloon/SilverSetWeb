@model IEnumerable<SilverSet.Models.Entities.Ticket>
@{
    ViewData["Title"] = "Support Operations";
}

<style>
    .admin-container {
        padding: 1.5rem;
    }

    .terminal-card {
        background: rgba(15, 15, 15, 0.9);
        border: 1px solid #222;
        border-radius: 8px;
        padding: 1.25rem;
        margin-bottom: 2rem;
    }

    .pagination-terminal {
        display: flex;
        gap: 0.5rem;
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .pagination-terminal .page-link {
            background: transparent;
            color: #888;
            border: 1px solid #333;
            border-radius: 4px;
            padding: 0.5rem 1rem;
            font-size: 0.75rem;
            font-weight: 800;
            transition: all 0.2s;
            text-decoration: none;
        }

        .pagination-terminal .page-item.active .page-link {
            background: #fff;
            color: #000;
            border-color: #fff;
        }

        .pagination-terminal .page-link:hover:not(.active) {
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            border-color: #555;
        }

    .filter-label {
        color: #666;
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 0.5rem;
        display: block;
    }

    .terminal-input {
        background: #000 !important;
        border: 1px solid #333 !important;
        color: #fff !important;
        font-size: 0.85rem;
        border-radius: 4px;
        height: 42px;
    }

        .terminal-input:focus {
            border-color: #fff !important;
            box-shadow: 0 0 10px rgba(255, 255, 255, 0.1) !important;
        }

    .table-terminal {
        width: 100%;
        color: #999;
        border-collapse: separate;
        border-spacing: 0 10px;
    }

        .table-terminal thead th {
            color: #555;
            font-size: 0.7rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 0.5rem 1rem;
            border: none;
        }

        .table-terminal tbody tr {
            background: rgba(20, 20, 20, 0.6);
            transition: transform 0.2s, background 0.2s;
        }

            .table-terminal tbody tr:hover {
                background: rgba(30, 30, 30, 0.8);
                transform: translateY(-2px);
            }

        .table-terminal td {
            padding: 1.2rem 1rem;
            border-top: 1px solid #222;
            border-bottom: 1px solid #222;
            vertical-align: middle;
        }

            .table-terminal td:first-child {
                border-left: 1px solid #222;
                border-top-left-radius: 6px;
                border-bottom-left-radius: 6px;
            }

            .table-terminal td:last-child {
                border-right: 1px solid #222;
                border-top-right-radius: 6px;
                border-bottom-right-radius: 6px;
            }

    .badge-status {
        padding: 0.4rem 0.8rem;
        border-radius: 4px;
        font-size: 0.65rem;
        font-weight: 900;
        letter-spacing: 1px;
        display: inline-block;
        white-space: nowrap;
    }

    .badge-open {
        background: #fff;
        color: #000;
    }

    .badge-closed {
        background: transparent;
        color: #555;
        border: 1px solid #333;
    }

    .btn-action {
        text-transform: uppercase;
        letter-spacing: 1.5px;
        font-size: 0.7rem;
        font-weight: 800;
        padding: 0.6rem 1.2rem;
        border-radius: 4px;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-respond {
        background: #fff;
        color: #000;
        border: 1px solid #fff;
    }

        .btn-respond:hover {
            background: #ccc;
            border-color: #ccc;
        }

    .btn-view {
        background: transparent;
        color: #fff;
        border: 1px solid #444;
    }

        .btn-view:hover {
            border-color: #fff;
        }

    @@media (max-width: 768px) {
        .admin-container {
            padding: 0.75rem;
        }

        .table-terminal thead {
            display: none;
        }

        .table-terminal td {
            display: block;
            text-align: right;
            padding: 0.75rem 1rem;
            border: none;
        }

            .table-terminal td::before {
                content: attr(data-label);
                float: left;
                font-weight: 800;
                color: #555;
                font-size: 0.65rem;
                text-transform: uppercase;
            }

            .table-terminal td:last-child {
                border-bottom: 1px solid #333;
                text-align: center;
                padding: 1.5rem 1rem;
            }

        .btn-action {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="admin-container">
    <div class="mb-4 d-flex justify-content-between align-items-center">
        <h2 class="text-white fw-900 m-0" style="letter-spacing: 3px; font-size: 1.5rem;">SUPPORT <span style="color: #666;">OPS</span></h2>
        <div class="text-accent-dim small fw-bold">ACTIVE CHANNELS: @Model.Count(x => x.IsOpen)</div>
    </div>

    <div class="terminal-card shadow-sm">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="filter-label">Search Operative / Subject</label>
                <input type="text" name="searchTerm" class="form-control terminal-input" placeholder="Keyword..." value="@ViewBag.SearchTerm">
            </div>
            <div class="col-md-2">
                <label class="filter-label">Status</label>
                <select name="status" class="form-select terminal-input">
                    <option value="">All Systems</option>
                    <option value="open" selected="@(ViewBag.Status == "open")">Active Only</option>
                    <option value="closed" selected="@(ViewBag.Status == "closed")">Archived Only</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="filter-label">Time Window</label>
                <select name="timeRange" class="form-select terminal-input">
                    <option value="">Full History</option>
                    <option value="7days" selected="@(ViewBag.TimeRange == "7days")">Last 7 Days</option>
                    <option value="15days" selected="@(ViewBag.TimeRange == "15days")">Last 15 Days</option>
                    <option value="1month" selected="@(ViewBag.TimeRange == "1month")">Last 30 Days</option>
                    <option value="3months" selected="@(ViewBag.TimeRange == "3months")">Last 3 Months</option>
                    <option value="1year" selected="@(ViewBag.TimeRange == "1year")">Last Year</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-respond w-100 fw-bold">EXECUTE FILTER</button>
            </div>
        </form>
    </div>

    <div class="table-responsive" style="overflow: visible;">
        <table class="table-terminal">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Operative</th>
                    <th>Subject</th>
                    <th>Timestamp</th>
                    <th>Status</th>
                    <th class="text-end">Command</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr style="@(item.IsOpen ? "" : "opacity: 0.5;")">
                        <td data-label="ID" class="fw-bold" style="color: #fff;">#@item.Id</td>
                        <td data-label="Operative">
                            <div class="text-white fw-bold">@item.User?.UserName</div>
                        </td>
                        <td data-label="Subject">@item.Subject</td>
                        <td data-label="Timestamp" class="small">@item.CreatedAt.ToLocalTime().ToString("dd.MM.yy HH:mm")</td>
                        <td data-label="Status">
                            @if (item.IsOpen)
                            {
                                <span class="badge-status badge-open">ACTIVE</span>
                            }
                            else
                            {
                                <span class="badge-status badge-closed">ARCHIVED</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (item.IsOpen)
                            {
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-action btn-respond">
                                    <i class="bi bi-terminal-fill"></i> Respond
                                </a>
                            }
                            else
                            {
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-action btn-view">
                                    <i class="bi bi-eye"></i> View Log
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPages > 1)
    {
        <nav class="d-flex justify-content-center mt-4 mb-3">
            <ul class="pagination-terminal">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="?page=@i&searchTerm=@ViewBag.SearchTerm&status=@ViewBag.Status&timeRange=@ViewBag.TimeRange">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>