@using SilverSet.Areas.Admin.Controllers
@model AdminTicketDashboardViewModel
@{
    ViewData["Title"] = "Support Operations";
}

<style>
    .admin-container {
        padding: 1.5rem;
    }

    .terminal-card {
        background: rgba(15, 15, 15, 0.9);
        border: 1px solid #222;
        border-radius: 8px;
        padding: 1.25rem;
        margin-bottom: 2rem;
    }

    .filter-label {
        color: #666;
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 0.5rem;
        display: block;
    }

    .terminal-input {
        background: #000 !important;
        border: 1px solid #333 !important;
        color: #fff !important;
        font-size: 0.85rem;
        border-radius: 4px;
        height: 42px;
    }

        .terminal-input:focus {
            border-color: #fff !important;
            box-shadow: 0 0 10px rgba(255, 255, 255, 0.1) !important;
        }

    .table-terminal {
        width: 100%;
        color: #999;
        border-collapse: separate;
        border-spacing: 0 10px;
    }

        .table-terminal thead th {
            color: #555;
            font-size: 0.7rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 0.5rem 1rem;
        }

        .table-terminal tbody tr {
            background: rgba(20, 20, 20, 0.6);
            transition: transform 0.2s, background 0.2s;
        }

            .table-terminal tbody tr:hover {
                background: rgba(30, 30, 30, 0.8);
                transform: translateY(-2px);
            }

        .table-terminal td {
            padding: 1.2rem 1rem;
            border-top: 1px solid #222;
            border-bottom: 1px solid #222;
            vertical-align: middle;
        }

    .badge-status {
        padding: 0.4rem 0.8rem;
        border-radius: 4px;
        font-size: 0.65rem;
        font-weight: 900;
        letter-spacing: 1px;
    }

    .badge-open {
        background: #fff;
        color: #000;
    }

    .badge-closed {
        background: transparent;
        color: #555;
        border: 1px solid #333;
    }

    .badge-spam {
        background: #ef4444;
        color: #fff;
        display: inline-block;
        line-height: 1.4;
        word-wrap: break-word;
        text-align: center;
        text-transform: uppercase;
        max-width: 350px;
    }

    .btn-action {
        text-transform: uppercase;
        letter-spacing: 1.5px;
        font-size: 0.7rem;
        font-weight: 800;
        padding: 0.6rem 1.2rem;
        border-radius: 4px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: 0.2s;
    }

    .btn-respond {
        background: #fff;
        color: #000;
    }

    .btn-view {
        background: transparent;
        color: #888;
        border: 1px solid #333;
    }
</style>

<div class="admin-container">
    <div class="terminal-card">
        <form method="get" class="row g-3 align-items-end">
            <input type="hidden" name="view" value="@(Context.Request.Query["view"] == "spam" ? "spam" : "active")" />
            <div class="col-md-3">
                <label class="filter-label">Search Operative</label>
                <input type="text" name="searchTerm" class="form-control terminal-input" placeholder="Keyword..." value="@Model.SearchTerm">
            </div>
            <div class="col-md-2">
                <label class="filter-label">Status</label>
                <select name="status" class="form-select terminal-input">
                    <option value="">All Systems</option>
                    <option value="open" selected="@(Model.Status == "open")">Active</option>
                    <option value="closed" selected="@(Model.Status == "closed")">Archived</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="filter-label">Time Window</label>
                <select name="timeRange" class="form-select terminal-input">
                    <option value="">Full History</option>
                    <option value="7days" selected="@(Model.TimeRange == "7days")">Last 7 Days</option>
                    <option value="1month" selected="@(Model.TimeRange == "1month")">Last 30 Days</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-respond w-100 fw-bold">EXECUTE FILTER</button>
            </div>
        </form>
    </div>

    @if (Context.Request.Query["view"] != "spam")
    {
        <div id="active-tickets-section">
            <div class="mb-4">
                <h2 class="text-white fw-900 m-0" style="letter-spacing: 3px; font-size: 1.5rem;">SUPPORT <span style="color: #666;">OPS</span></h2>
            </div>
            <div class="table-responsive">
                <table class="table-terminal">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Operative</th>
                            <th>Subject</th>
                            <th>Status</th>
                            <th class="text-end">Command</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ActiveTickets)
                        {
                            <tr>
                                <td>#@item.Id</td>
                                <td><div class="text-white fw-bold">@(item.User?.UserName ?? "Unknown")</div></td>
                                <td>@item.Subject</td>
                                <td>
                                    <span class="badge-status @(item.IsOpen ? "badge-open" : "badge-closed")">
                                        @(item.IsOpen ? "ACTIVE" : "ARCHIVED")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-action @(item.IsOpen ? "btn-respond" : "btn-view")">
                                        <i class="bi @(item.IsOpen ? "bi-terminal-fill" : "bi-eye")"></i> @(item.IsOpen ? "RESPOND" : "VIEW")
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div id="spam-tickets-section">
            <div class="mb-4">
                <h2 class="text-white fw-900 m-0" style="letter-spacing: 3px; font-size: 1.5rem;">SPAM <span style="color: #ef4444;">QUARANTINE</span></h2>
            </div>
            <div class="table-responsive">
                <table class="table-terminal">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Operative</th>
                            <th>Subject</th>
                            <th>Status</th>
                            <th class="text-end">Command</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.SpamTickets)
                        {
                            <tr style="opacity: @(item.User?.IsBanned == true ? "0.5" : "0.85");">
                                <td>#@item.Id</td>
                                <td>@item.User?.UserName</td>
                                <td>@item.Subject</td>
                                <td>
                                    @if (item.User != null && item.User.IsBanned)
                                    {
                                        <span class="badge-status" style="background: #ef4444; color: #fff;">BANNED ARCHIVE</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-spam">
                                            @{
                                                var rawReason = item.SpamReason ?? "";
                                                string prefix = "MANUAL";
                                                string cleanReason = rawReason;

                                                if (rawReason.Contains("Auto-Flag") || rawReason.Contains("Takıldı"))
                                                {
                                                    prefix = "FILTERED";
                                                    cleanReason = rawReason.Replace("Auto-Flag:", "")
                                                    .Replace("Filtreye Takıldı:", "")
                                                    .Replace("İçerik:", "")
                                                    .Trim()
                                                    .TrimStart(':')
                                                    .Trim();
                                                }
                                                else if (rawReason.Contains("Manual Flag:"))
                                                {
                                                    prefix = "MANUAL";
                                                    cleanReason = rawReason.Replace("Manual Flag:", "").Trim();
                                                }

                                                @(prefix + " : " + cleanReason.ToUpper())
                                            }
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-action @(item.IsOpen ? "btn-respond" : "btn-view")">
                                        <i class="bi @(item.IsOpen ? "bi-terminal-fill" : "bi-eye")"></i> @(item.IsOpen ? "RESPOND" : "VIEW")
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>