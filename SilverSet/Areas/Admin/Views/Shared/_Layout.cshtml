<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — SilverSet Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --admin-bg: #0a0a0a;
            --admin-sidebar: #111111;
            --admin-border: rgba(255,255,255,0.07);
            --admin-accent: #ffffff;
            --admin-muted: #666666;
            --admin-hover: rgba(255,255,255,0.05);
            --admin-active: rgba(255,255,255,0.08);
            --sidebar-width: 240px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: var(--admin-bg);
            color: #e2e8f0;
            font-family: 'Segoe UI', system-ui, sans-serif;
            display: flex;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .admin-sidebar {
            width: var(--sidebar-width);
            min-height: 100vh;
            background: var(--admin-sidebar);
            border-right: 1px solid var(--admin-border);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1050;
            transition: transform 0.3s ease-in-out;
        }

        .sidebar-logo {
            padding: 1.5rem;
            border-bottom: 1px solid var(--admin-border);
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .sidebar-logo-badge {
            width: 32px;
            height: 32px;
            background: white;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .sidebar-logo-badge img {
                width: 28px;
                height: 28px;
                object-fit: contain;
            }

        .sidebar-logo-text {
            font-size: 0.85rem;
            font-weight: 700;
            color: white;
            letter-spacing: 1px;
        }

        .sidebar-logo-sub {
            font-size: 0.65rem;
            color: var(--admin-muted);
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .sidebar-nav {
            padding: 1rem 0;
            flex: 1;
            overflow-y: auto;
        }

            .sidebar-nav::-webkit-scrollbar {
                width: 5px;
            }

            .sidebar-nav::-webkit-scrollbar-track {
                background: transparent;
            }

            .sidebar-nav::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,0.1);
                border-radius: 10px;
            }

        .nav-section-label {
            font-size: 0.6rem;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--admin-muted);
            padding: 0.75rem 1.25rem 0.4rem;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.65rem 1.25rem;
            color: #9ca3af;
            text-decoration: none;
            font-size: 0.875rem;
            font-weight: 500;
            transition: all 0.2s ease;
            border-left: 2px solid transparent;
        }

            .sidebar-link:hover {
                background: var(--admin-hover);
                color: white;
            }

            .sidebar-link.active {
                background: var(--admin-active);
                color: white;
                border-left-color: white;
            }

            .sidebar-link i {
                font-size: 1rem;
                width: 18px;
                text-align: center;
            }

        .notification-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background-color: #ef4444;
            color: white;
            font-size: 0.7rem;
            font-weight: 800;
            padding: 0 6px;
            border-radius: 10px;
            margin-left: auto;
            min-width: 20px;
            height: 20px;
            line-height: 1;
            box-shadow: 0 0 10px rgba(239, 68, 68, 0.4);
        }

        .sidebar-footer {
            padding: 1rem 1.25rem;
            border-top: 1px solid var(--admin-border);
        }

            .sidebar-footer a {
                display: flex;
                align-items: center;
                gap: 0.6rem;
                color: var(--admin-muted);
                font-size: 0.8rem;
                text-decoration: none;
                transition: color 0.2s;
            }

                .sidebar-footer a:hover {
                    color: white;
                }

        .admin-wrapper {
            display: flex;
            width: 100%;
            transition: margin-left 0.3s ease-in-out;
            margin-left: var(--sidebar-width);
        }

        .admin-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            width: calc(100% - var(--sidebar-width));
        }

        .admin-topbar {
            height: 56px;
            border-bottom: 1px solid var(--admin-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1.5rem;
            background: var(--admin-bg);
            position: sticky;
            top: 0;
            z-index: 50;
        }

        .topbar-left-section {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .topbar-title {
            font-size: 0.9rem;
            font-weight: 600;
            color: white;
        }

        .topbar-user {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            font-size: 0.8rem;
            color: var(--admin-muted);
        }

        .topbar-avatar {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: rgba(255,255,255,0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 700;
            color: white;
        }

        .admin-content {
            padding: 2rem 1.5rem;
            flex: 1;
        }

        .mobile-menu-toggle {
            display: none;
            background: transparent;
            border: none;
            color: #ffffff;
            cursor: pointer;
            padding: 0.4rem;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            transition: background 0.2s ease;
        }

            .mobile-menu-toggle:hover {
                background: rgba(255,255,255,0.1);
            }

        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(2px);
            z-index: 1040;
            opacity: 0;
            transition: opacity 0.3s ease-in-out;
        }

        @@media (max-width: 991.98px) {
            .admin-sidebar {
                transform: translateX(-100%);
            }

            .admin-wrapper {
                margin-left: 0;
            }

            .admin-main {
                width: 100%;
            }

            body.sidebar-open .admin-sidebar {
                transform: translateX(0);
            }

            body.sidebar-open .sidebar-overlay {
                display: block;
                opacity: 1;
            }

            .mobile-menu-toggle {
                display: flex !important;
            }
        }
    </style>
</head>
<body>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <aside class="admin-sidebar" id="adminSidebar">
        <div class="sidebar-logo">
            <div class="sidebar-logo-badge">
                <img src="~/images/silversetLogo.jpg" alt="SS" />
            </div>
            <div>
                <div class="sidebar-logo-text">SilverSet</div>
                <div class="sidebar-logo-sub">Admin Panel</div>
            </div>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section-label">Overview</div>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
               class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                <i class="bi bi-grid"></i> Dashboard
            </a>

            <div class="nav-section-label">Content</div>
            <a asp-area="Admin" asp-controller="Assets" asp-action="Index"
               class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Assets" ? "active" : "")">
                <i class="bi bi-collection"></i> FAB Projects
            </a>

            <div class="nav-section-label">Users</div>
            <a asp-area="Admin" asp-controller="Users" asp-action="Index"
               class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")">
                <i class="bi bi-people"></i> Users
            </a>

            <div class="nav-section-label">SUPPORT</div>
            <a asp-area="Admin" asp-controller="Tickets" asp-action="Index" asp-route-view="active"
               class="sidebar-link @(ViewBag.ActiveMenu == "Tickets" ? "active" : "")">
                <i class="bi bi-ticket-detailed"></i> Support Tickets
                @if (ViewBag.ActiveTicketCount > 0)
                {
                    <span class="notification-badge">@ViewBag.ActiveTicketCount</span>
                }
            </a>
            <a asp-area="Admin" asp-controller="Tickets" asp-action="Index" asp-route-view="spam"
               class="sidebar-link @(ViewBag.ActiveMenu == "Spam" ? "active" : "")">
                <i class="bi bi-shield-x"></i> Spam
                @if (ViewBag.SpamTicketCount > 0)
                {
                    <span class="notification-badge">@ViewBag.SpamTicketCount</span>
                }
            </a>

            <div class="nav-section-label">Security</div>
            <a asp-area="Admin" asp-controller="Logs" asp-action="Index"
               class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Logs" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                <i class="bi bi-shield-check"></i> Login Logs
            </a>
            <a asp-area="Admin" asp-controller="Logs" asp-action="PasswordResets"
               class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "PasswordResets" ? "active" : "")">
                <i class="bi bi-key"></i> Password Resets
            </a>

            <div class="nav-section-label">Community</div>
            <a asp-area="Admin" asp-controller="Forum" asp-action="Settings"
               class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Forum" ? "active" : "")">
                <i class="bi bi-chat-square-text"></i> Forum Control
            </a>
        </nav>

        <div class="sidebar-footer">
            <a asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-arrow-left"></i> Back to Site
            </a>
        </div>
    </aside>

    <div class="admin-wrapper">
        <div class="admin-main">
            <header class="admin-topbar">
                <div class="topbar-left-section">
                    <button class="mobile-menu-toggle" id="mobileMenuBtn" aria-label="Toggle sidebar">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>
                    <span class="topbar-title" style="letter-spacing: 1px; color: #777; text-transform: uppercase; font-size: 0.7rem;">
                        DashBoard Terminal
                    </span>
                </div>

                <div class="topbar-user" style="gap: 1.5rem;">
                    <span id="live-top-clock" class="topbar-clock d-none d-sm-inline" style="color: white; font-weight: 700; font-size: 1.1rem; letter-spacing: 0.5px; font-family: 'Courier New', Courier, monospace;">
                        @DateTime.Now.ToString("HH:mm")
                    </span>
                    <div style="display: flex; align-items: center; gap: 0.6rem;">
                        <div class="topbar-avatar">
                            @User.Identity?.Name?.Substring(0, 1).ToUpper()
                        </div>
                        <span class="d-none d-sm-inline" style="color: #888; font-weight: 500;">@User.Identity?.Name</span>
                    </div>
                </div>
            </header>

            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const body = document.body;
            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            const clockElement = document.getElementById('live-top-clock');

            if(mobileMenuBtn) {
                mobileMenuBtn.addEventListener('click', function () {
                    body.classList.toggle('sidebar-open');
                });
            }

            if(sidebarOverlay) {
                sidebarOverlay.addEventListener('click', function () {
                    body.classList.remove('sidebar-open');
                });
            }

            function updateClock() {
                const now = new Date();
                const hours = String(now.getHours()).padStart(2, '0');
                const minutes = String(now.getMinutes()).padStart(2, '0');
                if (clockElement) {
                    clockElement.innerText = hours + ':' + minutes;
                }
            }

            setInterval(updateClock, 1000);
            updateClock();
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>