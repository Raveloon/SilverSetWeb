<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — SilverSet Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --admin-bg: #0a0a0a;
            --admin-sidebar: #111111;
            --admin-border: rgba(255,255,255,0.07);
            --admin-accent: #ffffff;
            --admin-muted: #666666;
            --admin-hover: rgba(255,255,255,0.05);
            --admin-active: rgba(255,255,255,0.08);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: var(--admin-bg);
            color: #e2e8f0;
            font-family: 'Segoe UI', system-ui, sans-serif;
            display: flex;
            min-height: 100vh;
        }

        /* ── SIDEBAR ── */
        .admin-sidebar {
            width: 240px;
            min-height: 100vh;
            background: var(--admin-sidebar);
            border-right: 1px solid var(--admin-border);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 100;
        }

        .sidebar-logo {
            padding: 1.5rem;
            border-bottom: 1px solid var(--admin-border);
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .sidebar-logo-badge {
            width: 32px;
            height: 32px;
            background: white;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sidebar-logo-badge img {
            width: 28px;
            height: 28px;
            object-fit: contain;
        }

        .sidebar-logo-text {
            font-size: 0.85rem;
            font-weight: 700;
            color: white;
            letter-spacing: 1px;
        }

        .sidebar-logo-sub {
            font-size: 0.65rem;
            color: var(--admin-muted);
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .sidebar-nav {
            padding: 1rem 0;
            flex: 1;
        }

        .nav-section-label {
            font-size: 0.6rem;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--admin-muted);
            padding: 0.75rem 1.25rem 0.4rem;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.65rem 1.25rem;
            color: #9ca3af;
            text-decoration: none;
            font-size: 0.875rem;
            font-weight: 500;
            transition: all 0.2s ease;
            border-left: 2px solid transparent;
        }

        .sidebar-link:hover {
            background: var(--admin-hover);
            color: white;
        }

        .sidebar-link.active {
            background: var(--admin-active);
            color: white;
            border-left-color: white;
        }

        .sidebar-link i {
            font-size: 1rem;
            width: 18px;
            text-align: center;
        }

        .sidebar-footer {
            padding: 1rem 1.25rem;
            border-top: 1px solid var(--admin-border);
        }

        .sidebar-footer a {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            color: var(--admin-muted);
            font-size: 0.8rem;
            text-decoration: none;
            transition: color 0.2s;
        }

        .sidebar-footer a:hover { color: white; }

        /* ── MAIN ── */
        .admin-main {
            margin-left: 240px;
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .admin-topbar {
            height: 56px;
            border-bottom: 1px solid var(--admin-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1.5rem;
            background: var(--admin-bg);
            position: sticky;
            top: 0;
            z-index: 50;
        }

        .topbar-title {
            font-size: 0.9rem;
            font-weight: 600;
            color: white;
        }

        .topbar-user {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            font-size: 0.8rem;
            color: var(--admin-muted);
        }

        .topbar-avatar {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: rgba(255,255,255,0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 700;
            color: white;
        }

        .admin-content {
            padding: 2rem 1.5rem;
            flex: 1;
        }
    </style>
</head>
<body>

<!-- ── SIDEBAR ── -->
<aside class="admin-sidebar">
    <div class="sidebar-logo">
        <div class="sidebar-logo-badge">
            <img src="~/images/silversetLogo.jpg" alt="SS" />
        </div>
        <div>
            <div class="sidebar-logo-text">SilverSet</div>
            <div class="sidebar-logo-sub">Admin Panel</div>
        </div>
    </div>

    <nav class="sidebar-nav">
        <div class="nav-section-label">Overview</div>
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
           class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
            <i class="bi bi-grid"></i> Dashboard
        </a>

        <div class="nav-section-label">Content</div>
            <a asp-area="Admin" asp-controller="Assets" asp-action="Index"
               class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Assets" ? "active" : "")">
                <i class="bi bi-collection"></i> FAB Projects
            </a>

        <div class="nav-section-label">Users</div>
            <a asp-area="Admin" asp-controller="Users" asp-action="Index"
               class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")">
                <i class="bi bi-people"></i> Users
            </a>

         <div class="nav-section-label">Security</div>
        <a asp-area="Admin" asp-controller="Logs" asp-action="Index"
               class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Logs" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
             <i class="bi bi-shield-check"></i> Login Logs
         </a>
            <a asp-area="Admin" asp-controller="Logs" asp-action="PasswordResets"
               class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "PasswordResets" ? "active" : "")">
                <i class="bi bi-key"></i> Password Resets
            </a>
        <div class="nav-section-label">Community</div>
        <a href="#" class="sidebar-link">
            <i class="bi bi-chat-square-text"></i> Forum
            <span style="margin-left:auto; font-size:0.6rem; background:rgba(255,255,255,0.1); padding:0.1rem 0.4rem; border-radius:4px; color:#666">Soon</span>
        </a>
    </nav>

    <div class="sidebar-footer">
        <a asp-area="" asp-controller="Home" asp-action="Index">
            <i class="bi bi-arrow-left"></i> Back to Site
        </a>
    </div>
</aside>

<!-- ── MAIN ── -->
<div class="admin-main">
    <header class="admin-topbar">
        <span class="topbar-title">@ViewData["Title"]</span>
        <div class="topbar-user">
            <div class="topbar-avatar">@User.Identity?.Name?.Substring(0,1).ToUpper()</div>
            @User.Identity?.Name
        </div>
    </header>

    <main class="admin-content">
        @RenderBody()
    </main>
</div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
    @RenderSection("Scripts", required: false)
</body>
</html>