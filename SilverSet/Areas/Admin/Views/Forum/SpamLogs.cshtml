@model IEnumerable<SilverSet.Models.Entities.Forum.ForumSpamLog>
@using Microsoft.EntityFrameworkCore
@{
    ViewData["Title"] = "Forum Spam Control";
    Layout = "_Layout";
    var userGroups = Model.Where(l => !l.IsHandled).GroupBy(l => l.UserId).ToList();
}

<style>
    .user-wrapper {
        background: #0a0a0a;
        border: 1px solid #222;
        border-radius: 12px;
        margin-bottom: 3rem;
        padding: 1.5rem;
    }

    .user-identity {
        border-bottom: 1px solid #333;
        padding-bottom: 1rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .topic-group-box {
        background: #111;
        border: 1px solid #1a1a1a;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        overflow: hidden;
    }

    .topic-group-header {
        background: #181818;
        padding: 0.75rem 1.25rem;
        border-bottom: 1px solid #222;
        font-size: 0.8rem;
        color: #888;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .log-row {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #1a1a1a;
        position: relative;
        transition: 0.2s;
    }

        .log-row:last-child {
            border-bottom: none;
        }

        .log-row.is-violation {
            border-left: 4px solid #ef4444;
            background: #1a0a0a;
        }

        .log-row.is-inspection {
            border-left: 4px solid #f59e0b;
            background: #1a150a;
        }

    .type-badge {
        font-size: 0.65rem;
        font-weight: 800;
        padding: 3px 8px;
        border-radius: 4px;
        margin-right: 8px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        border: none;
    }

    .badge-violation {
        background: #ef4444;
        color: white;
    }

    .badge-inspection {
        background: #f59e0b !important;
        color: black !important;
    }

    .badge-topic-title {
        background: #4b5563;
        color: white;
        margin-left: 5px;
    }

    .msg-content {
        color: #eee;
        font-size: 0.95rem;
        margin-top: 0.75rem;
        word-break: break-all;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .action-panel {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .clickable-word {
        cursor: pointer;
        color: #aaa;
        transition: 0.2s;
    }

        .clickable-word:hover {
            color: #fff;
            text-decoration: underline;
        }

    .btn-xs {
        padding: 2px 8px;
        font-size: 0.65rem;
        font-weight: bold;
        text-transform: uppercase;
    }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-white fw-bold"><i class="bi bi-shield-lock me-2"></i>Forum Moderasyon Merkezi</h2>
        <span class="badge bg-danger px-3 py-2">@userGroups.Count Aktif Operasyon</span>
    </div>

    @if (!userGroups.Any())
    {
        <div class="alert alert-dark text-center py-5 border-secondary">
            <i class="bi bi-shield-check fs-1 d-block mb-3 opacity-50"></i>
            Sistem temiz. Bekleyen ihlal kaydı bulunamadı.
        </div>
    }

    @foreach (var userGroup in userGroups)
    {
        var firstLog = userGroup.First();
        <div class="user-wrapper">
            <div class="user-identity">
                <h4 class="text-white mb-0">
                    <i class="bi bi-person-circle me-2 text-primary"></i>@firstLog.User.UserName
                </h4>
                <div class="action-panel">
                    <form asp-area="Admin" asp-controller="Forum" asp-action="ApproveAllUserLogs" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@userGroup.Key" />
                        <button type="submit" class="btn btn-success btn-sm fw-bold">TÜMÜNÜ ONAYLA</button>
                    </form>
                    <form asp-area="Admin" asp-controller="Forum" asp-action="DeleteAllUserLogs" method="post" class="d-inline" onsubmit="return confirm('Kullanıcının bütün mesajlaşmasını sileceksin emin misin?')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@userGroup.Key" />
                        <button type="submit" class="btn btn-danger btn-sm fw-bold">TÜMÜNÜ SİL</button>
                    </form>
                    <button type="button" class="btn btn-warning btn-sm fw-bold" onclick="openBanModal(@userGroup.Key, '@firstLog.User.UserName')">BANLA</button>
                </div>
            </div>

            @foreach (var topicGroup in userGroup.GroupBy(l => l.TopicId))
            {
                var topicInfo = topicGroup.First().Topic;
                bool isTopicStarter = topicInfo != null && topicInfo.UserId == userGroup.Key;
                int postCount = topicInfo?.Posts?.Count ?? 0;

                <div class="topic-group-box">
                    <div class="topic-group-header">
                        <div>
                            <i class="bi bi-chat-left-text me-2"></i>
                            @(topicInfo?.Category?.Name ?? "Genel") / <strong>@(topicInfo?.Title ?? "Başlıksız")</strong>
                        </div>
                        <div class="action-panel">
                            <a asp-area="Admin" asp-controller="Forum" asp-action="ModerationView" asp-route-topicId="@topicGroup.Key" class="btn btn-outline-info btn-xs">Konuya Git</a>
                            <form asp-area="Admin" asp-controller="Forum" asp-action="ApproveTopicLogs" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="topicId" value="@topicGroup.Key" />
                                <input type="hidden" name="userId" value="@userGroup.Key" />
                                <button type="submit" class="btn btn-outline-success btn-xs">KONUYU ONAYLA</button>
                            </form>
                            <form asp-area="Admin" asp-controller="Forum" asp-action="DeleteTopicLogs" method="post" class="d-inline"
                                  onsubmit="return handleTopicDeletion(this, @isTopicStarter.ToString().ToLower(), @postCount)">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="topicId" value="@topicGroup.Key" />
                                <input type="hidden" name="userId" value="@userGroup.Key" />
                                @if (isTopicStarter)
                                {
                                    <button type="submit" class="btn btn-danger btn-xs fw-bold">TOPIC'I SİL</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-outline-danger btn-xs">İÇERİKLERİ SİL</button>
                                }
                            </form>
                        </div>
                    </div>

                    @foreach (var log in topicGroup.OrderBy(l => l.CreatedAt))
                    {
                        var isViolation = log.CaughtWord != "DENETIM";
                        <div class="log-row @(isViolation ? "is-violation" : "is-inspection")">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="type-badge @(isViolation ? "badge-violation" : "badge-inspection")">
                                        FİLTRE: @log.CaughtWord
                                    </span>
                                    @if (log.Type == "TopicTitle")
                                    {
                                        <span class="type-badge badge-topic-title">İHLAL: KONU BAŞLIĞI</span>
                                    }
                                    <span class="text-muted small ms-2">@log.CreatedAt.ToString("HH:mm")</span>
                                </div>

                                <div class="action-panel">
                                    <form asp-area="Admin" asp-controller="Forum" asp-action="ApproveItem" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@(log.PostId ?? log.TopicId)" />
                                        <input type="hidden" name="type" value="@log.Type" />
                                        <button type="submit" class="btn btn-outline-success btn-xs">ONAYLA</button>
                                    </form>

                                    <form asp-area="Admin" asp-controller="Forum" asp-action="DeleteItem" method="post" onsubmit="return confirm('Silmek istediğine emin misin?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@(log.PostId ?? log.TopicId)" />
                                        <input type="hidden" name="type" value="@log.Type" />
                                        <button type="submit" class="btn btn-outline-danger btn-xs">SİL</button>
                                    </form>
                                </div>
                            </div>

                            <div class="msg-content">
                                @if (log.Type == "TopicTitle")
                                {
                                    <div class="mb-1 text-info small" style="opacity: 0.8;">
                                        <i class="bi bi-fonts me-1"></i> İhlal içeren başlık: <strong>@log.Topic?.Title</strong>
                                    </div>
                                }
                                @foreach (var word in (log.Content ?? "").Split(' '))
                                {
                                    <span class="clickable-word" onclick="confirmAddWord('@word.Replace("'", "\\'")')">@word </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<div class="modal fade" id="banModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary">
            <form asp-area="Admin" asp-controller="Forum" asp-action="BanUserFromForum" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" id="banUserId" />
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-white">Operatör Askıya Alma: <span id="banUserName"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="text-muted small mb-2">BANLANMA SEBEBİ</label>
                    <textarea name="banReason" class="form-control bg-black border-secondary text-white" rows="3" required placeholder="İhlal detaylarını yazın..."></textarea>
                    <p class="text-danger small mt-3"><i class="bi bi-exclamation-triangle me-1"></i> Bu işlem kullanıcının tüm forum ve ticket erişimini kalıcı olarak kapatır.</p>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İPTAL</button>
                    <button type="submit" class="btn btn-danger fw-bold">SİSTEMDEN MEN ET</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openBanModal(id, name) {
            document.getElementById('banUserId').value = id;
            document.getElementById('banUserName').innerText = name;
            new bootstrap.Modal(document.getElementById('banModal')).show();
        }

        function confirmAddWord(word) {
            if (confirm(`'${word}' kelimesini kara listeye eklemek istediğine emin misin?`)) {
                const token = $('input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '@Url.Action("AddBadWord")',
                    type: 'POST',
                    data: { word: word, __RequestVerificationToken: token },
                    success: function() { alert('Kelime eklendi ve önbellek temizlendi.'); location.reload(); }
                });
            }
        }

        function handleTopicDeletion(form, isTopicStarter, postCount) {
            if (isTopicStarter) {
                if (confirm(`Topic'i silmek istediğinden emin misin? İçinde ${postCount} mesaj var.`)) {
                    return confirm(`Topic içerisindeki ${postCount} mesajı yok edeceksiniz.`);
                }
                return false;
            } else {
                return confirm('Filtreden sonraki içerikler silinecek emin misin?');
            }
        }
    </script>
}