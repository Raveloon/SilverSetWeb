@model IEnumerable<SilverSet.Models.Entities.Forum.ForumSpamLog>
@using Microsoft.EntityFrameworkCore
@{
    ViewData["Title"] = "Forum Moderasyon Merkezi";
    Layout = "_Layout";
    var userGroups = Model.Where(l => !l.IsHandled).GroupBy(l => l.UserId).ToList();
}

<style>
    body {
        background-color: #050505;
        color: #eee;
    }

    .user-wrapper {
        background: #0a0a0a;
        border: 1px solid #222;
        border-radius: 12px;
        margin-bottom: 3rem;
        padding: 1.5rem;
    }

    .user-identity {
        border-bottom: 1px solid #333;
        padding-bottom: 1rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .topic-card {
        background: #111;
        border: 1px solid #1a1a1a;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        overflow: hidden;
    }

    .topic-card-header {
        background: #181818;
        padding: 0.75rem 1.25rem;
        border-bottom: 1px solid #222;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .log-row {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #1a1a1a;
        position: relative;
        transition: 0.2s;
    }

        .log-row:last-child {
            border-bottom: none;
        }

       
        .log-row.is-violation {
            border-left: 4px solid #ef4444;
            background: rgba(239, 68, 68, 0.02);
        }

        .log-row.is-inspection {
            border-left: 4px solid #f59e0b;
            background: rgba(245, 158, 11, 0.02);
        }

    .type-badge {
        font-size: 0.6rem;
        font-weight: 800;
        padding: 2px 8px;
        border-radius: 4px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .badge-violation {
        background: #ef4444;
        color: white;
    }

    .badge-inspection {
        background: #f59e0b !important;
        color: black !important;
    }

    .msg-content {
        color: #bbb;
        font-size: 0.95rem;
        margin-top: 0.75rem;
        word-break: break-all;
        font-family: 'Segoe UI', Tahoma, sans-serif;
    }

    .btn-xs {
        padding: 3px 10px;
        font-size: 0.65rem;
        font-weight: bold;
        text-transform: uppercase;
    }

    .clickable-word {
        cursor: pointer;
        transition: 0.2s;
    }

        .clickable-word:hover {
            color: #fff;
            text-decoration: underline;
        }
</style>

<div class="container-fluid py-4" style="max-width: 1200px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-white fw-bold"><i class="bi bi-shield-shaded me-2 text-danger"></i>MODERASYON MERKEZİ</h2>
        <span class="badge bg-danger px-3 py-2">@userGroups.Count AKTİF TAKİP</span>
    </div>

    @if (!userGroups.Any())
    {
        <div class="alert alert-dark text-center py-5 border-secondary">
            <i class="bi bi-shield-check fs-1 d-block mb-3 opacity-50 text-success"></i>
            Sistem temiz. İncelenecek ihlal kaydı bulunamadı.
        </div>
    }

    @foreach (var userGroup in userGroups)
    {
        var firstLog = userGroup.First();
        <div class="user-wrapper">
            <div class="user-identity">
                <h4 class="text-white mb-0">
                    <i class="bi bi-person-badge me-2 text-primary"></i>@firstLog.User.UserName
                </h4>
                <div class="action-panel d-flex gap-2">
                    <form asp-area="Admin" asp-controller="Forum" asp-action="ApproveAllUserLogs" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@userGroup.Key" />
                        <button type="submit" class="btn btn-success btn-xs">TÜMÜNÜ ONAYLA</button>
                    </form>
                    <form asp-area="Admin" asp-controller="Forum" asp-action="DeleteAllUserLogs" method="post" onsubmit="return confirm('Kullanıcının bütün mesajlaşmasını sileceksin emin misin?')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@userGroup.Key" />
                        <button type="submit" class="btn btn-danger btn-xs">TÜMÜNÜ SİL</button>
                    </form>
                    <button type="button" class="btn btn-warning btn-xs" onclick="openBanModal(@userGroup.Key, '@firstLog.User.UserName')">BANLA</button>
                </div>
            </div>

            @foreach (var topicGroup in userGroup.GroupBy(l => l.TopicId))
            {
                var topicInfo = topicGroup.First().Topic;
                bool isTopicStarter = topicInfo != null && topicInfo.UserId == userGroup.Key;
                int postCount = topicInfo?.Posts?.Count ?? 0;

                <div class="topic-card">
                    <div class="topic-card-header">
                        <div class="text-muted small">
                            <i class="bi bi-chat-left-dots me-2"></i>Topic: <strong class="text-white">@(topicInfo?.Title ?? "Başlıksız")</strong>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-area="Admin" asp-controller="Forum" asp-action="ModerationView" asp-route-topicId="@topicGroup.Key" class="btn btn-outline-info btn-xs">KONUYA GİT</a>
                            <form asp-area="Admin" asp-controller="Forum" asp-action="ApproveTopicLogs" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="topicId" value="@topicGroup.Key" />
                                <input type="hidden" name="userId" value="@userGroup.Key" />
                                <button type="submit" class="btn btn-outline-success btn-xs">ONAYLA</button>
                            </form>
                        </div>
                    </div>

                    @foreach (var log in topicGroup.OrderBy(l => l.CreatedAt))
                    {
                        var isViolation = log.CaughtWord != "DENETIM";
                        <div class="log-row @(isViolation ? "is-violation" : "is-inspection")">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="type-badge @(isViolation ? "badge-violation" : "badge-inspection")">
                                        @(isViolation ? "FİLTRE: " + log.CaughtWord : "DENETİM")
                                    </span>
                                    <span class="text-muted small ms-2">@log.CreatedAt.ToString("HH:mm")</span>
                                </div>
                                <div class="action-panel d-flex gap-3">
                                    <form asp-area="Admin" asp-controller="Forum" asp-action="ApproveItem" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@(log.PostId ?? log.TopicId)" />
                                        <input type="hidden" name="type" value="@log.Type" />
                                        <button type="submit" class="btn btn-link text-success p-0 text-decoration-none fw-bold small" style="font-size:0.7rem">ONAYLA</button>
                                    </form>
                                    <form asp-area="Admin" asp-controller="Forum" asp-action="DeleteItem" method="post" onsubmit="return confirm('Silsin mi?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@(log.PostId ?? log.TopicId)" />
                                        <input type="hidden" name="type" value="@log.Type" />
                                        <button type="submit" class="btn btn-link text-danger p-0 text-decoration-none fw-bold small" style="font-size:0.7rem">SİL</button>
                                    </form>
                                </div>
                            </div>
                            <div class="msg-content">
                                @foreach (var word in (log.Content ?? "").Split(' '))
                                {
                                    <span class="clickable-word" onclick="confirmAddWord('@word.Replace("'", "\\'")')">@word </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<div class="modal fade" id="banModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary">
            <form asp-area="Admin" asp-controller="Forum" asp-action="BanUserFromForum" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" id="banUserId" />
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-white">Sistemden Men Et: <span id="banUserName" class="text-warning"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <textarea name="banReason" class="form-control bg-black border-secondary text-white" rows="3" required placeholder="Neden?"></textarea>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="submit" class="btn btn-danger btn-sm fw-bold">BANLA</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openBanModal(id, name) {
            document.getElementById('banUserId').value = id;
            document.getElementById('banUserName').innerText = name;
            new bootstrap.Modal(document.getElementById('banModal')).show();
        }
        function confirmAddWord(word) {
            if (confirm(`'${word}' kelimesini kara listeye ekle?`)) {
                $.post('@Url.Action("AddBadWord")', { word: word, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() }, function() { location.reload(); });
            }
        }
    </script>
}