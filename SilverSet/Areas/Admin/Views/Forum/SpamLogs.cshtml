@model IEnumerable<SilverSet.Models.Entities.Forum.ForumSpamLog>
@{
    ViewData["Title"] = "Forum Spam Control";
    Layout = "_Layout";
    var userGroups = Model.Where(l => !l.IsHandled).GroupBy(l => l.UserId).ToList();
}

<style>
    .user-wrapper {
        background: #0a0a0a;
        border: 1px solid #222;
        border-radius: 12px;
        margin-bottom: 3rem;
        padding: 1.5rem;
    }

    .user-identity {
        border-bottom: 1px solid #333;
        padding-bottom: 1rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .topic-group-box {
        background: #111;
        border: 1px solid #1a1a1a;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        overflow: hidden;
    }

    .topic-group-header {
        background: #181818;
        padding: 0.75rem 1.25rem;
        border-bottom: 1px solid #222;
        font-size: 0.8rem;
        color: #888;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .log-row {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #1a1a1a;
        position: relative;
    }

        .log-row:last-child {
            border-bottom: none;
        }

        .log-row.is-trigger {
            background: #1a0a0a;
            border-left: 4px solid #ef4444;
        }

        .log-row.is-restricted {
            border-left: 4px solid #f59e0b;
            padding-left: 2rem;
        }

    .type-badge {
        font-size: 0.6rem;
        font-weight: 800;
        padding: 2px 6px;
        border-radius: 3px;
        margin-right: 8px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    .badge-topic {
        background: #3b82f6;
        color: white;
    }

    .badge-post {
        background: #6b7280;
        color: white;
    }

    .badge-trigger {
        background: #ef4444;
        color: white;
    }

    .badge-denetim {
        background: #f59e0b;
        color: black;
    }

    .msg-content {
        color: #ccc;
        font-size: 0.9rem;
        margin-top: 0.5rem;
        word-break: break-all;
    }

    .action-panel {
        display: flex;
        gap: 10px;
    }

    .clickable-word {
        cursor: pointer;
        color: #888;
        transition: 0.2s;
    }

        .clickable-word:hover {
            color: #fff;
            text-decoration: underline;
        }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-white fw-bold">Forum Moderasyon Merkezi</h2>
        <span class="badge bg-danger">@userGroups.Count Aktif Dosya</span>
    </div>

    @if (!userGroups.Any())
    {
        <div class="alert alert-dark text-center py-5 border-secondary">
            <i class="bi bi-shield-check fs-1 d-block mb-3 opacity-50"></i>
            Huzur hakim. Tüm dosyalar temizlendi.
        </div>
    }

    @foreach (var userGroup in userGroups)
    {
        var firstLog = userGroup.First();
        <div class="user-wrapper">
            <div class="user-identity">
                <h4 class="text-white mb-0">
                    <i class="bi bi-person-badge me-2 text-primary"></i>@firstLog.User.UserName
                </h4>
            </div>

            @foreach (var topicGroup in userGroup.GroupBy(l => l.TopicId))
            {
                var topicInfo = topicGroup.First().Topic;
                <div class="topic-group-box">
                    <div class="topic-group-header">
                        <div>
                            <i class="bi bi-folder2-open me-2"></i>
                            @(topicInfo?.Category?.Name ?? "Kategorisiz") / <strong>@(topicInfo?.Title ?? "Başlıksız")</strong>
                        </div>
                        <a asp-action="ModerationView" asp-route-topicId="@topicGroup.Key" class="text-info text-decoration-none small">Konuya Git <i class="bi bi-arrow-right"></i></a>
                    </div>

                    @foreach (var log in topicGroup.OrderBy(l => l.CreatedAt))
                    {
                        bool isTrigger = log.RelatedSpamId == null;
                        <div class="log-row @(isTrigger ? "is-trigger" : "is-restricted")">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="type-badge @(log.Type == "Topic" ? "badge-topic" : "badge-post")">
                                        @(log.Type == "Topic" ? "[YENİ KONU]" : "[CEVAP]")
                                    </span>

                                    @if (isTrigger)
                                    {
                                        <span class="type-badge badge-trigger">TETİKLEYİCİ: @log.CaughtWord</span>
                                    }
                                    else
                                    {
                                        <span class="type-badge badge-denetim">DENETİM ALTINDA</span>
                                    }

                                    <span class="text-muted small ms-2">@log.CreatedAt.ToString("HH:mm")</span>
                                </div>

                                <div class="action-panel">
                                    <form asp-action="ApproveItem" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@(log.PostId ?? log.TopicId)" />
                                        <input type="hidden" name="type" value="@log.Type" />
                                        <button type="submit" class="btn btn-outline-success btn-sm py-0 px-2" style="font-size: 0.6rem; font-weight: bold;">ONAYLA</button>
                                    </form>

                                    <form asp-action="DeleteItem" method="post" onsubmit="return confirm('Silmek istediğine emin misin?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@(log.PostId ?? log.TopicId)" />
                                        <input type="hidden" name="type" value="@log.Type" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" style="font-size: 0.6rem; font-weight: bold;">SİL</button>
                                    </form>
                                </div>
                            </div>

                            <div class="msg-content">
                                @if (!string.IsNullOrEmpty(log.Content))
                                {
                                    @foreach (var word in log.Content.Split(' '))
                                    {
                                        <span class="clickable-word" onclick="confirmAddWord('@word.Replace("'", "\\'")')">@word </span>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        function confirmAddWord(word) {
            if (confirm(`'${word}' kelimesini yasaklılar listesine eklemek istediğine emin misin?`)) {
                const token = $('input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '@Url.Action("AddBadWord")',
                    type: 'POST',
                    data: { word: word, __RequestVerificationToken: token },
                    success: function() { alert('Kelime eklendi.'); }
                });
            }
        }
    </script>
}