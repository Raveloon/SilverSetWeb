@model SilverSet.Models.Entities.Forum.ForumTopic
@{
    ViewData["Title"] = "İçerik İnceleme";
    Layout = "_Layout";

    // Filtreleme mantığı için pivot tarihini (ilk ihlal anını) buluyoruz
    // Not: Bu sayfa için ViewBag.SpamLogs üzerinden yakalanan kelimeleri eşleştirebilirsiniz.
    var firstViolationPost = Model.Posts.OrderBy(p => p.CreatedAt).FirstOrDefault(p => !p.IsApproved);
    var firstViolationDate = firstViolationPost?.CreatedAt ?? (Model.IsApproved ? DateTime.MaxValue : Model.CreatedAt);
}

<style>
    .mod-topic-container {
        background: #0a0a0a;
        border-radius: 12px;
        border: 1px solid #222;
        padding: 2rem;
    }

    .post-card {
        padding: 1.25rem;
        border-bottom: 1px solid #1a1a1a;
        position: relative;
        transition: 0.2s;
        margin-bottom: 5px;
    }

        .post-card:last-child {
            border-bottom: none;
        }

    .is-previous {
        border-left: 4px solid #10b981;
        background: #06120e;
    }

    .is-violation {
        border-left: 4px solid #ef4444;
        background: #1a0a0a;
    }

    .is-inspection {
        border-left: 4px solid #f59e0b;
        background: #1a150a;
    }

    .type-badge {
        font-size: 0.65rem;
        font-weight: 800;
        padding: 3px 8px;
        border-radius: 4px;
        margin-right: 8px;
        text-transform: uppercase;
    }

    .badge-previous {
        background: #10b981;
        color: white;
    }

    .badge-violation {
        background: #ef4444;
        color: white;
    }

    .badge-inspection {
        background: #f59e0b;
        color: black;
    }

    .badge-topic-header {
        background: #4b5563;
        color: white;
    }

    .msg-text {
        color: #eee;
        font-size: 1rem;
        margin-top: 0.75rem;
        word-break: break-all;
    }

    .action-row {
        display: flex;
        gap: 10px;
        margin-top: 1rem;
    }

    .btn-xs {
        padding: 2px 10px;
        font-size: 0.7rem;
        font-weight: bold;
    }
</style>

<div class="container-fluid py-4">
    <div class="mb-4">
        <a asp-action="SpamLogs" class="btn btn-outline-secondary btn-sm mb-3">
            <i class="bi bi-arrow-left"></i> Moderasyon Merkezine Dön
        </a>
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h2 class="text-white fw-bold">Vaka Analizi: <span class="text-info">@Model.Title</span></h2>
                <p class="text-muted">Kategori: @Model.Category.Name | Kullanıcı: <strong>@Model.User.UserName</strong></p>
            </div>
            <div class="action-panel">
                <button type="button" class="btn btn-warning btn-sm fw-bold" onclick="openBanModal(@Model.UserId, '@Model.User.UserName')">KULLANICIYI BANLA</button>
            </div>
        </div>
    </div>

    <div class="mod-topic-container">
        <h4 class="text-muted small text-uppercase fw-bold mb-4 border-bottom border-secondary pb-2">Zaman Tüneli ve Akış</h4>

        @* --- KONU BAŞLATICI (TOPIC CONTENT) --- *@
        @{
            bool topicIsViolation = !Model.IsApproved; // Basit mantık: Onaylı değilse kırmızı/ihlaldir
            string topicClass = topicIsViolation ? "is-violation" : "is-previous";
        }
        <div class="post-card @topicClass">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="type-badge @(topicIsViolation ? "badge-violation" : "badge-previous")">
                        @(topicIsViolation ? "İHLAL: KONU BAŞLATMA" : "TEMİZ: KONU BAŞLATMA")
                    </span>
                    <span class="type-badge badge-topic-header">TOPIC: @Model.Title</span>
                    <span class="text-muted small ms-2">@Model.CreatedAt.ToString("g")</span>
                </div>
                <div class="action-row mt-0">
                    @if (!Model.IsApproved)
                    {
                        <form asp-action="ApproveItem" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="type" value="Topic" />
                            <button type="submit" class="btn btn-outline-success btn-xs">ONAYLA</button>
                        </form>
                        <form asp-action="DeleteItem" method="post" class="d-inline" onsubmit="return confirm('Konuyu silmek üzeresin?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="type" value="Topic" />
                            <button type="submit" class="btn btn-outline-danger btn-xs">SİL</button>
                        </form>
                    }
                </div>
            </div>
            <div class="msg-text fw-bold border-start border-info ps-3 mt-3">@Model.Content</div>
        </div>

        @* --- CEVAPLAR (POSTS) --- *@
        @foreach (var post in Model.Posts.OrderBy(p => p.CreatedAt))
        {
            var isViolation = !post.IsApproved; // Şu anki DB durumuna göre onaylanmamışsa ihlaldir
            var isPrevious = post.CreatedAt < firstViolationDate;
            var isInspection = !isViolation && post.CreatedAt >= firstViolationDate && !post.IsApproved; // Onaysız ama ihlal değilse (Shadow Ban)

            // Görsel Sınıf Belirleme
            string postClass = isViolation ? "is-violation" : (isPrevious ? "is-previous" : "is-inspection");

            <div class="post-card @postClass">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        @if (isViolation)
                        {
                            <span class="type-badge badge-violation">İHLAL TESPİTİ</span>
                        }
                        else if (isPrevious)
                        {
                            <span class="type-badge badge-previous">ÖNCEKİ YAZIŞMA</span>
                        }
                        else
                        {
                            <span class="type-badge badge-inspection">DENETİM</span>
                        }
                        <span class="text-muted small ms-2">@post.CreatedAt.ToString("HH:mm")</span>
                    </div>

                    <div class="action-row mt-0">
                        @if (!post.IsApproved)
                        {
                            <form asp-action="ApproveItem" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@post.Id" />
                                <input type="hidden" name="type" value="Post" />
                                <button type="submit" class="btn btn-outline-success btn-xs">ONAYLA</button>
                            </form>
                            <form asp-action="DeleteItem" method="post" class="d-inline" onsubmit="return confirm('Mesajı silmek istediğine emin misin?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@post.Id" />
                                <input type="hidden" name="type" value="Post" />
                                <button type="submit" class="btn btn-outline-danger btn-xs">SİL</button>
                            </form>
                        }
                    </div>
                </div>
                <div class="msg-text">@post.Content</div>
            </div>
        }
    </div>
</div>

@* Ban Modal Altyapısı *@
<div class="modal fade" id="banModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary">
            <form asp-action="BanUserFromForum" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" id="banUserId" />
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-white">Operatör Askıya Alma: <span id="banUserName"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <textarea name="banReason" class="form-control bg-black border-secondary text-white" rows="3" required placeholder="Neden banlıyorsun?"></textarea>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="submit" class="btn btn-danger fw-bold w-100">SİSTEMDEN MEN ET</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openBanModal(id, name) {
            document.getElementById('banUserId').value = id;
            document.getElementById('banUserName').innerText = name;
            new bootstrap.Modal(document.getElementById('banModal')).show();
        }
    </script>
}