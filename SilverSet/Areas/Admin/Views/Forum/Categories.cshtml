@model IEnumerable<SilverSet.Models.Entities.Forum.ForumCategory>
@{
    ViewData["Title"] = "Forum Categories";
    var query = ViewBag.Query as string;
}

<style>
    .admin-card {
        background: #0d0d0d;
        border: 1px solid #1a1a1a;
        border-radius: 8px;
        padding: 2rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }

    .section-title {
        color: #fff;
        font-size: 1.1rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        flex-wrap: wrap;
    }

    .forum-label {
        color: #aaa;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        display: block;
    }

    .forum-control {
        background: #050505 !important;
        border: 1px solid #222 !important;
        color: #eee !important;
        border-radius: 4px;
        padding: 0.75rem;
        font-size: 0.9rem;
        transition: 0.2s ease-in-out;
    }

        .forum-control:focus {
            border-color: #444 !important;
            box-shadow: 0 0 0 2px rgba(255,255,255,0.05);
            color: #fff !important;
        }

    .btn-silver-action {
        background: #e0e0e0;
        color: #000;
        font-weight: 700;
        font-size: 0.85rem;
        padding: 0.75rem 1.5rem;
        border: none;
        border-radius: 4px;
        transition: 0.3s;
    }

        .btn-silver-action:hover {
            background: #fff;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(255,255,255,0.1);
        }

    .table-forum {
        width: 100%;
        color: #ccc;
        border-collapse: separate;
        border-spacing: 0 8px;
    }

        .table-forum thead th {
            color: #555;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 1rem;
            border-bottom: 1px solid #1a1a1a;
        }

        .table-forum tbody td {
            background: #111;
            padding: 1.2rem 1rem;
            vertical-align: middle;
            border-top: 1px solid #1a1a1a;
            border-bottom: 1px solid #1a1a1a;
        }

            .table-forum tbody td:first-child {
                border-left: 1px solid #1a1a1a;
                border-radius: 8px 0 0 8px;
            }

            .table-forum tbody td:last-child {
                border-right: 1px solid #1a1a1a;
                border-radius: 0 8px 8px 0;
            }

    .status-pill {
        font-size: 0.7rem;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 100px;
    }

    .pill-active {
        background: rgba(46, 204, 113, 0.1);
        color: #2ecc71;
        border: 1px solid rgba(46, 204, 113, 0.2);
    }

    .pill-disabled {
        background: rgba(231, 76, 60, 0.1);
        color: #e74c3c;
        border: 1px solid rgba(231, 76, 60, 0.2);
    }

    .text-wrap-fix {
        word-break: break-all;
        overflow-wrap: break-word;
        max-width: 300px;
    }

    .category-desc {
        color: #999 !important;
        font-size: 0.8rem;
        margin-top: 2px;
    }

    .admin-search-input {
        background: #000 !important;
        border: 1px solid #222 !important;
        color: #fff !important;
        font-size: 0.75rem !important;
        padding: 4px 10px !important;
        width: 150px;
    }

    .btn-admin-search {
        padding: 4px 12px !important;
        font-size: 0.7rem !important;
    }
</style>

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-xl-4 col-lg-5 mb-4">
            <div class="admin-card">
                <div class="section-title">
                    <span><i class="bi bi-folder-plus"></i> New Category</span>
                </div>
                <form asp-action="CreateCategory" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="forum-label">Category Name</label>
                        <input type="text" name="name" class="form-control forum-control" placeholder="e.g., General Discussion" required>
                    </div>
                    <div class="mb-4">
                        <label class="forum-label">Description</label>
                        <textarea name="description" class="form-control forum-control" rows="3" placeholder="Briefly describe this section..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-silver-action w-100">Create Category</button>
                </form>
            </div>
        </div>

        <div class="col-xl-8 col-lg-7">
            <div class="admin-card">
                <div class="section-title">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-layers"></i> Forum Structure
                    </div>

                    <form asp-action="Categories" method="get" class="d-flex gap-2 align-items-center">
                        <input type="text" name="query" value="@query"
                               class="form-control forum-control admin-search-input"
                               placeholder="Search...">
                        <button type="submit" class="btn btn-silver-action btn-admin-search">SEARCH</button>
                        @if (!string.IsNullOrEmpty(query))
                        {
                            <a asp-action="Categories" class="btn btn-sm btn-outline-secondary btn-admin-search d-flex align-items-center">CLEAR</a>
                        }
                    </form>
                </div>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-dark border-0 bg-success bg-opacity-10 text-success small mb-4">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-dark border-0 bg-danger bg-opacity-10 text-danger small mb-4">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                    </div>
                }

                <div class="table-responsive">
                    <table class="table-forum">
                        <thead>
                            <tr>
                                <th>Category Details</th>
                                <th>Status</th>
                                <th class="text-end">Management</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-5 text-muted small">
                                        No categories found.
                                    </td>
                                </tr>
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-white text-wrap-fix">@item.Name</div>
                                        <div class="category-desc text-wrap-fix">@item.Description</div>
                                    </td>
                                    <td>
                                        <span class="status-pill @(item.IsActive ? "pill-active" : "pill-disabled")">
                                            @(item.IsActive ? "ACTIVE" : "DISABLED")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-light"
                                                    style="font-size: 0.7rem; border-color: #333;"
                                                    onclick="openEditModal(@item.Id, '@item.Name', '@item.Description')">
                                                EDIT
                                            </button>

                                            <form asp-action="ToggleCategoryStatus" asp-route-id="@item.Id" method="post" style="display:inline;">
                                                <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-secondary" : "btn-outline-success")" style="font-size: 0.7rem;">
                                                    @(item.IsActive ? "DISABLE" : "ENABLE")
                                                </button>
                                            </form>

                                            <form asp-action="DeleteCategory" asp-route-id="@item.Id" method="post"
                                                  onsubmit="return confirm('Are you sure? This will affect topics under this category.')" style="display:inline;">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" style="font-size: 0.7rem;">DELETE</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: #111; border: 1px solid #333; color: #fff;">
            <div class="modal-header" style="border-bottom: 1px solid #222; padding: 1.5rem;">
                <h5 class="modal-title" style="font-weight: 800; font-size: 0.9rem;">EDIT CATEGORY</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="UpdateCategory" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="edit-id">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="forum-label">Category Name</label>
                        <input type="text" name="name" id="edit-name" class="form-control forum-control" required>
                    </div>
                    <div class="mb-0">
                        <label class="forum-label">Description</label>
                        <textarea name="description" id="edit-description" class="form-control forum-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid #222; padding: 1rem;">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-silver-action px-4">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditModal(id, name, desc) {
            document.getElementById('edit-id').value = id;
            document.getElementById('edit-name').value = name;
            document.getElementById('edit-description').value = desc;
            new bootstrap.Modal(document.getElementById('editModal')).show();
        }
    </script>
}