@model List<SilverSet.Models.Entities.FeaturedGame>
@{
    ViewData["Title"] = "Projects";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
    }

    .btn-admin-primary {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: white;
        color: #0a0a0a;
        font-size: 0.8rem;
        font-weight: 700;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        text-decoration: none;
        transition: opacity 0.2s;
    }

        .btn-admin-primary:hover {
            opacity: 0.85;
            color: #0a0a0a;
        }

    .admin-table {
        width: 100%;
        border-collapse: collapse;
    }

        .admin-table th {
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #555;
            padding: 0.6rem 1rem;
            border-bottom: 1px solid var(--admin-border);
            text-align: left;
        }

        .admin-table td {
            padding: 0.85rem 1rem;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            font-size: 0.875rem;
            color: #ccc;
            vertical-align: middle;
        }

        .admin-table tr:hover td {
            background: rgba(255,255,255,0.02);
        }

    .badge-visible {
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 0.2rem 0.6rem;
        border-radius: 4px;
        background: rgba(134,239,172,0.1);
        color: #86efac;
        border: 1px solid rgba(134,239,172,0.2);
    }

    .badge-hidden {
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 0.2rem 0.6rem;
        border-radius: 4px;
        background: rgba(255,255,255,0.05);
        color: #555;
        border: 1px solid rgba(255,255,255,0.07);
    }

    .btn-edit {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: #9ca3af;
        text-decoration: none;
        padding: 0.3rem 0.7rem;
        border-radius: 6px;
        border: 1px solid var(--admin-border);
        transition: all 0.2s;
    }

        .btn-edit:hover {
            color: white;
            border-color: rgba(255,255,255,0.2);
        }

    .btn-delete {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: #f87171;
        background: none;
        padding: 0.3rem 0.7rem;
        border-radius: 6px;
        border: 1px solid rgba(248,113,113,0.2);
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-delete:hover {
            background: rgba(248,113,113,0.08);
        }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: #555;
    }

        .empty-state i {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            display: block;
        }
</style>

<div class="page-header">
    <div>
        <div style="font-size:0.7rem; color:#555; letter-spacing:2px; text-transform:uppercase; margin-bottom:0.25rem">Content</div>
        <div style="font-size:1.1rem; font-weight:700; color:white">Projects</div>
    </div>
    <a asp-area="Admin" asp-controller="Games" asp-action="Create" class="btn-admin-primary">
        <i class="bi bi-plus"></i> Add Project
    </a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-collection"></i>
        <div style="font-size:0.9rem; margin-bottom:0.5rem; color:#888">No projects yet</div>
        <a asp-area="Admin" asp-controller="Games" asp-action="Create" class="btn-admin-primary" style="display:inline-flex; margin-top:0.5rem">
            <i class="bi bi-plus"></i> Add First Project
        </a>
    </div>
}
else
{
    <table class="admin-table">
        <thead>
            <tr>
                <th>Order</th>
                <th>Title</th>
                <th>Genre</th>
                <th>Status</th>
                <th>Visibility</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var game in Model)
            {
                <tr>
                    <td style="color:#555">@game.DisplayOrder</td>
                    <td style="color:white; font-weight:600">@game.Title</td>
                    <td>@game.Genre</td>
                    <td>@game.Status</td>
                    <td>
                        @if (game.IsVisible)
                        {
                            <span class="badge-visible">Visible</span>
                        }
                        else
                        {
                            <span class="badge-hidden">Hidden</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex gap-2">
                            <a asp-area="Admin" asp-controller="Games" asp-action="Edit" asp-route-id="@game.Id" class="btn-edit">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <form asp-area="Admin" asp-controller="Games" asp-action="Delete" asp-route-id="@game.Id" method="post" onsubmit="return confirm('Delete this project?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-delete">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}