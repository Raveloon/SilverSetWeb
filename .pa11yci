{
  "defaults": {
    "timeout": 90000,
    "ignoreSslErrors": true,
    "chromeLaunchConfig": {
      "executablePath": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
      "args": [
        "--no-sandbox",
        "--disable-setuid-sandbox",
        "--ignore-certificate-errors",
        "--allow-insecure-localhost"
      ]
    }
  },
  "urls": [
    "https://localhost:5001/",
    "https://localhost:5001/About",
    "https://localhost:5001/Contact",
    "https://localhost:5001/Assets",
    "https://localhost:5001/Forum",
    "https://localhost:5001/Account/Login",
    "https://localhost:5001/Account/Register",
    "https://localhost:5001/Account/ForgotPassword",
    "https://localhost:5001/Home/Privacy"
  ]
}